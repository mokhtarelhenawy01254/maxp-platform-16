/// 🎉 المناسبات القابلة للإدارة (إضافة/حذف/تكرار + إرسال تلقائي عبر الكرون)
model Occasion {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  message         String
  templateId      String? // اختياري: ربط المناسبة بقالب واتساب (محتواه هو الرسالة الحية)
  mediaUrl        String?
  scheduledAt     DateTime
  recurrence      String   @default("none") // none | monthly | yearly
  customerListIds String   @default("[]")   // JSON array of customerList ids
  status          String   @default("draft") // draft | scheduled | sent | cancelled
  lastSentAt      DateTime?
  lastSentCount   Int      @default(0)
  totalSent       Int      @default(0) // إجمالي الرسائل المرسلة (تراكمي عبر الجولات)
  sendLimit       Int      @default(0) // أقصى عدد عملاء للمناسبة (0 = بدون حد)
  throttlePerRun  Int      @default(0) // أقصى رسائل لكل جولة cron (كل ساعة) (0 = بدون حد)
  nextRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([nextRunAt])
  @@map("occasions")
}

