model AppExplanation {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  slug        String   @unique
  targetRoute String   @default("")
  videoUrl    String?
  // نسخة الموبايل (رأسية 9:16). لما تكون موجودة، المشغّل بيعرضها تلقائيًا على
  // الموبايل وبيسيب زرار تبديل للنسخة الأفقية.
  videoUrlMobile String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([targetRoute])
  @@map("app_explanations")
}
