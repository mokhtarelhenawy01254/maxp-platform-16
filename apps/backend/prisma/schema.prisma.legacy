model FollowUp {
  id                 String    @id @default(cuid())
  companyId          String    @unique
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status             String    @default("unassigned")
  assignedOwnerId    String?
  assignedOwnerName  String?
  assignedOwnerEmail String?
  assignedOwnerRole  String?
  lastNote           String?
  updatedAt          DateTime?
  contactedAt        DateTime?
  resolvedAt         DateTime?
  nextActionAt       DateTime?
  lastReminderSentAt DateTime?
  lastEscalatedAt    DateTime?
  createdAt          DateTime  @default(now())

  history FollowUpHistory[]

  @@map("company_follow_ups")
}

model FollowUpHistory {
  id                 String    @id @default(cuid())
  followUpId         String
  followUp           FollowUp  @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  occurredAt         DateTime
  status             String
  note               String?
  action             String    @default("updated")
  nextActionAt       DateTime?
  actorId            String?
  actorName          String?
  actorEmail         String?
  actorRole          String?
  assignedOwnerId    String?
  assignedOwnerName  String?
  assignedOwnerEmail String?
  assignedOwnerRole  String?
  createdAt          DateTime  @default(now())

  @@index([followUpId])
  @@map("follow_up_history")
}

model User {
  id                                                String                     @id @default(cuid())
  email                                             String                     @unique
  password                                          String
  firstName                                         String
  lastName                                          String
  avatar                                            String?
  phone                                             String?
  role                                              String?
  isActive                                          Boolean                    @default(true)
  isEmailVerified                                   Boolean                    @default(false)
  emailVerifiedAt                                   DateTime?
  lastLoginAt                                       DateTime?
  passwordChangedAt                                 DateTime?
  companyId                                         String?
  createdAt                                         DateTime                   @default(now())
  updatedAt                                         DateTime                   @updatedAt
  resetPasswordExpires                              DateTime?
  resetPasswordToken                                String?
  emailVerificationToken                            String?
  emailVerificationExpires                          DateTime?
  availability                                      String?                    @default("available")
  department                                        String?
  skills                                            String?
  baseSalary                                        Decimal?                   @db.Decimal(12, 2)
  contractType                                      UsersContractType?
  departmentId                                      String?
  employeeNumber                                    String?
  hireDate                                          DateTime?
  positionId                                        String?
  timezone                                          String                     @default("Asia/Riyadh")
  settings                                          String?
  enableAutoDeduction                               Boolean                    @default(true)
  lateDeductionRate                                 Decimal?                   @db.Decimal(10, 2)
  maxDailyLateMinutes                               Int?                       @default(10)
  monthlyGraceMinutes                               Int?                       @default(60)
