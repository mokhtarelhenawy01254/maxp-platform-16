model Goal {
  id            String      @id @default(cuid())
  companyId     String
  departmentId  String?
  title         String
  description   String?
  goalType      GoalType    @default(COMPANY)
  priority      GoalPriority @default(MEDIUM)
  targetValue   Decimal     @db.Decimal(12, 2)
  currentValue  Decimal     @default(0.00) @db.Decimal(12, 2)
  unit          String?
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  goalDate      DateTime?   @db.Date
  status        String      @default("PENDING")
  progress      Int         @default(0)
  autoGenerateDaily Boolean @default(false)
  isAutoGenerated  Boolean  @default(false)
  generationSource GoalGenerationSource @default(MANUAL)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  projectId     String?
  parentGoalId  String?
  attendanceId  String?
  userId        String?
  employeeRelId String?
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employeeRel   Employee?   @relation(fields: [employeeRelId], references: [id])
  project       Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentGoal    Goal?       @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)
  childGoals    Goal[]      @relation("GoalHierarchy")
  attendance    Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  tasks         Task[]

  @@index([companyId])
  @@index([departmentId])
  @@index([goalType])
  @@index([projectId])
  @@index([parentGoalId])
  @@index([goalDate])
  @@index([status])
  @@index([attendanceId])
  @@index([userId])
  @@map("hr_goals")
}

