model CompetitorAdCampaign {
  id                String                 @id @default(cuid())
  campaignId        String?
  platform          String                 @default("facebook")
  campaignName      String?
  objective         String?
  status            String?
  startedAt         DateTime?
  stoppedAt         DateTime?
  budget            Decimal?               @db.Decimal(12, 2)
  budgetCurrency    String?                @default("USD")
  spend             Decimal?               @db.Decimal(12, 2)
  impressions       Int?
  clicks            Int?
  conversions       Int?
  reach             Int?
  frequency         Decimal?               @db.Decimal(5, 2)
  ctr               Decimal?               @db.Decimal(5, 3)
  cpc               Decimal?               @db.Decimal(10, 2)
  cpm              Decimal?               @db.Decimal(10, 2)
  roas             Decimal?               @db.Decimal(5, 2)
  lastUpdated       DateTime              @default(now())
  metadata          Json?
  competitorId      String
  companyId         String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  competitor        Competitor             @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  adCreatives       CompetitorAdCreative[]

  @@unique([competitorId, platform, campaignId])
  @@index([competitorId])
  @@index([companyId])
  @@index([competitorId, platform])
  @@map("competitor_ad_campaigns")
}

model CompetitorAdCreative {
  id                String                 @id @default(cuid())
  adId              String?
  platform          String                 @default("facebook")
  adType            String?
  status            String?
  headline          String?
  primaryText       String?                @db.Text
  description       String?                @db.Text
  callToAction      String?
  landingPageUrl    String?
  imageUrl          String?
  videoUrl          String?
  adFormat          String?
  impressions       Int?
  clicks            Int?
  ctr               Decimal?               @db.Decimal(5, 3)
  spend             Decimal?               @db.Decimal(12, 2)
  lastSeen          DateTime               @default(now())
  firstSeen         DateTime               @default(now())
  metadata          Json?
  campaignId        String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  campaign          CompetitorAdCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, platform])
  @@index([campaignId, adType])
  @@map("competitor_ad_creatives")
}

model CompetitorAdIntelligence {
  id                String                 @id @default(cuid())
  platform          String
  advertiserId      String?
  advertiserName    String?
  adLibraryId       String?
  adType            String?
  creativeDetails   Json?
  targeting         Json?
  placements        String[]
  startDate         DateTime?
  endDate           DateTime?
  impressionsMin    Int?
  impressionsMax    Int?
  spendMin          Decimal?               @db.Decimal(12, 2)
  spendMax          Decimal?               @db.Decimal(12, 2)
  pageId            String?
  pageName          String?
  metadata          Json?
  competitorId      String
  companyId         String
  createdAt         DateTime               @default(now())

  competitor        Competitor             @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([companyId])
  @@index([platform])
  @@map("competitor_ad_intelligence")
}