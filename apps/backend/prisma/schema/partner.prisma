model PlatformPartner {
  id              String                    @id @default(cuid())
  userId          String                    @unique
  partnerCode     String                    @unique
  companyName     String?
  title           PartnerTitle              @default(PARTNER)
  maxAllowedDepth Int                       @default(1)
  status          PlatformPartnerStatus     @default(PENDING)
  customCommissionRate Float?             // override L1 rate (%) for this partner only; null = use global setting
  totalEarnings   Decimal                   @default(0.00) @db.Decimal(12, 2)
  paidEarnings    Decimal                   @default(0.00) @db.Decimal(12, 2)
  pendingEarnings Decimal                   @default(0.00) @db.Decimal(12, 2)
  totalCompanies  Int                       @default(0)
  totalSubPartners Int                      @default(0)
  paymentMethod   PartnerPayoutMethod?
  paymentDetails  String?
  parentPartnerId String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentPartner         PlatformPartner?          @relation("SubPartners", fields: [parentPartnerId], references: [id])
  subPartners           PlatformPartner[]         @relation("SubPartners")
  referredCompanies     PartnerReferredCompany[]
  commissions           PartnerCommission[]
  payouts               PartnerPayout[]

  @@index([partnerCode])
  @@index([parentPartnerId])
  @@index([title])
  @@index([status])
  @@map("platform_partners")
}

model PartnerReferredCompany {
  id              String           @id @default(cuid())
  partnerId       String
  companyId       String           @unique
  joinedAt        DateTime         @default(now())
  isActive        Boolean          @default(true)

  partner         PlatformPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_referred_companies")
}

model PartnerCommission {
  id               String           @id @default(cuid())
  partnerId        String
  companyId        String
  billingHistoryId String           @unique
  amount           Decimal          @db.Decimal(10, 2)
  level            Int              @default(1)
  status           PartnerCommissionStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  partner          PlatformPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  billingHistory   BillingHistory   @relation(fields: [billingHistoryId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([companyId])
  @@index([status])
  @@map("partner_commissions")
}

model PartnerPayout {
  id              String                 @id @default(cuid())
  partnerId       String
  amount          Decimal                @db.Decimal(10, 2)
  currency        String                 @default("EGP")
  status          PartnerPayoutStatus    @default(PENDING)
  paymentMethod   PartnerPayoutMethod
  paymentDetails  String?
  transactionId   String?
  notes           String?
  processedAt     DateTime?
  processedBy     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  partner         PlatformPartner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@map("partner_payouts")
}

model PlatformPartnerSetting {
  id                  String   @id @default(cuid())
  level1Rate          Float    @default(20)
  level2Rate          Float    @default(5)
  level3Rate          Float    @default(3)
  level4Rate          Float    @default(1)
  minimumPayoutAmount Decimal  @default(100.00) @db.Decimal(10, 2)
  termsAndConditions  String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("platform_partner_settings")
}
