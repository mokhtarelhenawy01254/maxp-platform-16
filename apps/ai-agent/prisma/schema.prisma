// Standalone schema for ai-agent service.
// This schema mirrors only the tables the ai-agent needs.
// ⚠ Never run migrations from here — apps/backend owns all DB migrations.
// Run `npm run db:generate` after any schema change to regenerate the client.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model CompanyAgent {
  id           String   @id
  companyId    String
  name         String
  role         String
  description  String?
  icon         String?
  soul         String?  @db.Text
  rules        String?  @db.Text
  skills       String?  @db.Text
  model        String?
  status       String   @default("ACTIVE")
  parentId     String?
  departmentId String?
  managerType  String?
  templateSlug String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@index([departmentId])
  @@map("company_agents")
}

model AgentToolDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  description String   @db.Text
  category    String
  parameters  String   @db.Text
  isWrite     Boolean  @default(false)
  isActive    Boolean  @default(true)
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([category])
  @@index([isActive])
  @@map("agent_tool_definitions")
}

enum AiKeysProvider {
  GOOGLE
  DEEPSEEK
  OPENAI
  ANTHROPIC
  HUGGINGFACE
  OLLAMA
  GROQ
  OPENROUTER
  NVIDIA
  CEREBRAS
  GITHUB
  SAMBANOVA
  MISTRAL

  @@map("ai_keys_provider")
}

enum AiKeysKeyType {
  COMPANY
  CENTRAL

  @@map("ai_keys_keyType")
}

model AiKey {
  id                String          @id @default(cuid())
  name              String
  provider          AiKeysProvider  @default(GOOGLE)
  apiKey            String          @unique
  baseUrl           String?
  isActive          Boolean         @default(true)
  companyId         String?
  keyType           AiKeysKeyType   @default(CENTRAL)
  usage             String
  currentUsage      Int             @default(0)
  maxRequestsPerDay Int             @default(1500)
  priority          Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  aiModelConfigs    AiModelConfig[]

  @@index([companyId])
  @@index([provider, isActive])
  @@map("ai_keys")
}

model AiModelConfig {
  id        String   @id @default(cuid())
  keyId     String
  modelName String
  isEnabled Boolean  @default(true)
  priority  Int      @default(1)
  usage     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  aiKey     AiKey    @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@unique([keyId, modelName])
  @@index([keyId])
  @@map("ai_model_configs")
}

model ExcludedModel {
  id          String    @id @default(cuid())
  modelName   String
  keyId       String?
  companyId   String?
  reason      String
  excludedAt  DateTime  @default(now())
  retryAt     DateTime
  retryCount  Int       @default(0)
  lastRetryAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([modelName, keyId])
  @@index([retryAt])
  @@map("excluded_models")
}

model AiProviderLog {
  id             String   @id @default(cuid())
  provider       String
  keyId          String?
  keyName        String?
  companyId      String?
  conversationId String?
  customerId     String?
  scope          String   @default("runtime")
  action         String
  status         String
  latencyMs      Int?
  model          String?
  message        String?  @db.Text
  metadata       String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([provider, createdAt])
  @@index([keyId, createdAt])
  @@index([companyId, createdAt])
  @@map("ai_provider_logs")
}

model AgenticMemoryFact {
  id         String    @id @default(cuid())
  companyId  String
  customerId String?
  type       String    @default("FACT")
  content    String    @db.Text
  confidence Float     @default(1.0)
  importance Int       @default(3)
  validFrom  DateTime?
  validTo    DateTime?
  metadata   String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([companyId, type])
  @@index([companyId, customerId])
  @@map("agentic_memory_facts")
}

model TelemetryTrace {
  id               String          @id @default(cuid())
  companyId        String
  channel          String          @default("DASHBOARD")
  provider         String?
  totalTokens      Int             @default(0)
  promptTokens     Int             @default(0)
  completionTokens Int             @default(0)
  totalCost        Decimal         @default(0.0) @db.Decimal(12, 5)
  status           String          @default("RUNNING")
  metadata         String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  spans            TelemetrySpan[]

  @@index([companyId, createdAt])
  @@index([status])
  @@map("telemetry_traces")
}

model TelemetrySpan {
  id        String         @id @default(cuid())
  traceId   String
  parentId  String?
  name      String
  type      String         @default("LLM")
  startTime DateTime       @default(now())
  endTime   DateTime?
  latencyMs Int            @default(0)
  input     String?        @db.Text
  output    String?        @db.Text
  status    String         @default("SUCCESS")
  error     String?        @db.Text
  metadata  String?        @db.Text
  createdAt DateTime       @default(now())
  trace     TelemetryTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([traceId])
  @@index([parentId])
  @@index([createdAt])
  @@map("telemetry_spans")
}

model AiAgentTask {
  id           String       @id @default(cuid())
  companyId    String
  agentId      String
  title        String
  description  String?      @db.Text
  status       String       @default("PENDING")
  priority     String       @default("medium")
  dagPlan      Json?
  checkpoint   Json?
  checkedOutBy String?
  checkedOutAt DateTime?
  completedAt  DateTime?
  createdBy    String?
  parentTaskId String?
  traceId      String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  runs         AiAgentRun[]

  @@index([companyId, status])
  @@index([companyId, agentId])
  @@map("ai_agent_tasks")
}

model AiAgentRun {
  id           String      @id @default(cuid())
  taskId       String
  companyId    String
  agentId      String
  stepName     String?
  stepIndex    Int         @default(0)
  status       String
  output       Json?
  error        String?     @db.Text
  costTokens   Int?
  latencyMs    Int?
  modelUsed    String?
  providerUsed String?
  createdAt    DateTime    @default(now())
  task         AiAgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([companyId, agentId])
  @@index([taskId])
  @@index([createdAt])
  @@map("ai_agent_runs")
}

model AiToolApprovalRequest {
  id                String    @id @default(cuid())
  companyId         String
  requestKey        String    @unique
  toolName          String
  status            String    @default("PENDING")
  channel           String
  source            String
  sideEffects       String    @default("write")
  approvalMode      String    @default("required")
  reason            String?
  conversationId    String?
  customerId        String?
  traceId           String?
  idempotencyKey    String?
  requestedByType   String    @default("ai_runtime")
  requestedByUserId String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  executionStatus   String?
  expiresAt         DateTime?
  inputSnapshot     String?   @db.Text
  previewSnapshot   String?   @db.Text
  metadata          String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId])
  @@index([companyId, status, createdAt])
  @@index([toolName, status])
  @@map("ai_tool_approval_requests")
}

model CompanySkill {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  description    String?
  triggerPhrases String   @default("")
  instructions   String
  tools          String   @default("[]")
  channels       String   @default("[]")
  priority       Int      @default(0)
  enabled        Boolean  @default(true)
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, enabled, priority])
  @@map("company_skills")
}
