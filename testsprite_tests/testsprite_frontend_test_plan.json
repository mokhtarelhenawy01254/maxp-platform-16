  {
    "id": "TC007",
    "title": "Complete purchase from shop to confirmation with valid coupon",
    "description": "Verifies a customer can add a product to cart, proceed through checkout, apply a valid coupon, and see an order confirmation.",
    "category": "Customer Purchase Journey",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /shop"
      },
      {
        "type": "action",
        "description": "Click on a product card in the shop grid"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/product\""
      },
      {
        "type": "action",
        "description": "Click on \"Add to Cart\""
      },
      {
        "type": "action",
        "description": "Click on \"Cart\" (or cart icon) to open the cart page"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Cart\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify the added product is visible in the cart list"
      },
      {
        "type": "action",
        "description": "Click on \"Proceed to Checkout\""
      }
    ]
  },
  {
    "id": "TC008",
    "title": "Apply valid coupon at checkout and complete order",
    "description": "Verifies a customer can apply coupon SUMMER during checkout and successfully complete the order.",
    "category": "Customer Purchase Journey",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /checkout"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Checkout\" is visible"
      },
      {
        "type": "action",
        "description": "Fill payment details with valid test payment information in the payment fields"
      },
      {
        "type": "action",
        "description": "Type \"SUMMER\" into the coupon code field"
      },
      {
        "type": "action",
        "description": "Click on \"Apply Coupon\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"SUMMER\" is visible"
      },
      {
        "type": "action",
        "description": "Click on \"Complete Order\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"Order confirmation\" is visible"
      }
    ]
  },
