{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "Chat application backend",
  "main": "server.js",
  "scripts": {
    "schema:generate": "prisma generate --schema=prisma/schema",
    "kill:ports": "npx -y kill-port 3007 3008 3009 || exit 0",
    "build": "npm run schema:generate",
    "predev": "npm run schema:generate",
    "check:syntax": "node scripts/check_syntax.js && node scripts/check_requires.js",
    "check:requires": "node scripts/check_requires.js",
    "check:customer-intent": "node scripts/customer-intent-architecture-guard.js",
    "check:legacy-plans": "node scripts/check-no-legacy-plans.js",
    "test:hotel-agent": "node scripts/test-hotel-agent.js",
    "prestart": "npm run schema:generate && npx prisma db push --schema=prisma/schema --accept-data-loss && npm run kill:ports",
    "start": "node server.js",
    "dev": "node services/ensureLocalPostgres.js && nodemon server.js",
    "test": "jest --runInBand --testTimeout=30000 --forceExit",
    "test:performance": "jest --testPathPattern=performance.test.js --testTimeout=60000",
    "test:integration": "jest --testPathPattern=integration --testTimeout=45000",
    "test:learning": "jest --testPathPattern=continuous-learning --testTimeout=30000",
    "security:isolation": "bash scripts/check-isolation.sh",
    "security:isolation-simple": "powershell -ExecutionPolicy Bypass -File scripts/check-isolation-simple.ps1",
    "security:isolation-basic": "node scripts/check-isolation-basic.js",
    "security:isolation-deep": "node scripts/deep-isolation-check.js",
    "security:isolation-summary": "node scripts/show-isolation-summary.js",
    "security:deep-summary": "node scripts/show-deep-analysis.js",
    "security:comprehensive": "node scripts/run-all-security-checks.js",
    "security:fix-critical": "node scripts/fix-critical-issues.js",
    "security:install": "pip install semgrep",
    "security:quick": "semgrep --config=.semgrep/isolation-rules.yml src/",
    "test:quick-analyze": "node scripts/quickAnalyze.js",
    "test:run": "node scripts/runTestDirect.js",
    "test:reviews": "node test-reviews-page.js",
    "setup:superadmin": "node scripts/createSuperAdmin.js",
    "seed:company-review-demo": "node scripts/seed_company_review_demo.js",
    "fix:roles": "node scripts/fix_production_roles.js",
    "fix:marketplace-app-settings": "node scripts/backfill_marketplace_app_settings.js",
    "fix:xp": "node scripts/backfill_completed_tasks_xp.js",
    "fix:xp-recalc": "node scripts/recalculate_xp.js",
    "fix:levels": "node scripts/fix_leaderboard_levels.js",
    "cleanse:monitor:p0": "node scripts/cleanse_monitor_p0_duplicates.js",
    "auth:reset-local-smoke": "node scripts/reset_local_auth_smoke_user.js",
    "sync:prod": "node scripts/sync_prod_rules.js",
    "check:rewards": "node scripts/check_reward_table.js",
    "create:rewards-table": "node scripts/create_reward_tables.js",
    "templates:validate": "node scripts/templates/validate_templates.js",
    "templates:create": "node scripts/templates/create_template.js",
    "templates:export-canonical": "node scripts/templates/export_canonical_theme.js",
    "templates:export-canonical-all": "node scripts/templates/export_canonical_theme.js --all --only-missing",
    "templates:validate-system-canonical": "node scripts/templates/validate_system_canonical_themes.js",
    "templates:test": "node test_registry.js && node test_registry_save_template.js && node test_safety_guards.js && node test_template_content_helpers.js",
    "templates:health": "npm run templates:validate && npm run templates:test",
    "catalog:validate": "node scripts/catalog/validate_marketplace_catalog.js",
    "catalog:diff": "node scripts/catalog/diff_marketplace_catalog_vs_db.js",
    "catalog:export-db": "node scripts/catalog/export_db_to_marketplace_catalog.js",
    "catalog:sync-target": "node scripts/sync_target_marketplace_catalog_entries.js",
    "catalog:deactivate-old": "node scripts/deactivate_old_marketplace_apps.js",
    "catalog:sync-pos": "node scripts/catalog/sync_pos_pro_app.js",
    "catalog:delete-ecommerce-pro": "node scripts/delete_ecommerce_pro_app.js",
    "catalog:delete-store-pro": "node scripts/catalog/remove_store_pro_app.js",
    "seed:permissions": "node prisma/seeds/seedPermissions.js",
    "seed:migrate-roles": "node prisma/seeds/migrateCustomRoles.js",
    "seed:link-roles": "node prisma/seeds/linkUserRoles.js",
    "migrate:legacy-roles": "node scripts/migrateLegacyPlatformRoles.js",
    "postinstall": "patch-package && node -e \"try{require('../../patch-telegram-updates.js')}catch(e){console.log('⚠️  patch-telegram-updates skipped:',e.code||e.message)}\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hapi/boom": "^10.0.1",
    "@huggingface/inference": "^4.13.5",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@napi-rs/canvas": "^1.0.5",
    "@prisma/client": "^6.12.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@whiskeysockets/baileys": "^6.7.24",
    "array-flatten": "^3.0.0",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.66.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dicom-parser": "^1.8.21",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "facebook-nodejs-business-sdk": "^24.0.1",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.10.0",
    "form-data": "^4.0.2",
    "fs": "^0.0.1-security",
    "helmet": "^8.1.0",
    "html-pdf-node": "^1.0.8",
    "iconv-lite": "^0.7.2",
    "input": "^1.0.1",
    "ioredis": "^5.8.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.10",
    "luxon": "^3.7.2",
    "moment-timezone": "^0.6.0",
    "mongoose": "^9.0.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "patch-package": "^8.0.1",
    "path": "^0.12.7",
    "pdfkit": "^0.17.2",
    "pg": "^8.17.2",
    "pino": "^9.14.0",
    "puppeteer": "^24.36.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "redis-server": "^1.2.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "uuid": "^11.1.0",
    "validator": "^13.15.35",
    "web-push": "^3.6.7",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "@types/supertest": "^2.0.12",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.0.1",
    "prisma": "^6.12.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "prisma": {
    "seed": "node prisma/seeds/marketplaceSeed.js"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@whiskeysockets/baileys@6.7.24": true,
    "ffmpeg-static@5.3.0": true,
    "puppeteer@10.4.0": true,
    "puppeteer@24.36.1": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.12.0": true
  }
}
