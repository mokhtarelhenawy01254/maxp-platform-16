// ============================================================================
// Manufacturing Execution & Production Engine Schema (MES)
// Wave 1: Core backend models for Multi-Variant BOMs, Production Orders,
// Stages, Material Issues, Goods Receipts, Scrap Tracking, and Settings.
// ============================================================================

enum ProductionOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  QC_PENDING
  COMPLETED
  CANCELLED
}

enum ProductionStageType {
  CUTTING
  PRINTING_EMBROIDERY
  SEWING
  FINISHING
  QC
  PACKAGING
  CUSTOM
}

enum ProductionStageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum MaterialIssueStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum FinishedGoodsReceiptStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum ScrapReason {
  CUTTING_WASTE
  SEWING_DEFECT
  FABRIC_FLAW
  PRINT_DEFECT
  OTHER
}

enum ProductionOrderType {
  FULL_PACKAGE
  CMT
  CUSTOMER_MATERIALS
  OUTSOURCED
  SAMPLE
  REWORK
}

enum CustomerOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

enum CustomerOrderPaymentKind {
  DEPOSIT
  INSTALLMENT
  FINAL
  CUSTOM
}

enum CustomerOrderPaymentDueTrigger {
  ON_CONFIRMATION
  ON_START
  ON_STAGE
  ON_DELIVERY
  MANUAL
}

enum CustomerOrderPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum StageExecutionEntity {
  INTERNAL
  EXTERNAL
}

enum AttachmentKind {
  IMAGE
  VIDEO
  DOC
}

enum AttachmentReviewStatus {
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  HIDDEN
}

/// Bill of Materials Header (قائمة مكونات ومواد التصنيع)
model BillOfMaterials {
  id                  String             @id @default(cuid())
  companyId           String
  productId           String?
  code                String
  name                String
  version             String             @default("1.0")
  baseQuantity        Decimal            @default(1.0) @db.Decimal(10, 2)
  wasteMarginPercent  Decimal            @default(0.0) @db.Decimal(5, 2)
  laborCostPerUnit    Decimal            @default(0.0) @db.Decimal(10, 2)
  overheadCostPerUnit Decimal            @default(0.0) @db.Decimal(10, 2)
  notes               String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  components          BomComponentItem[]
  standardStages      BomStandardStage[]
  orders              ProductionOrder[]
  techPacks           TechPack[]

  @@unique([companyId, code])
  @@index([companyId, productId])
  @@index([companyId, isActive])
  @@map("bill_of_materials")
}

/// BOM Component Item with Multi-Variant Rules (بنود خامات الـ BOM حسب المقاس واللون)
model BomComponentItem {
  id                 String          @id @default(cuid())
  bomId              String
  rawMaterialId      String
  rawMaterialName    String?
  consumptionPerUnit Decimal         @db.Decimal(10, 4)
  unit               String          @default("PIECE")
  purchaseUnit       String?
  consumptionUnit    String?
  fabricWidthM       Decimal?        @db.Decimal(8, 3)
  targetGsm          Decimal?        @db.Decimal(8, 2)
  composition        String?
  appliesToSizes     Json?
  appliesToColors    Json?
  scrapRate          Decimal         @default(0.0) @db.Decimal(5, 2)
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  bom                BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@index([rawMaterialId])
  @@map("bom_component_items")
}

/// Standard Production Stage Templates for a BOM (مراحل التشغيل المعيارية للـ BOM)
model BomStandardStage {
  id              String              @id @default(cuid())
  bomId           String
  name            String
  stageType       ProductionStageType @default(CUSTOM)
  sequence        Int                 @default(1)
  ratePerPiece    Decimal             @default(0.0) @db.Decimal(10, 2)
  standardMinutes Decimal             @default(0.0) @db.Decimal(8, 2)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  bom             BillOfMaterials     @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId, sequence])
  @@map("bom_standard_stages")
}

/// Production Order Header (أمر التشغيل والإنتاج)
model ProductionOrder {
  id                 String                        @id @default(cuid())
  companyId          String
  orderNumber        String
  bomId              String
  productId          String?
  plannedQuantity    Decimal                       @db.Decimal(10, 2)
  producedQuantity   Decimal                       @default(0.0) @db.Decimal(10, 2)
  scrappedQuantity   Decimal                       @default(0.0) @db.Decimal(10, 2)
  status             ProductionOrderStatus         @default(PLANNED)
  sourceWarehouseId  String?
  targetWarehouseId  String?
  startDate          DateTime?
  dueDate            DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  actualMaterialCost Decimal                       @default(0.0) @db.Decimal(12, 2)
  actualLaborCost    Decimal                       @default(0.0) @db.Decimal(12, 2)
  actualOverheadCost Decimal                       @default(0.0) @db.Decimal(12, 2)
  totalCost          Decimal                       @default(0.0) @db.Decimal(12, 2)
  unitCost           Decimal                       @default(0.0) @db.Decimal(12, 2)
  notes              String?
  createdById        String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  // Contract Manufacturing Layer (الدفعة 1: طبقة التعاقد)
  customerOrderId    String?
  orderType          ProductionOrderType           @default(FULL_PACKAGE)
  customerId         String?
  brandName          String?
  customerCountry    String?
  salePricePerUnit   Decimal?                      @db.Decimal(12, 2)
  deliveryAddress    String?
  deliveryMethod     String?
  responsibleUserId  String?

  // Technical Pack & Size Chart Layer (الدفعة 4: المواصفات الفنية وجداول المقاسات)
  techPackId         String?
  sizeChartId        String?
  sourceSampleOrderId String?

  bom                BillOfMaterials               @relation(fields: [bomId], references: [id], onDelete: Restrict)
  techPack           TechPack?                     @relation(fields: [techPackId], references: [id], onDelete: SetNull)
  sizeChart          SizeChart?                    @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  variants           ProductionOrderVariantMatrix[]
  stages             ProductionStage[]
  materialIssues     MaterialIssue[]
  goodsReceipts      FinishedGoodsReceipt[]
  scrapRecords       ScrapRecord[]
  customerOrder      CustomerOrder?                @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  customer           Customer?                     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  attachments        ManufacturingAttachment[]
  factoryAgreements  FactoryAgreement[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([companyId, bomId])
  @@index([companyId, productId])
  @@index([companyId, customerOrderId])
  @@index([companyId, customerId])
  @@index([companyId, orderType])
  @@index([companyId, techPackId])
  @@index([companyId, sizeChartId])
  @@index([companyId, sourceSampleOrderId])
  @@map("production_orders")
}

/// Production Order Variant Breakdown Matrix (مصفوفة كميات الأمر حسب المقاس واللون)
model ProductionOrderVariantMatrix {
  id               String          @id @default(cuid())
  orderId          String
  size             String
  color            String
  sku              String?
  plannedQuantity  Decimal         @db.Decimal(10, 2)
  producedQuantity Decimal         @default(0.0) @db.Decimal(10, 2)
  scrappedQuantity Decimal         @default(0.0) @db.Decimal(10, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order            ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, size, color])
  @@index([orderId])
  @@map("production_order_variant_matrices")
}

/// Active Production Stages for an Order (مراحل التشغيل التنفيذية لأمر الإنتاج)
model ProductionStage {
  id                String                @id @default(cuid())
  orderId           String
  name              String
  stageType         ProductionStageType   @default(CUSTOM)
  sequence          Int                   @default(1)
  status            ProductionStageStatus @default(PENDING)
  ratePerPiece      Decimal               @default(0.0) @db.Decimal(10, 2)
  standardMinutes   Decimal               @default(0.0) @db.Decimal(8, 2)
  actualMinutes     Decimal               @default(0.0) @db.Decimal(8, 2)
  completedQuantity Decimal               @default(0.0) @db.Decimal(10, 2)
  stageLaborCost    Decimal               @default(0.0) @db.Decimal(12, 2)
  assignedWorker    String?
  notes             String?
  startedAt         DateTime?
  completedAt       DateTime?
  executionEntity   StageExecutionEntity  @default(INTERNAL)
  partnerFactoryId  String?
  sentToFactoryAt   DateTime?
  factoryAckReceiptAt DateTime?
  factoryCompletedAt DateTime?
  factoryNotes      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  order             ProductionOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerFactory    PartnerFactory?       @relation(fields: [partnerFactoryId], references: [id], onDelete: SetNull)
  attachments       ManufacturingAttachment[]

  @@index([orderId, sequence])
  @@index([orderId, status])
  @@index([partnerFactoryId])
  @@map("production_stages")
}

/// Material Issue Voucher (إذن صرف خامات ومستلزمات إنتاج)
model MaterialIssue {
  id                String              @id @default(cuid())
  companyId         String
  orderId           String
  issueNumber       String
  sourceWarehouseId String?
  status            MaterialIssueStatus @default(ISSUED)
  date              DateTime            @default(now())
  totalCost         Decimal             @default(0.0) @db.Decimal(12, 2)
  notes             String?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order             ProductionOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items             MaterialIssueItem[]

  @@unique([companyId, issueNumber])
  @@index([companyId, orderId])
  @@map("material_issues")
}

/// Material Issue Line Items (بنود إذن صرف الخامات)
model MaterialIssueItem {
  id              String        @id @default(cuid())
  issueId         String
  rawMaterialId   String
  rawMaterialName String?
  quantity        Decimal       @db.Decimal(10, 4)
  unit            String        @default("PIECE")
  unitCost        Decimal       @default(0.0) @db.Decimal(10, 2)
  totalCost       Decimal       @default(0.0) @db.Decimal(12, 2)
  batchNumber     String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  issue           MaterialIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([rawMaterialId])
  @@map("material_issue_items")
}

/// Finished Goods Receipt Voucher (إذن استلام إنتاج تام)
model FinishedGoodsReceipt {
  id                String                     @id @default(cuid())
  companyId         String
  orderId           String
  receiptNumber     String
  targetWarehouseId String?
  status            FinishedGoodsReceiptStatus @default(RECEIVED)
  date              DateTime                   @default(now())
  totalQuantity     Decimal                    @default(0.0) @db.Decimal(10, 2)
  unitCost          Decimal                    @default(0.0) @db.Decimal(12, 2)
  totalCost         Decimal                    @default(0.0) @db.Decimal(12, 2)
  notes             String?
  createdById       String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  order             ProductionOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items             FinishedGoodsReceiptItem[]

  @@unique([companyId, receiptNumber])
  @@index([companyId, orderId])
  @@map("finished_goods_receipts")
}

/// Finished Goods Receipt Items (بنود إذن استلام التام بالمقاس واللون)
model FinishedGoodsReceiptItem {
  id            String               @id @default(cuid())
  receiptId     String
  size          String?
  color         String?
  sku           String?
  goodQuantity  Decimal              @default(0.0) @db.Decimal(10, 2)
  scrapQuantity Decimal              @default(0.0) @db.Decimal(10, 2)
  unitCost      Decimal              @default(0.0) @db.Decimal(12, 2)
  totalCost     Decimal              @default(0.0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  receipt       FinishedGoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("finished_goods_receipt_items")
}

/// Production Scrap & Waste Records (سجل الهالك والفاقد الصناعي)
model ScrapRecord {
  id          String          @id @default(cuid())
  companyId   String
  orderId     String
  stageId     String?
  materialId  String?
  size        String?
  color       String?
  quantity    Decimal         @db.Decimal(10, 2)
  unit        String          @default("PIECE")
  cost        Decimal         @default(0.0) @db.Decimal(12, 2)
  reason      ScrapReason     @default(CUTTING_WASTE)
  isNormal    Boolean         @default(true)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order       ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId, orderId])
  @@map("scrap_records")
}

/// Manufacturing Settings per Company (إعدادات التصنيع وحسابات WIP)
model ManufacturingSettings {
  id                          String   @id @default(cuid())
  companyId                   String   @unique
  defaultSourceWarehouseId    String?
  defaultTargetWarehouseId    String?
  defaultOverheadRatePerPiece Decimal  @default(0.0) @db.Decimal(10, 2)
  defaultWasteMarginPercent   Decimal  @default(3.0) @db.Decimal(5, 2)
  wipAccountId                String?
  rawMaterialsAccountId       String?
  accruedWagesAccountId       String?
  overheadAppliedAccountId    String?
  finishedGoodsAccountId      String?
  autoPostingEnabled          Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("manufacturing_settings")
}


/// Customer Order Header — Parent Contract Order for CM (أمر العميل الأب — طبقة التعاقد)
model CustomerOrder {
  id                String                   @id @default(cuid())
  companyId         String
  orderNumber       String
  customerId        String?
  brandName         String?
  customerCountry   String?
  responsibleUserId String?
  status            CustomerOrderStatus      @default(DRAFT)
  expectedDelivery  DateTime?
  notes             String?
  createdById       String?
  currency          String                   @default("EGP")
  portalToken       String?                  @unique
  portalEnabled     Boolean                  @default(false)
  portalLastAccessAt DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  customer          Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orders            ProductionOrder[]
  payments          CustomerOrderPayment[]
  factoryAgreements FactoryAgreement[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@map("customer_orders")
}

/// Customer Order Payment Schedule (جدول دفعات أمر العميل)
model CustomerOrderPayment {
  id              String                         @id @default(cuid())
  customerOrderId String
  kind            CustomerOrderPaymentKind       @default(CUSTOM)
  label           String?
  percent         Decimal?                       @db.Decimal(5, 2)
  amount          Decimal                        @db.Decimal(12, 2)
  dueTrigger      CustomerOrderPaymentDueTrigger @default(MANUAL)
  dueDate         DateTime?
  status          CustomerOrderPaymentStatus     @default(PENDING)
  paidAt          DateTime?
  paidAmount      Decimal?                       @db.Decimal(12, 2)
  method          String?
  notes           String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  customerOrder   CustomerOrder                  @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)

  @@index([customerOrderId])
  @@map("customer_order_payments")
}

/// Partner Factory / Subcontractor (المصانع الشركاء وجهات التشغيل الخارجية)
model PartnerFactory {
  id                 String                    @id @default(cuid())
  companyId          String
  name               String
  code               String?
  specialty          String?
  contactPerson      String?
  phone              String?
  email              String?
  address            String?
  notes              String?
  isActive           Boolean                   @default(true)
  accessToken        String?                   @unique
  portalEnabled      Boolean                   @default(false)
  portalLastAccessAt DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  stages             ProductionStage[]
  attachments        ManufacturingAttachment[]
  stageTemplates     ProductionStageTemplate[]
  agreements         FactoryAgreement[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([accessToken])
  @@map("partner_factories")
}

/// Manufacturing Attachment for Orders & Stages (مرفقات أوامر ومراحل التشغيل)
model ManufacturingAttachment {
  id               String                 @id @default(cuid())
  companyId        String
  orderId          String?
  stageId          String?
  partnerFactoryId String?
  url              String
  kind             AttachmentKind         @default(IMAGE)
  caption          String?
  uploadedById     String?
  reviewStatus     AttachmentReviewStatus @default(UNDER_REVIEW)
  reviewedBy       String?
  reviewedAt       DateTime?
  rejectReason     String?
  publishedAt      DateTime?
  publishedBy      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  order            ProductionOrder?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage            ProductionStage?       @relation(fields: [stageId], references: [id], onDelete: SetNull)
  partnerFactory   PartnerFactory?        @relation(fields: [partnerFactoryId], references: [id], onDelete: SetNull)

  @@index([companyId, orderId])
  @@index([stageId])
  @@index([companyId, reviewStatus])
  @@index([partnerFactoryId])
  @@map("manufacturing_attachments")
}


// ============================================================================
// Wave 4: Technical Product Specification (Tech Pack) & Multi-Source Size Charts
// ============================================================================

enum TechPackStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum TechPackFileKind {
  IMAGE
  PDF
  OTHER
}

enum SizeChartStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum SizeChartUnit {
  CM
  INCH
}

enum SizeChartMeasurementMethod {
  FLAT
  ROUND
}

enum SizeChartRowSource {
  CUSTOMER
  PATTERN
  FACTORY
}

/// Technical Product Specification (ملف المنتج الفني - Tech Pack)
model TechPack {
  id               String           @id @default(cuid())
  companyId        String
  code             String
  name             String
  version          Int              @default(1)
  status           TechPackStatus   @default(DRAFT)
  productId        String?
  bomId            String?
  brand            String?
  fabricSummary    String?
  printDetails     String?
  labelDetails     String?
  packagingDetails String?
  instructions     String?
  notes            String?
  approvedBy       String?
  approvedAt       DateTime?
  createdBy        String?
  supersedesId     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  files            TechPackFile[]
  sizeCharts       SizeChart[]
  bom              BillOfMaterials? @relation(fields: [bomId], references: [id], onDelete: SetNull)
  orders           ProductionOrder[]

  @@unique([companyId, code, version])
  @@index([companyId, status])
  @@index([companyId, productId])
  @@index([companyId, bomId])
  @@index([supersedesId])
  @@map("tech_packs")
}

/// Tech Pack Attachment Files (ملفات وصور ومستندات ملف المنتج الفني)
model TechPackFile {
  id          String           @id @default(cuid())
  techPackId  String
  fileName    String
  url         String
  kind        TechPackFileKind @default(IMAGE)
  uploadedBy  String?
  uploadedAt  DateTime         @default(now())

  techPack    TechPack         @relation(fields: [techPackId], references: [id], onDelete: Cascade)

  @@index([techPackId])
  @@map("tech_pack_files")
}

/// Product Size Chart Header with Multi-Version Support (جدول مقاسات المنتج الفني)
model SizeChart {
  id                String                     @id @default(cuid())
  companyId         String
  code              String
  name              String
  version           Int                        @default(1)
  status            SizeChartStatus            @default(DRAFT)
  unit              SizeChartUnit              @default(CM)
  measurementMethod SizeChartMeasurementMethod @default(FLAT)
  productId         String?
  techPackId        String?
  notes             String?
  approvedBy        String?
  approvedAt        DateTime?
  createdBy         String?
  supersedesId      String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  techPack          TechPack?                  @relation(fields: [techPackId], references: [id], onDelete: SetNull)
  rows              SizeChartRow[]
  orders            ProductionOrder[]

  @@unique([companyId, code, version])
  @@index([companyId, status])
  @@index([companyId, productId])
  @@index([companyId, techPackId])
  @@index([supersedesId])
  @@map("size_charts")
}

/// Product Size Chart Matrix Row for 3 Interlinked Sources (صف قياسات المقاس: عميل / باترون / مصنع)
model SizeChartRow {
  id             String             @id @default(cuid())
  chartId        String
  sizeLabel      String
  measurementKey String
  value          Decimal            @db.Decimal(10, 2)
  tolerance      Decimal            @default(1.0) @db.Decimal(10, 2)
  source         SizeChartRowSource @default(CUSTOMER)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  chart          SizeChart          @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@index([chartId])
  @@index([chartId, source])
  @@index([chartId, sizeLabel, measurementKey, source])
  @@map("size_chart_rows")
}


// ============================================================================
// Wave 5: Standalone Sample Manufacturing Order (أمر تصنيع عينة مستقل)
// ============================================================================

enum SampleOrderStatus {
  DRAFT
  IN_PROGRESS
  APPROVED
  REJECTED
  CONVERTED
}

enum SampleMaterialSource {
  CUSTOMER
  COMPANY
}

enum SampleFileKind {
  IMAGE
  PDF
  OTHER
}

/// Standalone Sample Manufacturing Order (أمر تصنيع عينة مستقل)
model SampleOrder {
  id               String               @id @default(cuid())
  companyId        String
  sampleNumber     String
  customerId       String?
  customerName     String?
  brandName        String?
  productName      String
  productId        String?
  bomId            String?
  techPackId       String?
  plannedQuantity  Int                  @default(1)
  size             String?
  color            String?
  materialSource   SampleMaterialSource @default(COMPANY)
  fee              Decimal?             @db.Decimal(10, 2)
  status           SampleOrderStatus    @default(DRAFT)
  dueDate          DateTime?
  designNotes      String?
  resultNotes      String?
  convertedOrderId String?
  createdById      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  stages           SampleOrderStage[]
  attachments      SampleOrderAttachment[]

  @@unique([companyId, sampleNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, productId])
  @@index([companyId, convertedOrderId])
  @@map("sample_orders")
}

/// Standalone Sample Order Simplified Production Stage (مراحل تشغيل العينة المبسطة)
model SampleOrderStage {
  id            String              @id @default(cuid())
  sampleOrderId String
  name          String
  stageType     ProductionStageType @default(CUSTOM)
  sequence      Int                 @default(1)
  status        String              @default("PENDING")
  notes         String?
  templateSetId String?
  templateId    String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  sampleOrder   SampleOrder         @relation(fields: [sampleOrderId], references: [id], onDelete: Cascade)

  @@index([sampleOrderId])
  @@index([sampleOrderId, sequence])
  @@map("sample_order_stages")
}

/// Standalone Sample Order Attachment Files (مرفقات وصور العينة)
model SampleOrderAttachment {
  id            String         @id @default(cuid())
  sampleOrderId String
  fileName      String
  url           String
  kind          SampleFileKind @default(IMAGE)
  uploadedBy    String?
  uploadedAt    DateTime       @default(now())

  sampleOrder   SampleOrder    @relation(fields: [sampleOrderId], references: [id], onDelete: Cascade)

  @@index([sampleOrderId])
  @@map("sample_order_attachments")
}


// ============================================================================
// Wave 6: Standard Production Stage Templates Library & Sets
// ============================================================================

/// Standard Production Stage Template (قالب مرحلة إنتاج قياسية في المكتبة)
model ProductionStageTemplate {
  id                      String                           @id @default(cuid())
  companyId               String
  code                    String
  name                    String
  stageType               ProductionStageType              @default(CUSTOM)
  sequence                Int                              @default(1)
  standardMinutes         Decimal                          @default(0.0) @db.Decimal(8, 2)
  ratePerPiece            Decimal                          @default(0.0) @db.Decimal(10, 2)
  executionEntity         StageExecutionEntity             @default(INTERNAL)
  defaultPartnerFactoryId String?
  instructions            String?
  isActive                Boolean                          @default(true)
  usageCount              Int                              @default(0)
  createdById             String?
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt

  defaultPartnerFactory   PartnerFactory?                  @relation(fields: [defaultPartnerFactoryId], references: [id], onDelete: SetNull)
  setItems                ProductionStageTemplateSetItem[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, stageType])
  @@map("production_stage_templates")
}

/// Standard Production Stage Template Set / Sequence (مجموعة مسار مراحل إنتاج قياسي)
model ProductionStageTemplateSet {
  id          String                           @id @default(cuid())
  companyId   String
  code        String
  name        String
  description String?
  isActive    Boolean                          @default(true)
  usageCount  Int                              @default(0)
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt

  items       ProductionStageTemplateSetItem[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("production_stage_template_sets")
}

/// Item inside a Production Stage Template Set (بند مرحلة داخل مجموعة المسار القياسي)
model ProductionStageTemplateSetItem {
  id         String                     @id @default(cuid())
  setId      String
  templateId String
  sequence   Int
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  set        ProductionStageTemplateSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  template   ProductionStageTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([setId, sequence])
  @@index([setId])
  @@index([templateId])
  @@map("production_stage_template_set_items")
}


// ============================================================================
// Wave 7: Partner Factory Agreements & Payments (اتفاقيات المصانع الشركاء ودفعاتها)
// ============================================================================

enum FactoryAgreementPricingMode {
  PER_PIECE
  PER_STAGE
  HOURLY
  FIXED
}

enum FactoryAgreementStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum FactoryAgreementPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

/// Independent Partner Factory Agreement (اتفاق مصنع شريك مستقل)
model FactoryAgreement {
  id                 String                      @id @default(cuid())
  companyId          String
  partnerFactoryId   String
  code               String                      // Unique per company: FA-YYYY-#####
  title              String
  orderId            String?
  customerOrderId    String?
  pricingMode        FactoryAgreementPricingMode @default(PER_PIECE)
  totalValue         Decimal?                    @db.Decimal(12, 2)
  currency           String                      @default("EGP")
  startDate          DateTime?
  endDate            DateTime?

  // 10 Contractual Terms (بنود العقد العشرة - نصوص حرة منفصلة)
  scopeOfOperations  String?                     @db.Text
  productsDesc       String?                     @db.Text
  quantitiesNotes    String?                     @db.Text
  qualityTerms       String?                     @db.Text
  materialOwnership  String?                     @db.Text
  wastePolicy        String?                     @db.Text
  deliveryTerms      String?                     @db.Text
  reworkPolicy       String?                     @db.Text
  notes              String?                     @db.Text

  status             FactoryAgreementStatus      @default(DRAFT)
  createdById        String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  partnerFactory     PartnerFactory              @relation(fields: [partnerFactoryId], references: [id], onDelete: Restrict)
  order              ProductionOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerOrder      CustomerOrder?              @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  payments           FactoryAgreementPayment[]
  files              FactoryAgreementFile[]

  @@unique([companyId, code])
  @@index([companyId, partnerFactoryId])
  @@index([companyId, status])
  @@index([orderId])
  @@index([customerOrderId])
  @@map("factory_agreements")
}

/// Factory Agreement Payment Schedule (جدول دفعات اتفاقية المصنع)
model FactoryAgreementPayment {
  id                 String                        @id @default(cuid())
  agreementId        String
  seq                Int
  label              String                        // e.g. مقدم، إنتاج، تسليم، تسوية
  percent            Decimal?                      @db.Decimal(5, 2)
  amount             Decimal                       @db.Decimal(12, 2)
  dueDate            DateTime?
  status             FactoryAgreementPaymentStatus @default(PENDING)
  paidAt             DateTime?
  paidById           String?
  reference          String?
  notes              String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  agreement          FactoryAgreement              @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@index([agreementId, seq])
  @@index([status])
  @@map("factory_agreement_payments")
}

/// Factory Agreement Attachment Files (ملفات ومرفقات اتفاقية المصنع)
model FactoryAgreementFile {
  id                 String           @id @default(cuid())
  agreementId        String
  fileName           String
  url                String
  kind               String           @default("DOCUMENT")
  uploadedBy         String?
  uploadedAt         DateTime         @default(now())

  agreement          FactoryAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@map("factory_agreement_files")
}
