model Task {
  id                                                     String           @id @default(cuid())
  projectId                                              String?
  goalId                                                 String?
  title                                                  String
  description                                            String
  aiDescription                                          String?
  pageUrl                                                String?
  status                                                 TasksStatus      @default(PENDING)
  priority                                               TasksPriority    @default(MEDIUM)
  type                                                   String           @default("general")
  assignedTo                                             String
  createdBy                                              String
  dueDate                                                DateTime?
  estimatedHours                                         Int              @default(0)
  actualHours                                            Int              @default(0)
  progress                                               Int              @default(0)
  tags                                                   String?
  dependencies                                           String?
  companyId                                              String
  createdAt                                              DateTime         @default(now())
  updatedAt                                              DateTime         @updatedAt
  categoryId                                             String?
  color                                                  String?
  completedDate                                          DateTime?
  isRecurring                                            Boolean          @default(false)
  measurementType                                        TaskMeasurementType @default(TIME)
  metricUnit                                             String?
  metricTargetValue                                      Decimal?         @db.Decimal(12, 2)
  metricCurrentValue                                     Decimal          @default(0.00) @db.Decimal(12, 2)
  order                                                  Int              @default(0)
  parentTaskId                                           String?
  recurringRule                                          String?
  startDate                                              DateTime?
  hasEvidence                                            Boolean          @default(false)
  missingEvidence                                        Boolean          @default(false)
  evidence                                               Json?
  acceptanceCriteria                                     String?
  acceptanceCriteriaMet                                  Boolean          @default(false)
  criteriaChecklist                                      Json?
  returnCount                                            Int              @default(0)
  lastReturnReason                                       String?
  returnReasonType                                       String?
  returnSeverity                                         Int?
  submittedForReviewAt                                   DateTime?
  approvedAt                                             DateTime?
  approvedBy                                             String?
  ownerOverride                                          Boolean          @default(false)
  ownerOverrideReason                                    String?
  assignee                                               User             @relation("tasks_assignedToTousers", fields: [assignedTo], references: [id])
  taskCategory                                           TaskCategory?    @relation(fields: [categoryId], references: [id])
  company                                                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator                                                User             @relation("tasks_createdByTousers", fields: [createdBy], references: [id])
  goal                                                   Goal?            @relation(fields: [goalId], references: [id])
  task                                                   Task?            @relation("tasksTotasks", fields: [parentTaskId], references: [id])
  other_tasks                                            Task[]           @relation("tasksTotasks")
  project                                                Project?         @relation(fields: [projectId], references: [id])
  time_entries                                           TimeEntry[]
  taskActivities                                         TaskActivity[]
  taskAttachments                                        TaskAttachment[]
  taskChecklists                                         TaskChecklist[]
  taskComments                                           TaskComment[]
  task_dependencies_task_dependencies_dependsOnIdTotasks TaskDependency[] @relation("task_dependencies_dependsOnIdTotasks")
  task_dependencies_task_dependencies_taskIdTotasks      TaskDependency[] @relation("task_dependencies_taskIdTotasks")
  taskWatchers                                           TaskWatcher[]
  convertedFromBacklog                                   TaskBacklog[]    @relation("task_backlog_convertedTask")

  @@index([assignedTo])
  @@index([categoryId])
  @@index([companyId])
  @@index([createdBy])
  @@index([dueDate])
  @@index([goalId])
  @@index([order])
  @@index([parentTaskId])
  @@index([priority])
  @@index([projectId])
  @@index([status])
}

model TaskApiCredential {
  id                 String                @id @default(cuid())
  companyId          String?
  userId             String?
  defaultActingUserId String?
  name               String
  description        String?
  keyPrefix          String                @unique
  keyHash            String                @unique
  scopes             String
  isActive           Boolean               @default(true)
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?
  revokedReason      String?
  createdByUserId    String?
  revokedByUserId    String?
