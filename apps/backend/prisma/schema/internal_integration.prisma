// Location: backend/prisma/schema/internal_integration.prisma

model CompanyConnection {
  id                  String           @id @default(cuid())
  providerId          String           // The company sharing data (e.g., Company A)
  consumerId          String           // The company pulling data (e.g., Company B)
  allowProductPull    Boolean          @default(false)
  allowOrderPull      Boolean          @default(false)
  commissionRate      Float?           // override commission % for this connection (null = use default)
  status              ConnectionStatus @default(ACTIVE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  provider            Company          @relation("ProvidedConnections", fields: [providerId], references: [id], onDelete: Cascade)
  consumer            Company          @relation("ConsumedConnections", fields: [consumerId], references: [id], onDelete: Cascade)

  @@unique([providerId, consumerId])
  @@map("company_connections")
}

model CompanyConnectionRequest {
  id               String           @id @default(cuid())
  requesterId      String           // Company sending the request
  receiverId       String           // Company receiving the request
  status           RequestStatus    @default(PENDING)
  message          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  requester        Company          @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver         Company          @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([receiverId])
  @@map("company_connection_requests")
}

model OrderSyncQueue {
  id             String    @id @default(cuid())
  orderId        String
  consumerId     String              // The company that created the order
  providerId     String?             // The provider company (null = not yet matched)
  status         SyncQueueStatus     @default(PENDING)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(10)
  lastError      String?
  nextRetryAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, nextRetryAt])
  @@index([orderId])
  @@index([consumerId])
  @@map("order_sync_queue")
}

enum SyncQueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ConnectionStatus {
  ACTIVE
  PAUSED
  TERMINATED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
