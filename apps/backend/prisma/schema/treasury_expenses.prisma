model TreasuryAccount {
  id              String                @id @default(cuid())
  companyId       String
  name            String
  type            String                @default("CASH") /// CASH, BANK, WALLET, CUSTODY
  balance         Decimal               @default(0.0) @db.Decimal(12, 2)
  currency        String                @default("EGP")
  accountNumber   String?
  bankName        String?
  holderName      String?
  description     String?
  isDefault       Boolean               @default(false)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  company         Company               @relation("CompanyTreasuryAccounts", fields: [companyId], references: [id], onDelete: Cascade)
  expenses        CompanyExpense[]      @relation("TreasuryExpenses")
  transactions    TreasuryTransaction[] @relation("AccountTransactions")
  capitalDeposits CapitalTransaction[]  @relation("AccountCapitalDeposits")
  financialPostings FinancialPosting[]  @relation("AccountFinancialPostings")

  @@index([companyId])
  @@index([type])
  @@index([isActive])
  @@map("treasury_accounts")
}

model CapitalTransaction {
  id                 String           @id @default(cuid())
  companyId          String
  treasuryAccountId  String
  amount             Decimal          @db.Decimal(12, 2)
  type               String           @default("CAPITAL_INJECTION") /// INITIAL_CAPITAL, CAPITAL_INJECTION, OWNER_FINANCING, RETAINED_EARNINGS
  investorName       String?
  referenceNumber    String?
  notes              String?
  date               DateTime         @default(now())
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company            Company          @relation("CompanyCapitalTransactions", fields: [companyId], references: [id], onDelete: Cascade)
  treasuryAccount    TreasuryAccount  @relation("AccountCapitalDeposits", fields: [treasuryAccountId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([treasuryAccountId])
  @@index([date])
  @@map("capital_transactions")
}

model ExpenseCategory {
  id          String           @id @default(cuid())
  companyId   String
  name        String
  nameEn      String?
  type        String           @default("OPEX") /// OPEX (Operational) or CAPEX (Capital/Assets)
  color       String?          @default("#3b82f6")
  icon        String?          @default("Tag")
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  expenses    CompanyExpense[]

  @@index([companyId])
  @@map("expense_categories")
}

model CompanyExpense {
  id                 String           @id @default(cuid())
  companyId          String
  expenseNumber      String
  title              String
  amount             Decimal          @db.Decimal(12, 2)
  categoryId         String?
  treasuryAccountId  String
  type               String           @default("OPEX") /// OPEX, CAPEX
  beneficiary        String?
  invoiceNumber      String?
  receiptUrl         String?
  paymentDate        DateTime         @default(now())
  isRecurring        Boolean          @default(false)
  recurringInterval  String?          /// MONTHLY, WEEKLY, YEARLY
  nextDueDate        DateTime?
  status             String           @default("PAID") /// PAID, PENDING, CANCELLED
  notes              String?
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company            Company          @relation("CompanyExpenses", fields: [companyId], references: [id], onDelete: Cascade)
  treasuryAccount    TreasuryAccount  @relation("TreasuryExpenses", fields: [treasuryAccountId], references: [id], onDelete: Cascade)
  category           ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([treasuryAccountId])
  @@index([categoryId])
  @@index([paymentDate])
  @@index([type])
  @@map("company_expenses")
}

model TreasuryTransaction {
  id                 String           @id @default(cuid())
  companyId          String
  treasuryAccountId  String
  amount             Decimal          @db.Decimal(12, 2)
  type               String           /// DEPOSIT, WITHDRAWAL, TRANSFER_IN, TRANSFER_OUT, EXPENSE
  runningBalance     Decimal          @db.Decimal(12, 2)
  referenceType      String?          /// EXPENSE, CAPITAL, TRANSFER
  referenceId        String?
  description        String
  date               DateTime         @default(now())
  createdById        String?
  createdAt          DateTime         @default(now())

  company            Company          @relation("CompanyTreasuryTransactions", fields: [companyId], references: [id], onDelete: Cascade)
  treasuryAccount    TreasuryAccount  @relation("AccountTransactions", fields: [treasuryAccountId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([treasuryAccountId])
  @@index([date])
  @@map("treasury_transactions")
}

model FinancialPosting {
  id                 String           @id @default(cuid())
  companyId          String
  sourceType         String           /// CASE_INVOICE, SUPPLIER_PAYMENT, TECHNICIAN_PAYOUT, CASE_BOM_CONSUMPTION, CAPITAL_DEPOSIT, EXPENSE
  sourceId           String
  treasuryAccountId  String?
  direction          String           /// IN, OUT
  amount             Decimal          @db.Decimal(12, 2)
  status             String           @default("PENDING_CONFIRM") /// PENDING_CONFIRM, POSTED, VOID
  postedBy           String?
  postedAt           DateTime?
  reference          String?
  notes              String?
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  treasuryAccount    TreasuryAccount? @relation("AccountFinancialPostings", fields: [treasuryAccountId], references: [id], onDelete: SetNull)

  @@unique([companyId, sourceType, sourceId])
  @@index([companyId])
  @@index([treasuryAccountId])
  @@index([status])
  @@index([sourceType])
  @@index([createdAt])
  @@map("financial_postings")
}
