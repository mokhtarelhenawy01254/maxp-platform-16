model CompetitorMediaNote {
  id           String     @id @default(cuid())
  competitorId String
  note         String     @db.Text
  createdAt    DateTime   @default(now())

  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([competitorId, createdAt(sort: Desc)])
  @@map("competitor_media_notes")
}

model CompetitorComparison {
  id                    String     @id @default(cuid())
  competitorId          String
  featureName           String
  competitorDescription String?    @db.Text
  ourDescription        String?    @db.Text
  easiestToUse          String?
  stronger              String?
  notes                 String?    @db.Text
  sortOrder             Int        @default(0)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  competitor            Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@map("competitor_comparisons")
}

model CompetitorDevIdea {
  id           String     @id @default(cuid())
  competitorId String
  title        String
  description  String?    @db.Text
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  images       CompetitorDevIdeaImage[]

  @@index([competitorId])
  @@map("competitor_dev_ideas")
}

model CompetitorDevIdeaImage {
  id        String   @id @default(cuid())
  ideaId    String
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  idea      CompetitorDevIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("competitor_dev_idea_images")
}

model CompetitorActivityImage {
  id           String     @id @default(cuid())
  competitorId String
  imageUrl     String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@map("competitor_activity_images")
}

model CompetitorFeatureImage {
  id           String     @id @default(cuid())
  competitorId String
  imageUrl     String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@map("competitor_feature_images")
}
