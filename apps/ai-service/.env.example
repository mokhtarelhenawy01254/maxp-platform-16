# ============================================
# MaxP AI Service - Environment Configuration
# ============================================
# Copy this file to `.env` and fill in real values
# DO NOT commit `.env` to git
#
# Required: DATABASE_URL, MAXP_API_URL, MAXP_SERVICE_TOKEN,
#           and one LLM key: ANTHROPIC_API_KEY, OPENAI_API_KEY, or GOOGLE_API_KEY.
# ============================================

# Application
APP_NAME=maxp-ai-service
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database (Postgres)
# Local dev: use docker-compose default
# Production: use managed Postgres with TLS
DATABASE_URL=postgresql+asyncpg://maxp:maxp@localhost:5433/maxp_ai

# MaxP Backend API
# In same-server production, prefer MaxP's local backend URL over a public URL.
MAXP_API_URL=http://localhost:3000
MAXP_SERVICE_TOKEN=replace-me-with-shared-token-from-maxp

# LLM Providers (at least one required)
ANTHROPIC_API_KEY=sk-ant-replace-me
OPENAI_API_KEY=sk-replace-me
GOOGLE_API_KEY=replace-me

# LLM Defaults
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-4-6
GOOGLE_GEMINI_MODEL=gemma-4-31b-it

# Agent Templates
# Path to the backend agents/ directory containing agent.json templates.
# If not set, the service auto-discovers relative to the project structure.
AGENTS_TEMPLATES_ROOT=../backend/agents

# CORS (empty for internal service)
CORS_ORIGINS=

# Observability (optional)
OTLP_ENDPOINT=http://localhost:4318/v1/traces
SENTRY_DSN=

# ============================================
# 2026 Features (optional, all have safe defaults)
# ============================================

# Redis for queue + cache (optional, falls back to in-memory in dev)
# REDIS_URL=redis://localhost:6379/0

# MCP Servers - JSON list of {name, url, api_key?}
# MCP_SERVERS=[{"name": "catalog", "url": "http://localhost:3000"}]

# Gemini prompt cache TTL in seconds (default: 1800 = 30 min)
# PROMPT_CACHE_TTL=1800

# Use pgvector for native vector search (default: true)
# ENABLE_PG_VECTOR=true

# Use Microsoft Agent Framework Magentic orchestration (default: false)
# ENABLE_MAGENTIC_ORCHESTRATION=false
