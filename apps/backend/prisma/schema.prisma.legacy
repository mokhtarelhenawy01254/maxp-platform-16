/// UNUSED - Planned feature for WhatsApp notification templates
model WhatsAppNotificationTemplate {
  id                         String                                @id @default(cuid())
  companyId                  String
  name                       String
  category                   WhatsAppNotificationTemplatesCategory
  eventType                  String
  content                    String
  contentWithMedia           Boolean                               @default(false)
  mediaUrl                   String?
  mediaType                  String?
  hasButtons                 Boolean                               @default(false)
  buttons                    String?
  hasList                    Boolean                               @default(false)
  listData                   String?
  variables                  String?
  isActive                   Boolean                               @default(true)
  isDefault                  Boolean                               @default(false)
  metaTemplateName           String?
  metaTemplateLanguage       String?
  metaTemplateStatus         String?
  sentCount                  Int                                   @default(0)
  deliveredCount             Int                                   @default(0)
  readCount                  Int                                   @default(0)
  clickCount                 Int                                   @default(0)
  createdAt                  DateTime                              @default(now())
  updatedAt                  DateTime                              @updatedAt
  whatsapp_notification_logs WhatsAppNotificationLog[]
  company                    Company                               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, category])
  @@map("whatsapp_notification_templates")
}

model ConversionEvent {
  id        String   @id @default(cuid())
  companyId String
  sessionId String
  eventType String
  productId String?
  orderId   String?
  value     Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  metadata  String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, eventType, createdAt])
  @@index([sessionId, companyId])
  @@index([companyId, productId, eventType, createdAt])
  @@index([productId, companyId])
  @@map("conversion_events")
}

// --- From: marketplace.prisma ---
/// UNUSED - Planned feature for app marketplace
model MarketplaceApp {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  description  String
  logo         String?
  images       Json?
  coverImage   String?
  monthlyPrice Decimal      @db.Decimal(10, 2)
  yearlyPrice  Decimal      @db.Decimal(10, 2)
  pricingModel PricingModel @default(SUBSCRIPTION)
  unitPrice    Decimal?     @db.Decimal(10, 2)
  unitName     String?
  ppuBillingMethod String?   @default("PER_ORDER")
  features     Json?
  isActive     Boolean      @default(true)
  isPublic     Boolean      @default(true)
  isFeatured   Boolean      @default(false)
  requiredApps Json?
  trialDays    Int          @default(14)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  mainRoute    String?
  adminRoute   String?
  category     String       @default("general")
  rating       Float        @default(0)
  reviewCount  Int          @default(0)
  installCount Int          @default(0)
  isPopular    Boolean      @default(false)

  // Phase 5: Hardening
  engineCompatibility String?
  icon                String?
  pricingRules        AppPricingRule[]
  reviews             AppReview[]
  installations       CompanyApp[]

  @@map("marketplace_apps")
}

/// UNUSED - Planned feature for app marketplace
model CompanyApp {
  id                 String         @id @default(cuid())
  companyId          String
  appId              String
  activePricingModel PricingModel   @default(SUBSCRIPTION)
  status             String         @default("ACTIVE")
  trialEndsAt        DateTime?
  validUntil         DateTime?
  settings           Json?
  nextBillingAt      DateTime?
  totalSpent         Decimal        @default(0) @db.Decimal(10, 2)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  usageLogs          AppUsageLog[]
  app                MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, appId])
  @@map("company_apps")
}

/// UNUSED - Planned feature for app marketplace
model AppUsageLog {
  id           String     @id @default(cuid())
  companyAppId String
  feature      String?
