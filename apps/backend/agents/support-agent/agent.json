{
  "slug": "support-agent",
  "name": "Support Agent",
  "role": "SUPPORT",
  "version": "1.0.0",
  "modelPolicy": {
    "default": "gemini-2.5-flash",
    "fallback": "gemini-2.5-pro"
  },
  "instructions": {
    "agents": "AGENTS.md",
    "soul": "SOUL.md",
    "tools": "TOOLS.md",
    "persona": "PERSONA.md"
  },
  "personaMeta": {
    "language": "arabic",
    "dialect": "standard",
    "tone": "empathetic",
    "formality": "formal"
  },
  "guardrails": {
    "requireDraftOrders": false,
    "confirmBeforePrice": false,
    "singleQuestionPerTurn": false
  },
  "allowedTools": [
    "order.lookup",
    "customer.info",
    "shipping.rates",
    "shipping.update",
    "order.create_confirmed",
    "order.cancel",
    "order.refund",
    "agent.handoff"
  ],
  "allowedSkills": [
    "customer-context-summary",
    "order-support",
    "handoff-to-human"
  ],
  "channels": ["dashboard", "messenger"],
  "humanApproval": {
    "mode": "ON_WRITE",
    "requiredTools": ["order.confirm", "order.cancel", "order.refund", "shipping.update"],
    "approvalCode": true,
    "merchantChannels": ["DASHBOARD"]
  },
  "budget": {
    "dailyUsd": 2,
    "maxToolCallsPerRun": 5
  }
}
