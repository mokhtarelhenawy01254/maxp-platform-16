model UserCompany {
  id        String            @id @default(cuid())
  userId    String
  companyId String
  role      UserCompaniesRole @default(AGENT)
  roleId    String?
  isActive  Boolean           @default(true)
  isDefault Boolean           @default(false)
  joinedAt  DateTime          @default(now())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef   Role?             @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@map("user_companies")
}

model UserInvitation {
  id         String                @id @default(cuid())
  email      String
  firstName  String
  lastName   String
  role       String                @default("AGENT")
  token      String                @unique
  status     UserInvitationsStatus @default(PENDING)
  invitedBy  String
  companyId  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invitedBy])
  @@index([token])
  @@map("user_invitations")
}

model Activity {
  id          String    @id @default(cuid())
  userId      String?
  customerId  String?
  action      String
  description String
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  customer    Customer? @relation(fields: [customerId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@map("activities")
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String?
  companyId    String?
  category     String
  action       String
  description  String
  targetType   String?
  targetId     String?
  targetName   String?
  metadata     String?
  severity     String   @default("LOW")
  isSuccess    Boolean  @default(true)
  errorMessage String?
  tags         String?
  isLocked     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([category])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId])
  @@index([createdAt(sort: Desc)])
  @@index([isSuccess])
  @@index([severity])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("activity_logs")
}

model Integration {
  id          String    @id @default(cuid())
  name        String
  type        String
  platform    String
  externalId  String
  accessToken String?
  config      String
  settings    String?
  status      String    @default("ACTIVE")
  isActive    Boolean   @default(true)
  lastSyncAt  DateTime?
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, platform, externalId])
  @@map("integrations")
}

model Policy {
  id                   String    @id @default(cuid())
  companyId            String
  title                String
  content              String
  category             String    @default("general")
  tags                 String?
  order                Int       @default(0)
  isActive             Boolean   @default(true)
  version              Int       @default(1)
  effectiveAt          DateTime  @default(now())
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  embedding            String?
  embeddingGeneratedAt DateTime?
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([companyId])
  @@index([companyId, isActive, effectiveAt])
  @@index([isActive])
  @@map("policies")
}

