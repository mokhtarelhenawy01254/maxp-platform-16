// ═══════════════════════════════════════════════════════════════════════════════
// 📝 Audit Log Enums
// ═══════════════════════════════════════════════════════════════════════════════

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SETTLEMENT
  ASSIGN
  UNASSIGN
  ACTIVATE
  DEACTIVATE
  EXPORT
  IMPORT
  LOGIN
  LOGOUT
  SYNC
  REOPEN
}

enum AuditEntityType {
  LEAVE
  ADVANCE
  ADVANCE_REQUEST
  RESIGNATION
  EMPLOYEE
  DEPARTMENT
  POSITION
  SHIFT
  ATTENDANCE
  PERMISSION_REQUEST
  POLICY
  DEDUCTION
  MANUAL_DEDUCTION
  PAYROLL
  SALARY_UPDATE
  GOAL
  FEEDBACK
  CLEARANCE
  SETTLEMENT
  USER
  COMPANY
  SETTINGS
}

// ═══════════════════════════════════════════════════════════════════════════════
// 📝 Audit Log Model
// ═══════════════════════════════════════════════════════════════════════════════

model HRAuditLog {
  id         String            @id @default(cuid())
  companyId  String
  action     AuditAction
  entityType AuditEntityType
  entityId   String
  actorId    String
  actorName  String
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime          @default(now())
  actor      User              @relation(fields: [actorId], references: [id])
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entityType])
  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, entityType])
  @@index([companyId, action])
  @@index([companyId, createdAt])
  @@map("hr_audit_logs")
}


model HRSettings {
  id                            String   @id @default(cuid())
  companyId                     String   @unique
  workDays                      String   @default("[1,2,3,4,5]")
  annualLeaveDefault            Int      @default(21)
  sickLeaveDefault              Int      @default(15)
  carryOverLimit                Int      @default(5)
  maxAdvancePercentage          Float    @default(50)
  maxActiveAdvances             Int      @default(1)
  minMonthsForAdvance           Int      @default(3)
