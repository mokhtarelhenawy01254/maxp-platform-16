  merchant       Merchant?       @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([merchantId])
  @@map("warehouses")
}

model WoocommerceSettings {
  id                  String    @id @default(cuid())
  companyId           String
  storeUrl            String
  consumerKey         String
  consumerSecret      String
  syncEnabled         Boolean   @default(false)
  syncDirection       String    @default("both")
  syncInterval        Int       @default(15)
  webhookSecret       String?
  webhookEnabled      Boolean   @default(false)
  webhookOrderCreated String?
  webhookOrderUpdated String?
  statusMapping       String?
  lastSyncAt          DateTime?
  lastSyncStatus      String?   @default("never")
  lastSyncMessage     String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime @updatedAt
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("woocommerce_settings")
}

model WoocommerceSyncLog {
  id            String    @id @default(cuid())
  companyId     String
  syncType      String
  syncDirection String
  status        String
  totalItems    Int       @default(0)
  successCount  Int       @default(0)
  failedCount   Int       @default(0)
  skippedCount  Int       @default(0)
  errorMessage  String?
  errorDetails  String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  duration      Int?
  triggeredBy   String?
  metadata      String?
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([startedAt])
  @@index([status])
  @@index([syncType])
  @@map("woocommerce_sync_logs")
}

