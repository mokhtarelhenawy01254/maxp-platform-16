model FacebookAdsAiDraftRun {
  id                     String               @id @default(cuid())
  companyId              String
  userId                 String?
  idempotencyKey         String?
  inputHash              String
  promptHash             String?
  productUrl             String               @db.Text
  productSnapshot        String?              @db.Text
  adAccountId            String?
  pageId                 String?
  pixelId                String?
  requestedCampaignCount Int                  @default(3)
  budgetAmount           Float                @default(200)
  targetCountry          String               @default("EG")
  targetGenders          String?              @db.Text
  ageMin                 Int                  @default(18)
  ageMax                 Int                  @default(45)
  requestedStatus        String               @default("PAUSED")
  status                 String               @default("RUNNING")
  usedFallback           Boolean              @default(false)
  fallbackReason         String?              @db.Text
  routing                String?              @db.Text
  latencyMs              Int?
  errorMessage           String?              @db.Text
  lockExpiresAt          DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drafts                 FacebookAdsAiDraft[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
  @@index([companyId, adAccountId, createdAt])
  @@index([companyId, productUrl])
  @@index([status])
  @@index([lockExpiresAt])
  @@map("facebook_ads_ai_draft_runs")
}

model FacebookAdsAiDraft {
  id                 String                     @id @default(cuid())
  runId              String
  companyId          String
  userId             String?
  productUrl         String                     @db.Text
  productSnapshot    String?                    @db.Text
  index              Int
  angle              String
  campaignName       String
  adSetName          String
  adName             String
  primaryText        String                     @db.Text
  headline           String
  description        String?                    @db.Text
  callToAction       String                     @default("SHOP_NOW")
  budgetAmount       Float
  targetCountry      String                     @default("EG")
  targetGenders      String?                    @db.Text
  ageMin             Int                        @default(18)
  ageMax             Int                        @default(45)
  notes              String?                    @db.Text
  createFullAdData   String                     @db.Text
  status             String                     @default("DRAFT")
  usedFallback       Boolean                    @default(false)
  fallbackReason     String?                    @db.Text
  routing            String?                    @db.Text
  publishRequestId   String?
  facebookCampaignId String?
  facebookAdSetId    String?
  facebookAdId       String?
  facebookCreativeId String?
  openedAt           DateTime?
  publishedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  run                FacebookAdsAiDraftRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  publishRequest     FacebookAdsPublishRequest? @relation(fields: [publishRequestId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([companyId, createdAt])
  @@index([companyId, productUrl])
  @@index([status])
  @@index([publishRequestId])
  @@map("facebook_ads_ai_drafts")
}

model FacebookAdsPublishRequest {
  id                 String               @id @default(cuid())
  companyId          String
  userId             String?
  clientRequestId    String
  requestHash        String?
  aiDraftId          String?
  status             String               @default("IN_PROGRESS")
  requestPayload     String?              @db.Text
  responsePayload    String?              @db.Text
  errorMessage       String?              @db.Text
  step               String?
  partialSuccess     Boolean              @default(false)
  facebookCampaignId String?
  facebookAdSetId    String?
  facebookAdId       String?
  facebookCreativeId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  completedAt        DateTime?
  lockExpiresAt      DateTime?
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drafts             FacebookAdsAiDraft[]

  @@unique([companyId, clientRequestId])
  @@unique([companyId, aiDraftId])
  @@index([companyId, createdAt])
  @@index([status])
  @@index([lockExpiresAt])
  @@index([aiDraftId])
  @@map("facebook_ads_publish_requests")
}

model FacebookAdsAiChatSession {
  id        String                     @id @default(cuid())
  companyId String
  userId    String?
  title     String?
  status    String                     @default("ACTIVE")
  context   Json?
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  company   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages  FacebookAdsAiChatMessage[]

  @@index([companyId, updatedAt])
  @@index([companyId, status, updatedAt])
  @@map("facebook_ads_ai_chat_sessions")
}

model FacebookAdsAiChatMessage {
  id          String                   @id @default(cuid())
  sessionId   String
  role        String
  content     String?                  @db.Text
  toolCalls   Json?
  toolResults Json?
  createdAt   DateTime                 @default(now())
  session     FacebookAdsAiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("facebook_ads_ai_chat_messages")
}

model FacebookAdsBudgetAlertRule {
  id                String                      @id @default(cuid())
  companyId         String
  adAccountId       String?
  campaignId        String?
  scope             String                      @default("AD_ACCOUNT")
  metric            String                      @default("ACCOUNT_BALANCE")
  thresholdAmount   Float
  currency          String                      @default("EGP")
  recipientPhones   String                      @db.Text
  isEnabled         Boolean                     @default(true)
  cooldownMinutes   Int                         @default(720)
  lastState         String                      @default("OK")
  lastCheckedAt     DateTime?
  lastTriggeredAt   DateTime?
  lastObservedValue Float?
  lastObservedLabel String?
  settings          String?                     @db.Text
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  company           Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adAccount         FacebookAdAccount?          @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  campaign          FacebookCampaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  logs              FacebookAdsBudgetAlertLog[]

  @@index([companyId, isEnabled])
  @@index([adAccountId])
  @@index([campaignId])
  @@index([metric])
  @@map("facebook_ads_budget_alert_rules")
}

model FacebookAdsBudgetAlertLog {
  id                        String                      @id @default(cuid())
  ruleId                    String?
  companyId                 String
  adAccountId               String?
  campaignId                String?
  metric                    String
  thresholdAmount           Float
  observedValue             Float?
  currency                  String                      @default("EGP")
  recipientPhone            String
  whatsappNotificationLogId String?
  status                    String                      @default("PENDING")
  message                   String?                     @db.Text
  failureReason             String?                     @db.Text
  metadata                  String?                     @db.Text
  createdAt                 DateTime                    @default(now())
  company                   Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule                      FacebookAdsBudgetAlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  adAccount                 FacebookAdAccount?          @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  campaign                  FacebookCampaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([ruleId])
  @@index([companyId, createdAt])
  @@index([adAccountId])
  @@index([campaignId])
  @@index([status])
  @@map("facebook_ads_budget_alert_logs")
}

