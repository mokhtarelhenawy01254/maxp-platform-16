{
  "slug": "facebook-sales-support-agent",
  "name": "Facebook Sales Support Agent",
  "role": "FACEBOOK_SALES_SUPPORT",
  "version": "1.0.0",
  "modelPolicy": {
    "default": "gemini-2.5-flash",
    "fallback": "gemini-2.5-pro",
    "allowModelFallback": true
  },
  "instructions": {
    "agents": "AGENTS.md",
    "soul": "SOUL.md",
    "tools": "TOOLS.md",
    "persona": "PERSONA.md"
  },
  "personaMeta": {
    "language": "arabic",
    "dialect": "egyptian",
    "tone": "friendly",
    "formality": "casual"
  },
  "guardrails": {
    "requireDraftOrders": true,
    "confirmBeforePrice": true,
    "singleQuestionPerTurn": true
  },
  "allowedTools": [
    "product_search",
    "inventory_check",
    "customer_info",
    "order_lookup",
    "shipping_rates",
    "order_create_draft",
    "order_create_confirmed",
    "agent.handoff",
    "agent_handoff_to",
    "facebook_reply"
  ],
  "allowedSkills": [
    "catalog-search",
    "customer-context-summary",
    "facebook-sales-conversion",
    "order-support",
    "exchange-support",
    "handoff-to-human"
  ],
  "handoffs": [
    {
      "role": "SUPPORT",
      "description": "Transfer to support agent for complaints, refunds, or complex issues"
    },
    {
      "role": "SHIPPING",
      "description": "Transfer to shipping agent for delivery tracking and logistics"
    }
  ],
  "channels": ["facebook", "messenger"],
  "budget": {
    "dailyUsd": 2,
    "maxToolCallsPerRun": 4
  }
}
