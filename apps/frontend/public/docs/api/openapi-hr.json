{
  "openapi": "3.1.0",
  "info": {
    "title": "MaxP Platform — External HR & AI Integration API",
    "version": "2.0.0",
    "description": "Enterprise-grade Human Resources API for seamless integration with external ERP systems (Odoo, SAP), Biometric Attendance devices (ZKTeco), and Autonomous AI Agents (OpenAI, Claude, LangChain, n8n)."
  },
  "servers": [
    {
      "url": "/api/v1/external/hr",
      "description": "Production HR API Gateway"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/employees": {
      "get": {
        "summary": "List employees",
        "description": "Returns paginated list of employees with search and department filtering.\n\n**Required Scope:** `hr:employees:read` (or `hr:read`, `*`)",
        "operationId": "hr_list_employees",
        "x-required-scope": "hr:employees:read",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "departmentId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "PROBATION",
                "ON_LEAVE",
                "TERMINATED",
                "SUSPENDED",
                "RESIGNED",
                "ON_HOLD",
                "COMPLETED",
                "CANCELLED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of employees"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/employees/stats": {
      "get": {
        "summary": "Get employees overview stats",
        "description": "Returns total count, active count, on-leave count, departments count, and department breakdown.\n\n**Required Scope:** `hr:employees:read` (or `hr:read`, `*`)",
        "operationId": "hr_get_employees_stats",
        "x-required-scope": "hr:employees:read",
        "responses": {
          "200": {
            "description": "Employee telemetry stats"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/employees/organization-chart": {
      "get": {
        "summary": "Get organizational hierarchy tree",
        "description": "Returns full tree of departments, positions, and reporting manager relationships.\n\n**Required Scope:** `hr:employees:read` (or `hr:read`, `*`)",
        "operationId": "hr_get_organization_chart",
        "x-required-scope": "hr:employees:read",
        "responses": {
