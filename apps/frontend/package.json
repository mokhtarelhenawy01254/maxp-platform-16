{
  "name": "communication-platform-frontend",
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "npm run i18n:merge && npm run i18n:types && vite",
    "build": "npm run i18n:merge && npm run i18n:types && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build && node scripts/prerender-public-routes.mjs",
    "build:safe": "npm run build",
    "build:clean": "if exist dist rd /s /q dist && if exist \"node_modules/.vite\" rd /s /q \"node_modules/.vite\" && npm run build",
    "preview": "vite preview",
    "analyze": "npm run i18n:merge && vite build --mode analyze",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:build:android": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives",
    "lint:components": "node scripts/check-undeclared-components.cjs",
    "lint:oxlint": "oxlint --config .oxlintrc.json src",
    "lint:fast": "oxlint --config .oxlintrc.json src && node scripts/check-undeclared-components.cjs",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:unit": "jest --config jest.config.cjs --runInBand --testPathPattern=src/hooks/__tests__",
    "test:tasks-workspace-e2e": "node scripts/tasks-workspace-create.e2e.mjs",
    "test:tasks-production-smoke": "node scripts/tasks-production-regression.cjs",
    "test:storefront-routing": "vitest run --environment jsdom --passWithNoTests src/registry/__tests__",
    "test:sidebar-routing": "vitest run src/config/__tests__/sidebarRoutingGuard.test.ts",
    "audit:sidebar-routes": "node ../../scripts/validate-sidebar-routes.mjs",
    "test:catalog-diff-smoke": "jest --config jest.config.cjs src/pages/super-admin/__tests__/MarketplaceAppsManagement.catalogDiff.test.tsx --runInBand",
    "i18n:lint": "node ../../scripts/i18n-lint.js",
    "i18n:merge": "node ../../scripts/merge-translations.js",
    "i18n:split": "node ../../scripts/split-translations.js",
    "i18n:check": "node ../../scripts/i18n-check.js",
    "i18n:types": "node ../../scripts/generate-i18n-types.js",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "validate:themes": "tsx src/storefront/scripts/validate-themes.ts",
    "audit:storefront-centering": "tsx src/storefront/scripts/audit-storefront-centering.ts",
    "audit:storefront-centering:core": "tsx src/storefront/scripts/audit-storefront-centering.ts --core",
    "audit:storefront-themes": "tsx src/storefront/scripts/audit-storefront-themes.ts",
    "validate:blueprints": "tsx src/storefront/scripts/validate-blueprints.ts",
    "test:storefront-themes": "vitest run src/storefront/__tests__"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@cornerstonejs/core": "^2.19.16",
    "@cornerstonejs/dicom-image-loader": "^2.19.16",
    "@cornerstonejs/tools": "^2.19.16",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/model-viewer": "^4.3.1",
    "@heroicons/react": "^2.2.0",
    "@icr/polyseg-wasm": "^0.4.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/lodash": "^4.17.23",
    "@types/three": "^0.185.4",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "4.1.0",
    "dicom-parser": "^1.8.21",
    "dompurify": "^3.3.1",
    "emoji-picker-react": "^4.18.0",
    "framer-motion": "^12.34.2",
    "i18next": "^26.5.2",
    "i18next-browser-languagedetector": "^7.0.1",
    "idb-keyval": "^6.2.2",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "linkify-react": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "lodash": "^4.17.23",
    "lucide-react": "^0.312.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^12.1.5",
    "react-is": "^18.3.1",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.8.0",
    "recharts": "^3.8.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.183.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.0",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@capacitor/cli": "^8.5.1",
    "@chromatic-com/storybook": "^5.0.2",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.1",
    "@storybook/addon-docs": "^10.3.1",
    "@storybook/addon-onboarding": "^10.3.1",
    "@storybook/addon-vitest": "^10.3.1",
    "@storybook/react-vite": "^10.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.24",
    "cssnano": "^7.1.2",
    "eslint": "^8.35.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "eslint-plugin-storybook": "^10.3.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lightningcss": "^1.31.1",
    "oxlint": "^1.85.0",
    "playwright": "1.60.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "shadcn": "^4.16.0",
    "storybook": "^10.3.1",
    "tailwindcss": "^4.2.0",
    "terser": "^5.46.1",
    "ts-jest": "^29.1.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.4.11",
    "vite-plugin-compression": "^0.5.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "tesseract.js@7.0.0": true,
    "esbuild": true
  }
}
