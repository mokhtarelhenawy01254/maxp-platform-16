{
  "slug": "sales-agent",
  "name": "Sales Agent",
  "role": "SALES",
  "version": "1.0.0",
  "modelPolicy": {
    "default": "deepseek-flash",
    "fallback": "groq/openai/gpt-oss-120b"
  },
  "instructions": {
    "agents": "AGENTS.md",
    "soul": "SOUL.md",
    "tools": "TOOLS.md",
    "persona": "PERSONA.md"
  },
  "personaMeta": {
    "language": "arabic",
    "dialect": "standard",
    "tone": "professional",
    "formality": "formal"
  },
  "guardrails": {
    "requireDraftOrders": false,
    "singleQuestionPerTurn": false
  },
  "allowedTools": [
    "product.search",
    "inventory.check",
    "customer.info",
    "order.lookup",
    "order.create_draft",
    "order.create_confirmed",
    "discount.create_draft",
    "whatsapp.send",
    "agent.handoff"
  ],
  "allowedSkills": [
    "catalog-search",
    "customer-context-summary",
    "facebook-sales-conversion",
    "discount-proposal"
  ],
  "channels": [
    "dashboard",
    "whatsapp",
    "messenger"
  ],
  "humanApproval": {
    "mode": "ON_WRITE",
    "requiredTools": [
      "order.create_draft",
      "order.create_confirmed"
    ],
    "approvalCode": true,
    "merchantChannels": [
      "DASHBOARD",
      "WHATSAPP"
    ]
  },
  "budget": {
    "dailyUsd": 2,
    "maxToolCallsPerRun": 5
  }
}
