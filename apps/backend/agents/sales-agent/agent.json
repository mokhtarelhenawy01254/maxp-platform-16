{
  "slug": "sales-agent",
  "name": "Sales Agent",
  "role": "SALES",
  "version": "1.0.0",
  "modelPolicy": {
    "default": "gemini-2.5-flash",
    "fallback": "gemini-2.5-pro"
  },
  "instructions": {
    "agents": "AGENTS.md",
    "soul": "SOUL.md",
    "tools": "TOOLS.md",
    "persona": "PERSONA.md"
  },
  "personaMeta": {
    "language": "arabic",
    "dialect": "standard",
    "tone": "professional",
    "formality": "formal"
  },
  "guardrails": {
    "requireDraftOrders": false,
    "confirmBeforePrice": true,
    "singleQuestionPerTurn": false
  },
  "allowedTools": [
    "product.search",
    "inventory.check",
    "customer.info",
    "order.lookup",
    "order.create_draft",
    "order.create_confirmed",
    "discount.create_draft",
    "agent.handoff"
  ],
  "allowedSkills": [
    "catalog-search",
    "customer-context-summary",
    "facebook-sales-conversion",
    "discount-proposal"
  ],
  "channels": ["dashboard", "messenger"],
  "humanApproval": {
    "mode": "ON_WRITE",
    "requiredTools": ["order.create_draft", "order.create_confirmed"],
    "approvalCode": true,
    "merchantChannels": ["DASHBOARD"]
  },
  "budget": {
    "dailyUsd": 2,
    "maxToolCallsPerRun": 5
  }
}
