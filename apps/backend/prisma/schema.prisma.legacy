  orderInvoice            OrderInvoice?
  orderItems              OrderItem[]
  orderNotes              OrderNote[]
  supportTickets          SupportTicket[]
  orderAssignments        OrderAssignment[]
  affiliate               Affiliate?                 @relation(fields: [affiliateId], references: [id])
  company                 Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation            Conversation?              @relation(fields: [conversationId], references: [id])
  createdByUser           User?                      @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  customer                Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userRel                 User?                      @relation(fields: [userRelId], references: [id])
  returnRequests          ReturnRequest[]
  walletTransactions      WalletTransaction[]
  notificationLogs        WhatsAppNotificationLog[]
  customerJourneys        CustomerJourney[]

  @@unique([companyId, orderNumber])
  @@index([affiliateId])
  @@index([companyId])
  @@index([companyId, status, createdAt])
  @@index([companyId, sourceType, createdAt])
  @@index([companyId, confirmationNotifiedAt])
  @@index([conversationId])
  @@index([confirmedAt])
  @@index([confirmationNotifiedAt])
  @@index([createdBy])
  @@index([customerId])
  @@index([assignedTo])
  @@index([isScheduled])
  @@index([orderSource])
  @@index([scheduledDeliveryDate])
