  attendanceAutoCloseAudits                         AttendanceAutoCloseAudit[] @relation("AttendanceAutoCloseEmployee")
  reviewedAttendanceAutoCloseAudits                 AttendanceAutoCloseAudit[] @relation("AttendanceAutoCloseReviewer")
  advanceRequests                                   AdvanceRequest[]
  hrAuditLogs                                       HRAuditLog[]
  clearanceChecklists                               ClearanceChecklist[]
  employees                                         Employee?
  kudos_from                                        Kudos[]                    @relation("hr_kudos_fromUserIdTousers")
  kudos_to                                          Kudos[]                    @relation("hr_kudos_toUserIdTousers")
  rewardEligibilityLogs                             RewardEligibilityLog[]
  rewardRecords                                     RewardRecord[]
  shiftAssignments                                  ShiftAssignment[]
  imageGalleries                                    ImageGallery[]
  imageStudioHistories                              ImageStudioHistory[]
  latenessAllowances                                LatenessAllowance[]
  latenessDeductions                                LatenessDeduction[]        @relation("LatenessDeductionUser")
  latenessMonthlySummaries                          LatenessMonthlySummary[]   @relation("LatenessMonthlySummaryUser")
  latenessRecords                                   LatenessRecord[]           @relation("LatenessRecordUser")
  messages                                          Message[]
  notifications                                     Notification[]
  notificationPreferences                           NotificationPreference[]
  browserPushSubscriptions                          BrowserPushSubscription[]
  orderNotes                                        OrderNote[]
  orders                                            Order[]                    @relation("OrderCreatedBy")
  Order                                             Order[]
  requestedChangeRequests                           OrderStatusChangeRequest[] @relation("RequestedBy")
  reviewedChangeRequests                            OrderStatusChangeRequest[] @relation("ReviewedBy")
  workflowAuditChanges                              OrderWorkflowAuditLog[]    @relation("AuditChangedBy")
  workflowAuditApprovals                            OrderWorkflowAuditLog[]    @relation("AuditApprovedBy")
  returnActivityLogs                                ReturnActivityLog[]
  returnContactAttempts                             ReturnContactAttempt[]
  returnRequests                                    ReturnRequest[]
  taskActivities                                    TaskActivity[]
  taskAttachments                                   TaskAttachment[]
  taskChecklistItems                                TaskChecklistItem[]
  taskComments                                      TaskComment[]
  taskNotifications                                 TaskNotification[]
  taskTemplates                                     TaskTemplate[]
  taskWatchers                                      TaskWatcher[]
  textGalleries                                     TextGallery[]
  userCompanies                                     UserCompany[]
  userInvitations                                   UserInvitation[]
  company                                           Company?                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentRelation                                Department?                @relation(fields: [departmentId], references: [id])
  positionRelation                                  Position?                  @relation(fields: [positionId], references: [id])
  whatsAppMessages                                  WhatsAppMessage[]
  platformPartner                                   PlatformPartner?

  // WhatsApp Inbox CRM Relations
  moderatorTeamMemberships   ModeratorTeamMember[]
  assignedWhatsAppSessions   WhatsAppNumberAssignment[]
  assignedByWhatsAppSessions WhatsAppNumberAssignment[]  @relation("NumberAssignmentBy")
  conversationModeratorNotes ConversationModeratorNote[]
  conversationTagsCreated    ConversationTag[]
  moderatorActivityLogs      ModeratorActivityLog[]
  moderatorNotifications     ModeratorNotification[]
  moderatorDashboardCaches   ModeratorDashboardCache[]

  @@index([companyId])
  @@index([departmentId])
  @@index([positionId])
  @@map("users")
}

model UserCompany {
  id        String            @id @default(cuid())
  userId    String
  companyId String
  role      UserCompaniesRole @default(AGENT)
  isActive  Boolean           @default(true)
  isDefault Boolean           @default(false)
  joinedAt  DateTime          @default(now())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@map("user_companies")
}

model UserInvitation {
  id         String                @id @default(cuid())
  email      String
  firstName  String
  lastName   String
  role       String                @default("AGENT")
  token      String                @unique
  status     UserInvitationsStatus @default(PENDING)
  invitedBy  String
  companyId  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invitedBy])
  @@index([token])
  @@map("user_invitations")
}

model Activity {
  id          String    @id @default(cuid())
  userId      String?
  customerId  String?
  action      String
  description String
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  customer    Customer? @relation(fields: [customerId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@map("activities")
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String?
  companyId    String?
  category     String
  action       String
  description  String
  targetType   String?
  targetId     String?
  targetName   String?
  metadata     String?
  severity     String   @default("LOW")
  isSuccess    Boolean  @default(true)
  errorMessage String?
  tags         String?
  isLocked     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([category])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId])
  @@index([createdAt(sort: Desc)])
  @@index([isSuccess])
  @@index([severity])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("activity_logs")
}

model Integration {
  id          String    @id @default(cuid())
  name        String
  type        String
  platform    String
  externalId  String
  accessToken String?
  config      String
  settings    String?
  status      String    @default("ACTIVE")
  isActive    Boolean   @default(true)
  lastSyncAt  DateTime?
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, platform, externalId])
  @@map("integrations")
}

model Policy {
  id                   String    @id @default(cuid())
  companyId            String
  title                String
  content              String
  category             String    @default("general")
  tags                 String?
  order                Int       @default(0)
  isActive             Boolean   @default(true)
  version              Int       @default(1)
  effectiveAt          DateTime  @default(now())
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  embedding            String?
  embeddingGeneratedAt DateTime?
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([companyId])
  @@index([companyId, isActive, effectiveAt])
  @@index([isActive])
  @@map("policies")
}

// --- From: easy_orders.prisma ---
model EasyOrdersSettings {
  id              String    @id @default(cuid())
  companyId       String    @unique
  apiKey          String
  syncEnabled     Boolean   @default(false)
  syncInterval    Int       @default(15)
  statusMapping   String? // JSON mapping of Easy Order status names to local status codes
  lastSyncAt      DateTime?
  lastSyncStatus  String?   @default("never")
  lastSyncMessage String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("easy_orders_settings")
}

model EasyOrdersSyncLog {
  id           String    @id @default(cuid())
  companyId    String
  syncType     String    @default("orders")
  status       String
  totalItems   Int       @default(0)
  successCount Int       @default(0)
  failedCount  Int       @default(0)
  skippedCount Int       @default(0)
  errorMessage String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  duration     Int?
  triggeredBy  String?
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([startedAt])
  @@map("easy_orders_sync_logs")
}

