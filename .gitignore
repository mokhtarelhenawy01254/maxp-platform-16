# ============================================================
# Monorepo paths (apps/*) - added 2026-06-05
# The legacy .gitignore rules above target the old `backend/`
# and `frontend/` directories. After the monorepo migration,
# code lives under `apps/backend/` and `apps/frontend/`, so we
# duplicate the build/runtime patterns with the new prefix.
# ============================================================

# Build artifacts (Prisma generated, legacy_mysql, generated)
apps/backend/prisma/generated/
apps/backend/legacy_mysql/generated/
apps/backend/generated/

# Runtime / uploaded data (NOT in tarball, server has its own)
apps/backend/uploads/
apps/backend/public/
apps/backend/.prisma-generated
apps/backend/.restart_trigger

# Test scratch files (debug/find/test/temp patterns in apps/)
apps/backend/_test_*.js
apps/backend/scratch/
apps/backend/scratch/**

# Local env files with secrets (templates like .env.example
# are tracked, so we use a negative-lookahead pattern)
apps/backend/.env
apps/backend/.env.*
apps/frontend/.env
apps/frontend/.env.*
apps/ai-service/.env*
# Allow templates to be committed
!apps/backend/.env.example
!apps/backend/.env.postgres.example
!apps/frontend/.env.example

# Local AI tool / IDE config
.claude/
.kilo/

# OpenCode secrets (stored in home dir, but just in case)
.opencode/secrets.json

