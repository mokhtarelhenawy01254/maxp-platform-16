  @@map("billing_history")
}

// --- From: competitors_ads.prisma ---
model CompetitorAdCampaign {
  id             String    @id @default(cuid())
  campaignId     String?
  platform       String    @default("facebook")
  campaignName   String?
  objective      String?
  status         String?
  startedAt      DateTime?
  stoppedAt      DateTime?
  budget         Decimal?  @db.Decimal(12, 2)
  budgetCurrency String?   @default("USD")
  spend          Decimal?  @db.Decimal(12, 2)
  impressions    Int?
  clicks         Int?
  conversions    Int?
  reach          Int?
  frequency      Decimal?  @db.Decimal(5, 2)
  ctr            Decimal?  @db.Decimal(5, 3)
  cpc            Decimal?  @db.Decimal(10, 2)
  cpm            Decimal?  @db.Decimal(10, 2)
  roas           Decimal?  @db.Decimal(5, 2)
  lastUpdated    DateTime  @default(now())
  metadata       Json?
  competitorId   String
  companyId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  competitor  Competitor             @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  adCreatives CompetitorAdCreative[]

  @@unique([competitorId, platform, campaignId])
  @@index([competitorId])
  @@index([companyId])
  @@index([competitorId, platform])
  @@map("competitor_ad_campaigns")
}

model CompetitorAdCreative {
  id             String   @id @default(cuid())
  adId           String?
  platform       String   @default("facebook")
  adType         String?
  status         String?
  headline       String?
  primaryText    String?  @db.Text
