
model QueueMetric {
  id        String   @id @default(cuid())
  active    Int      @default(0)
  waiting   Int      @default(0)
  completed Int      @default(0)
  failed    Int      @default(0)
  delayed   Int      @default(0)
  paused    Int      @default(0)
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@map("queue_metrics")
}
