{
  "name": "maxp-desktop-monitor",
  "version": "1.0.0",
  "description": "MaxP Employee Monitor — Desktop activity tracking agent",
  "main": "dist/main/main/main.js",
  "author": "MaxP",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron dist/main/main/main.js",
    "pack": "electron-builder --dir",
    "build:installer": "electron-builder --win nsis",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "active-win": "^9.0.0",
    "electron-updater": "^6.3.9",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "lucide-react": "^0.460.0"
  },
  "build": {
    "appId": "online.maxp.workspace",
    "productName": "MaxP Workspace",
    "icon": "assets/icon.ico",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "asarUnpack": [
      "bin/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "elhenawym124-ops",
      "repo": "maxp-platform-10"
    },
    "win": {
      "target": ["nsis", "dir"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MaxP Workspace",
      "artifactName": "MaxP-Workspace-Setup.${ext}",
      "runAfterFinish": true
    }
  }
}
