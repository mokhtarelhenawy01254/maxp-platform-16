}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([customerId])
  @@map("customer_notes")
}

model ProductReview {
  id            String   @id @default(cuid())
  productId     String
  companyId     String
  customerName  String
  customerEmail String?
  customerPhone String?
  rating        Int
  title         String?
  comment       String?
  isVerified    Boolean  @default(false)
  isApproved    Boolean  @default(false)
  helpfulCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  media         ProductReviewMedia[]
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isApproved])
  @@index([productId])
  @@index([rating])
  @@map("product_reviews")
}

model ProductReviewMedia {
  id          String        @id @default(cuid())
  reviewId    String        @map("review_id")
  companyId   String        @map("company_id")
  mediaType   String        @map("media_type")
  fileUrl     String        @map("file_url")
  posterUrl   String?       @map("poster_url")
  altText     String?       @map("alt_text")
  fileName    String?       @map("file_name")
  mimeType    String?       @map("mime_type")
  fileSize    Int?          @map("file_size")
  createdAt   DateTime      @default(now()) @map("created_at")
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  review      ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([reviewId])
  @@map("product_review_media")
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  name           String
  type           String      @default("color")
  sku            String?
  price          Decimal?    @db.Decimal(10, 2)
  comparePrice   Decimal?    @db.Decimal(10, 2)
  cost           Decimal?    @db.Decimal(10, 2)
  images         String?
  stock          Int         @default(0)
  trackInventory Boolean     @default(true)
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  metadata       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime @updatedAt
  orderItems     OrderItem[]
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  wholesalePriceListItems WholesalePriceListItem[]

  @@unique([productId, sku])
  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model ProductPresentation {
  id             String    @id @default(cuid())
  productId      String
  name           String
  slug           String
  images         String?
  mainImage      String?
  title          String?
  description    String?
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  metadata       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, slug])
  @@index([productId])
  @@index([slug])
  @@map("product_presentations")
}

model Product {
  id                         String                    @id @default(cuid())
  name                       String
  description                String?
  sku                        String?
  price                      Decimal                   @db.Decimal(10, 2)
  comparePrice               Decimal?                  @db.Decimal(10, 2)
  cost                       Decimal?                  @db.Decimal(10, 2)
  images                     String?
  mainImage                  String?
  stock                      Int                       @default(0)
  trackInventory             Boolean                   @default(true)
  weight                     Decimal?                  @db.Decimal(8, 2)
  dimensions                 String?
  categoryId                 String?
  isActive                   Boolean                   @default(true)
  isFeatured                 Boolean                   @default(false)
  isHidden                   Boolean                   @default(false)
  tags                       String?
  metadata                   String?
  companyId                  String
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  deletedAt                  DateTime?
  barcode                    String?
  easyOrdersId               String?
  easyOrdersUrl              String?
  source                     String?                   @default("manual")
  externalId                 String?
  wooCommerceId              String?
  wooCommerceUrl             String?
  hasPromotedAd              Boolean                   @default(false)
  enableCheckoutForm         Boolean                   @default(true)
  showAddToCartButton        Boolean                   @default(true)
  saleStartDate              DateTime?
  saleEndDate                DateTime?
  sizeGuide                  String?
  isPreOrder                 Boolean                   @default(false)
  preOrderDate               DateTime?
  preOrderMessage            String?
   embedding                  String?
   embeddingGeneratedAt       DateTime?
   embeddingImage             String?
   embeddingImageGeneratedAt  DateTime?
   slug                       String?
  isDropshipped              Boolean                   @default(false)
  merchantProductId          String?
  basePrice                  Decimal?                  @db.Decimal(10, 2)
  allowAffiliateMarkup       Boolean                   @default(false)
  affiliateVisibility        String                    @default("ALL")
  affiliateVisibleAffiliateIds String?
  affiliateCommission        Decimal?                  @db.Decimal(10, 2)
  commissionType             String?                   @default("PERCENTAGE")
  affiliate_products         AffiliateProduct[]
  backInStockNotifications   BackInStockNotification[]
  conversion_events          ConversionEvent[]
  facebookCatalogProducts    FacebookCatalogProduct[]  @relation("FacebookCatalogProduct")
  facebookPosts              FacebookPost[]  @relation("FacebookPostProduct")
  inventories                Inventory[]
  merchantProducts           MerchantProduct[]
  orderItems                 OrderItem[]
  postResponseSettings       PostResponseSettings[]
  productAnalytics           ProductAnalytic[]
  productLandingPages        ProductLandingPage[]
  productPresentations       ProductPresentation[]
  productReviews             ProductReview[]
  productVariants            ProductVariant[]
  productVisits              ProductVisit[]
  category                   Category?                 @relation(fields: [categoryId], references: [id])
  company                    Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseInvoiceItems       PurchaseInvoiceItem[]
  purchaseOrderItems         PurchaseOrderItem[]
  recentlyVieweds            RecentlyViewed[]
  stockAlerts                StockAlert[]
  stockMovements             StockMovement[]
  whatsapp_notification_logs WhatsAppNotificationLog[]
  wholesalePriceListItems    WholesalePriceListItem[]
  wishlists                  Wishlist[]
  overlayCampaignProducts    OverlayCampaignProduct[]
  recipes                    Recipe[]
  rawIngredients             RecipeIngredient[]        @relation("RawProductIngredient")
  stockAuditItems            StockAuditItem[]
  rawModifierOptions         ProductModifierOption[]   @relation("RawProductModifierOption")
  operationalWasteLogs       OperationalWasteLog[]

  showFakeStock              Boolean                   @default(false)
  
  @@unique([companyId, sku])
  @@unique([companyId, slug])
  @@index([categoryId])
  @@index([companyId])
  @@index([sku])
  @@index([wooCommerceId])
  @@index([externalId])
  @@map("products")
}

model Wishlist {
  id         String   @id @default(cuid())
  sessionId  String
  customerId String?
  productId  String
  variantId  String?
  companyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId, variantId, companyId])
  @@index([companyId])
  @@index([customerId])
  @@index([productId])
  @@index([sessionId])
  @@map("wishlists")
}

model CustomerWallet {
  id           String              @id @default(cuid())
  customerId   String              @unique
  companyId    String
  balance      Float               @default(0)
  totalEarned  Float               @default(0)
  totalSpent   Float               @default(0)
  currency     String              @default("EGP")
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id])
  transactions WalletTransaction[]

  @@index([companyId])
  @@map("customer_wallets")
}

model CustomerLoyaltyProgram {
  id                      String                        @id @default(cuid())
  companyId               String
  name                    String
  nameAr                  String?
  description             String?
  type                    CustomerLoyaltyProgramType    @default(POINTS)
  status                  CustomerLoyaltyProgramsStatus @default(DRAFT)
  pointsPerPurchase       Decimal                       @default(1.00) @db.Decimal(10, 2)
  pointsPerReferral       Decimal                       @default(10.00) @db.Decimal(10, 2)
  pointsPerAmount         Decimal?                      @db.Decimal(10, 2)
  redemptionRate          Decimal                       @default(100.00) @db.Decimal(10, 2)
  minimumPoints           Decimal                       @default(100.00) @db.Decimal(10, 2)
  maxPointsPerTransaction Decimal?                      @db.Decimal(10, 2)
  expiryMonths            Int                           @default(12)
  defaultTierMethod       String                        @default("POINTS")
  rules                   String?
  createdBy               String
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  company                 Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerLoyaltyRecords  CustomerLoyaltyRecord[]
  customerLoyaltyTiers    CustomerLoyaltyTier[]

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@map("customer_loyalty_programs")
}

model CustomerLoyaltyRecord {
  id                     String                       @id @default(cuid())
  companyId              String
  customerId             String
  programId              String
  tierId                 String?
  currentPoints          Decimal                      @default(0.00) @db.Decimal(10, 2)
  totalEarned            Decimal                      @default(0.00) @db.Decimal(10, 2)
  totalRedeemed          Decimal                      @default(0.00) @db.Decimal(10, 2)
  status                 CustomerLoyaltyRecordsStatus @default(ACTIVE)
  joinDate               DateTime                     @default(now())
  lastActivity           DateTime                     @default(now())
  lastPointsEarned       DateTime?
  lastPointsRedeemed     DateTime?
  metadata               String?
  pendingPoints          Decimal                      @default(0.00) @db.Decimal(10, 2)
  pendingCashback        Decimal                      @default(0.00) @db.Decimal(10, 2)
  releasedAt             DateTime?
  cancelledAt            DateTime?
  lastCheckInAt          DateTime?
  checkInStreak          Int                          @default(0)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  company                Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer               Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerLoyaltyProgram CustomerLoyaltyProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  customerLoyaltyTier    CustomerLoyaltyTier?         @relation(fields: [tierId], references: [id])

  @@unique([customerId, programId])
  @@index([companyId])
  @@index([customerId])
  @@index([lastActivity])
  @@index([programId])
  @@index([status])
  @@index([tierId])
  @@index([releasedAt])
  @@index([cancelledAt])
  @@index([lastCheckInAt])
  @@map("customer_loyalty_records")
}

model CustomerLoyaltyTier {
  id                     String                  @id @default(cuid())
  companyId              String
  programId              String
  name                   String
  nameAr                 String?
  calculationType        String                  @default("POINTS")
  minPoints              Decimal?                @db.Decimal(10, 2)
  maxPoints              Decimal?                @db.Decimal(10, 2)
  minSpent               Decimal?                @db.Decimal(10, 2)
  maxSpent               Decimal?                @db.Decimal(10, 2)
  minItems               Int?
  maxItems               Int?
  benefits               String?
  color                  String                  @default("#6366f1")
  icon                   String                  @default("crown")
  priority               Int                     @default(1)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  customerLoyaltyRecords CustomerLoyaltyRecord[]
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerLoyaltyProgram CustomerLoyaltyProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([minPoints])
  @@index([programId])
  @@map("customer_loyalty_tiers")
}

/// كوبون الخصم التلقائي (نظام "الخصم التلقائي"): يصدر بعد كل أوردر مسلّم،
/// صالح لمدة محددة، وعند انتهائه يتحول لكاش باك في المحفظة.
model CustomerLoyaltyVoucher {
  id                    String    @id @default(cuid())
  companyId             String
  customerId            String
  sourceOrderId         String
  orderNumber           String
  percent               Decimal   @default(10.00) @db.Decimal(5, 2)
  amount                Decimal   @default(0.00) @db.Decimal(10, 2)
  status                String    @default("ACTIVE") // ACTIVE | USED | EXPIRED | CONVERTED | CANCELLED
  expiresAt             DateTime
  usedAt                DateTime?
  convertedAt           DateTime?
  convertedWalletTxId   String?
  lastExpiryWarnedAt    DateTime?
  metadata              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
  @@map("customer_loyalty_vouchers")
}

model CustomerNotificationPreference {
  id            String    @id @default(cuid())
  companyId     String
  customerId    String    @unique
  phone         String
  orderUpdates  Boolean   @default(true)
  promotions    Boolean   @default(false)
  backInStock   Boolean   @default(true)
  priceDrops    Boolean   @default(true)
  abandonedCart Boolean   @default(true)
  isOptedIn     Boolean   @default(true)
  optedInAt     DateTime  @default(now())
  optedOutAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([companyId, customerId])
  @@unique([companyId, phone])
  @@map("customer_notification_preferences")
}

model MerchantOrder {
  id              String               @id @default(cuid())
  merchantId      String
  orderId         String
  merchantOrderId String?
  status          MerchantOrdersStatus @default(PENDING)
  items           String
  totalAmount     Decimal              @db.Decimal(10, 2)
  shippingAddress String?
  trackingNumber  String?
  fulfillmentSource String            @default("MERCHANT")
  warehouseId       String?
  shippingCompanyId String?
  syncedAt        DateTime?
  fulfilledAt     DateTime?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  merchant        Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipments       Shipment[]

  @@unique([merchantId, orderId])
  @@index([merchantId])
  @@index([orderId])
  @@index([status])
  @@index([fulfillmentSource])
  @@index([warehouseId])
  @@index([shippingCompanyId])
  @@map("merchant_orders")
}

model MerchantProduct {
  id            String    @id @default(cuid())
  merchantId    String
  productId     String
  merchantSku   String?
  merchantPrice Decimal   @db.Decimal(10, 2)
  stock         Int       @default(0)
  isActive      Boolean   @default(true)
  syncEnabled   Boolean   @default(true)
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([merchantId, productId])
  @@index([merchantId])
  @@index([productId])
  @@map("merchant_products")
}

model Merchant {
  id               String            @id @default(cuid())
  companyId        String
  name             String
  email            String            @unique
  phone            String?
  address          String?
  isActive         Boolean           @default(true)
  commissionRate   Float             @default(10)
  autoFulfill      Boolean           @default(false)
  fulfillmentMode  String            @default("MERCHANT")
  defaultWarehouseId String?
  defaultShippingCompanyId String?
  apiKey           String?           @unique
  webhookUrl       String?
  settings         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  commissions      Commission[]
  merchant_payouts MerchantPayout[]
  merchantOrders   MerchantOrder[]
  merchantProducts MerchantProduct[]
  shipments        Shipment[]
  warehouses       Warehouse[]

  @@index([companyId])
  @@index([isActive])
  @@index([fulfillmentMode])
  @@index([defaultWarehouseId])
  @@index([defaultShippingCompanyId])
}

model Shipment {
  id                     String           @id @default(cuid())
  companyId              String
  orderId                String?
  merchantOrderId        String?          @unique
  merchantId             String?
  fulfillmentSource      String           @default("MERCHANT")
  warehouseId            String?
  shippingCompanyId      String?
  carrierType            String           @default("MANUAL")
  status                 String           @default("PENDING")
  trackingNumber         String?
  externalShipmentId     String?
  labelUrl               String?
  serviceLevel           String?
  cost                   Decimal?         @db.Decimal(10, 2)
  currency               String           @default("EGP")
  settlementStatus       String?          @default("PENDING")
  settledAt              DateTime?
  settledBy              String?
  destinationGovernorate String?
  destinationCity        String?
  destinationAddress     String?
  metadata               String?
  courierId              String?
  deliveryRunId          String?
  collectedAmount        Decimal?         @db.Decimal(10, 2)
  collectedAt            DateTime?
  deliveryNotes          String?
  /// Fleet OTP delivery proof: bcrypt hash of the 4-digit code texted to the customer
  /// on dispatch — required on field DELIVERED when fieldWorkflow.requireDeliveryOtp is on
  otpHash                String?
  otpExpiresAt           DateTime?
  /// Wrong-code attempts against the delivery OTP — locked after 5, reset on resend/success
  otpAttempts            Int             @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order                  Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchantOrder          MerchantOrder?   @relation(fields: [merchantOrderId], references: [id], onDelete: Cascade)
  merchant               Merchant?        @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  warehouse              Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  shippingCompany        ShippingCompany? @relation(fields: [shippingCompanyId], references: [id], onDelete: SetNull)
  courier                Courier?         @relation(fields: [courierId], references: [id], onDelete: SetNull)
  deliveryRun            DeliveryRun?     @relation(fields: [deliveryRunId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([orderId])
  @@index([merchantId])
  @@index([fulfillmentSource])
  @@index([warehouseId])
  @@index([shippingCompanyId])
  @@index([courierId])
  @@index([deliveryRunId])
  @@index([status])
  @@map("shipments")
}

model ProductVisit {
  id          String   @id @default(cuid())
  productId   String
  companyId   String
  sessionId   String
  visitedAt   DateTime @default(now())
  duration    Int?
  source      String?
  addedToCart Boolean  @default(false)
  purchased   Boolean  @default(false)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, visitedAt])
  @@index([sessionId, companyId])
  @@map("product_visits")
}

/// UNUSED - Planned feature for return management
model ReturnReasonCategory {
  id            String                            @id @default(cuid())
  name          String
  defaultRole   ReturnReasonCategoriesDefaultRole @default(OTHER)
  isActive      Boolean                           @default(true)
  createdAt     DateTime                          @default(now())
  updatedAt     DateTime                          @updatedAt
  companyId     String
  company       Company                           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  returnReasons ReturnReason[]

  @@index([companyId])
  @@map("return_reason_categories")
}

model ShippingMethod {
  id           String       @id @default(cuid())
  zoneId       String
  type         String       @default("flat_rate")
  title        String
  isEnabled    Boolean      @default(true)
  settings     String?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  shippingZone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([isEnabled])
  @@index([zoneId])
  @@map("shipping_methods")
}

/// رابط سري لمرة واحدة لفتح بوابة العميل (زر "صفحة العميل" في رسائل واتساب).
/// بيتولّد وقت الإرسال، وبيسمح للعميل يدخل صفحته من غير ما يكتب رقم الموبايل.
model CustomerMagicLink {
  id         String    @id @default(cuid())
  companyId  String
  customerId String
  phone      String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([companyId, customerId])
  @@map("customer_magic_links")
}

model LoyaltyActivity {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  type        String   // REVIEW_WITH_PHOTO | PROFILE_COMPLETE | DAILY_CHECKIN | REFERRAL_GRANT | ORDER_POINTS
  points      Decimal  @default(0.00) @db.Decimal(10, 2)
  status      String   @default("PENDING") // PENDING | APPROVED | CANCELLED
  referenceId String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([customerId])
  @@index([type])
  @@index([status])
  @@map("loyalty_activities")
}
