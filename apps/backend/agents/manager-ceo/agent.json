    "product_low_stock",
    "product_top_selling",
    "order_summary",
    "order_lookup",
    "order_recent_list",
    "order_create_draft",
    "order_create_confirmed",
    "order_cancel",
    "order_refund",
    "customer_info",
    "customer_top_buyers",
    "inventory_check",
    "sales_revenue",
    "company_snapshot",
    "shipping_rates",
    "shipping_update",
    "discount_create",
    "discount_create_draft",
    "product_update_price",
    "audit_read",
    "scheduler_create_job"
