model FollowUp {
  id                  String    @id @default(cuid())
  company_id          String    @unique
  company             Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  status              String    @default("unassigned")
  assigned_owner_id   String?
  assigned_owner_name String?
  assigned_owner_email String?
  assigned_owner_role String?
  last_note           String?
  updated_at          DateTime?
  contacted_at        DateTime?
  resolved_at         DateTime?
  next_action_at      DateTime?
  last_reminder_sent_at DateTime?
  last_escalated_at   DateTime?
  created_at          DateTime  @default(now())

  history FollowUpHistory[]

  @@map("company_follow_ups")
}

model FollowUpHistory {
  id                  String    @id @default(cuid())
  follow_up_id        String
  follow_up           FollowUp  @relation(fields: [follow_up_id], references: [id], onDelete: Cascade)
  occurred_at         DateTime
  status              String
  note                String?
  action              String    @default("updated")
  next_action_at      DateTime?
  actor_id            String?
  actor_name          String?
  actor_email         String?
  actor_role          String?
  assigned_owner_id   String?
  assigned_owner_name String?
  assigned_owner_email String?
  assigned_owner_role String?
  created_at          DateTime  @default(now())

  @@index([follow_up_id])
  @@map("follow_up_history")
}
