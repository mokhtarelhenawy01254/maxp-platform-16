      "badgeRadius": "999px",
      "buttonRadius": "0.25rem",
      "surfaceOpacity": "1"
    },
    "layout": {
      "contentAlign": "start"
    }
  },
  "seo": {
    "titleTemplate": "%s | defalut-theme-old",
    "description": "Watch-led legacy storefront with local photo sets, direct category routing, and a clean left-to-right retail rhythm."
  },
