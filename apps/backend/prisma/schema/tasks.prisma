/// UNUSED - Planned feature for dev task checklists
model DevTaskChecklist {
  id                    String                 @id @default(cuid())
  taskId                String
  title                 String
  position              Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
