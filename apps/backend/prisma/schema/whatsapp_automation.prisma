model LeadCategory {
  id                    String        @id @default(cuid())
  companyId             String
  name                  String
  color                 String?       @default("#6366f1")
  isDefault             Boolean       @default(false)
  sortOrder             Int           @default(0)
  autoFollowUp          Boolean       @default(true)
  autoPromoteCategoryId String?
  triggerFlowId         String?                           // NEW: ربط التصنيف بـ Flow رسائل
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts              WhatsAppContact[]
  autoPromoteCategory   LeadCategory?  @relation("CategoryPromotion", fields: [autoPromoteCategoryId], references: [id])
  promotedFrom          LeadCategory[] @relation("CategoryPromotion")
  triggerFlow           WhatsAppFollowUpFlow? @relation(fields: [triggerFlowId], references: [id]) // NEW

  @@unique([companyId, name])
  @@index([companyId])
  @@map("lead_categories")
}

model WhatsAppFollowUpFlow {
  id          String                 @id @default(cuid())
  companyId   String
  name        String
  isEnabled   Boolean                @default(true)
  isGeneral   Boolean                @default(false)  // عام: يشتغل لكل العملاء ما لم يخصص لهم تدفق خاص
  channels    String?                @db.Text // JSON array: ["WHATSAPP","FACEBOOK"] — القنوات المدعومة
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps       WhatsAppFollowUpStep[]
  journeys    CustomerJourney[]
  categories  LeadCategory[]         // التصنيفات اللي بتشغل الـ Flow ده

  @@map("whatsapp_follow_up_flows")
}

model WhatsAppFollowUpStep {
  id                String               @id @default(cuid())
  flowId            String
  delayDays         Int                  @default(1)
  delayHours        Int?                                       // NEW: تأخير بالساعات (لـ category flows)
  delayUnit         String               @default("DAYS")      // NEW: "HOURS" | "DAYS"
  content           String               @db.Text
  mediaUrl          String?
  buttons           String?              @db.Text // JSON array: [{title, payload}] — أزرار/quick replies
  stepOrder         Int                  @default(1)
  expectReply       Boolean              @default(false)       // الخطوة بتستنى رد العميل
  replyKeywords     String?              @db.Text              // JSON array — كلمات الفرع
  nextStepId        String?                                     // الخطوة اللي نروح لها لو رد بمطابقة
  timeoutHours      Int?                                       // لو مع ردش خلال المدة
  timeoutNextStepId String?                                     // الخطوة اللي نروح لها بعد المهلة
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  flow              WhatsAppFollowUpFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@map("whatsapp_follow_up_steps")
}

model LeadFollowUpSettings {
  id               String    @id @default(cuid())
  companyId        String    @unique
  isEnabled        Boolean   @default(false)
  delayHours       Int       @default(24)
  message          String    @db.Text
  mediaUrl         String?
  steps            String?   @db.Text  // JSON array of { delayHours, message, mediaUrl }
  businessHourStart Int?              // 0-23
  businessHourEnd   Int?              // 0-23
  timezone         String?            // IANA timezone, default 'UTC'
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("lead_follow_up_settings")
}

model LeadFollowUpEnrollment {
  id                String          @id @default(cuid())
  companyId         String
  customerId        String
  whatsappContactId String
  status            String          @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  nextSendAt        DateTime
  lastSentAt        DateTime?
  firstMessageAt    DateTime        @default(now())
  repliedAt         DateTime?
  currentStep       Int             @default(0)
  logs              String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  whatsAppContact   WhatsAppContact @relation(fields: [whatsappContactId], references: [id], onDelete: Cascade)

  @@index([companyId, status, nextSendAt])
  @@index([customerId])
  @@index([whatsappContactId])
  @@map("lead_follow_up_enrollments")
}

model CustomerJourney {
  id                String               @id @default(cuid())
  companyId         String
  customerId        String
  orderId           String?
  flowId            String
  currentStep       Int                  @default(0) // 0 means not started, 1 means step 1 sent, etc.
  status            String               @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  interactiveState  String?              @db.Text // JSON: {waitingForStepId, channel, startedAt}
  nextSendAt        DateTime
  lastSentAt        DateTime?
  logs              String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order             Order?               @relation(fields: [orderId], references: [id])
  flow              WhatsAppFollowUpFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([companyId, status, nextSendAt])
  @@index([customerId])
  @@map("customer_journeys")
}

model WhatsAppScheduledReport {
  id              String    @id @default(cuid())
  companyId       String
  name            String    @default("تقرير العمليات والمبيعات")
  isEnabled       Boolean   @default(false)
  reportType      String    @default("DAILY_EOD") // DAILY_EOD | WEEKLY_DIGEST | MORNING_BRIEF
  frequency       String    @default("DAILY")     // DAILY | WEEKLY
  sendTime        String    @default("21:00")     // "HH:mm" in company timezone
  daysOfWeek      String?   @default("ALL")       // "ALL" or comma-separated "0,1,2,3,4,5,6"
  recipients      String    @db.Text              // comma-separated phone numbers: "2010xxxx,2012xxxx"
  includeSales    Boolean   @default(true)        // Revenue, order count, AOV, payment methods
  includeOps      Boolean   @default(true)        // Confirmed, preparing, shipped, delivered, canceled
  includeStock    Boolean   @default(true)        // Low stock alerts (< 5 items)
  includeTopItems Boolean   @default(true)        // Top 3 best selling items today
  sessionId       String?                         // Optional specific WhatsApp session ID
  lastSentAt      DateTime?                       // Idempotency: timestamp of last successful send
  lastSentStatus  String?                         // SUCCESS | FAILED
  lastError       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isEnabled])
  @@map("whatsapp_scheduled_reports")
}
