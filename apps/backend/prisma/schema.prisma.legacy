  model              String?
  brand              String?
  status             AssetStatus           @default(AVAILABLE)
  condition          AssetCondition        @default(NEW)
  purchaseDate       DateTime?
  purchaseValue      Decimal?              @db.Decimal(12, 2)
  currency           String                @default("EGP")
  location           String?
  branchId           String?
  image              String?
  notes              String?
