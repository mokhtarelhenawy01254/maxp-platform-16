model LeadCategory {
  id                    String        @id @default(cuid())
  companyId             String
  name                  String
  color                 String?       @default("#6366f1")
  isDefault             Boolean       @default(false)
  sortOrder             Int           @default(0)
  autoFollowUp          Boolean       @default(true)
  autoPromoteCategoryId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts              WhatsAppContact[]
  autoPromoteCategory   LeadCategory?  @relation("CategoryPromotion", fields: [autoPromoteCategoryId], references: [id])
  promotedFrom          LeadCategory[] @relation("CategoryPromotion")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("lead_categories")
}

model WhatsAppFollowUpFlow {
  id          String                 @id @default(cuid())
  companyId   String
  name        String
  isEnabled   Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps       WhatsAppFollowUpStep[]
  journeys    CustomerJourney[]

  @@map("whatsapp_follow_up_flows")
}

model WhatsAppFollowUpStep {
  id          String               @id @default(cuid())
  flowId      String
  delayDays   Int                  @default(1)
  content     String               @db.Text
  mediaUrl    String?
  stepOrder   Int                  @default(1)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  flow        WhatsAppFollowUpFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@map("whatsapp_follow_up_steps")
}

model LeadFollowUpSettings {
  id               String    @id @default(cuid())
  companyId        String    @unique
  isEnabled        Boolean   @default(false)
  delayHours       Int       @default(24)
  message          String    @db.Text
  mediaUrl         String?
  steps            String?   @db.Text  // JSON array of { delayHours, message, mediaUrl }
  businessHourStart Int?              // 0-23
  businessHourEnd   Int?              // 0-23
  timezone         String?            // IANA timezone, default 'UTC'
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("lead_follow_up_settings")
}

model LeadFollowUpEnrollment {
  id                String          @id @default(cuid())
  companyId         String
  customerId        String
  whatsappContactId String
  status            String          @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  nextSendAt        DateTime
  lastSentAt        DateTime?
  firstMessageAt    DateTime        @default(now())
  repliedAt         DateTime?
  currentStep       Int             @default(0)
  logs              String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  whatsAppContact   WhatsAppContact @relation(fields: [whatsappContactId], references: [id], onDelete: Cascade)

  @@index([companyId, status, nextSendAt])
  @@index([customerId])
  @@index([whatsappContactId])
  @@map("lead_follow_up_enrollments")
}

model CustomerJourney {
  id          String               @id @default(cuid())
  companyId   String
  customerId  String
  orderId     String?
  flowId      String
  currentStep Int                  @default(0) // 0 means not started, 1 means step 1 sent, etc.
  status      String               @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  nextSendAt  DateTime
  lastSentAt  DateTime?
  logs        String?              @db.Text
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order       Order?               @relation(fields: [orderId], references: [id])
  flow        WhatsAppFollowUpFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([companyId, status, nextSendAt])
  @@map("customer_journeys")
}
