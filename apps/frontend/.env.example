# API Configuration
VITE_API_URL=/api/v1
VITE_WS_URL=wss://maxp.online
VITE_BACKEND_URL=https://maxp.online
     
# Facebook SDK
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# Google Services
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Payment Gateways
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id

# App Configuration
VITE_APP_NAME="Communication Platform"
VITE_APP_VERSION=1.0.0
VITE_COMPANY_NAME="Your Company"

# Feature Flags
VITE_ENABLE_ECOMMERCE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true

# File Upload
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Theme Configuration
VITE_DEFAULT_THEME=light
VITE_PRIMARY_COLOR=#3B82F6
VITE_SECONDARY_COLOR=#10B981

# Analytics
VITE_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
VITE_MIXPANEL_TOKEN=your-mixpanel-token

# Error Tracking
VITE_SENTRY_DSN=your-sentry-dsn

# Development
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=info
VITE_LOCAL_BASE_DOMAIN=lvh.me:3000
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,.lvh.me

# PWA Configuration
VITE_ENABLE_PWA=true
VITE_PWA_NAME="Communication Platform"
VITE_PWA_SHORT_NAME="CommPlatform"

# Localization
VITE_DEFAULT_LANGUAGE=ar
VITE_SUPPORTED_LANGUAGES=ar,en

# Real-time Features
VITE_ENABLE_REAL_TIME=true
VITE_HEARTBEAT_INTERVAL=30000

# Cache Configuration
VITE_CACHE_DURATION=300000

# Support WhatsApp
VITE_SUPPORT_WHATSAPP_NUMBER=201234567890
