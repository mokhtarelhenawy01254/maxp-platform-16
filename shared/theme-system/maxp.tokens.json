  "typography": {
    "sans": "'IBM Plex Sans Arabic', 'Plus Jakarta Sans', system-ui, sans-serif",
    "heading": "'IBM Plex Sans Arabic', 'Plus Jakarta Sans', sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
    "forbiddenOnArabic": ["monospace", "letter-spacing", "text-transform: uppercase"],
    "scale": [12, 14, 16, 18, 20, 24, 30, 36],
    "bodySize": 16,
    "tabularNums": true
  },
  "radius": {
    "theme": "14px",
    "sm": "10px",
    "md": "12px",
    "lg": "14px",
    "xl": "20px"
  },
  "spacing": {
    "unit": 4,
    "scale": [4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44, 48]
  },
  "icons": {
    "standard": "lucide-react",
    "legacy": "@heroicons/react",
    "rule": "New files MUST use lucide. Never mix libraries in one file."
  },
  "motion": {
    "duration": "150-250ms",
    "easing": "ease-out",
    "buttonActive": "scale(0.97)"
  },
  "surfaces": {
    "admin": "light business-os — tokens only, no brand gradient",
    "landing": "dark ink + brand gradient allowed",
    "storefront": "merchant theme via storefrontThemeContract.json"
  },
  "accessibility": {
    "textAA": 4.5,
    "uiAA": 3.0,
    "darkCardOnBgMin": 1.3,
