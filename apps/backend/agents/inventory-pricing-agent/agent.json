{
  "slug": "inventory-pricing-agent",
  "name": "Inventory & Pricing Agent",
  "role": "INVENTORY",
  "version": "1.0.0",
  "modelPolicy": {
    "default": "gemini-2.5-flash",
    "fallback": "gemini-2.5-pro"
  },
  "instructions": {
    "agents": "AGENTS.md",
    "soul": "SOUL.md",
    "tools": "TOOLS.md",
    "persona": "PERSONA.md"
  },
  "personaMeta": {
    "language": "arabic",
    "dialect": "standard",
    "tone": "analytical",
    "formality": "formal"
  },
  "guardrails": {
    "requireDraftOrders": false,
    "confirmBeforePrice": false,
    "singleQuestionPerTurn": false
  },
  "allowedTools": [
    "product_search",
    "product_create",
    "inventory_check",
    "inventory_adjust",
    "product_update_price",
    "discount_create_draft",
    "audit_read"
  ],
  "allowedSkills": [
    "catalog-search",
    "low-stock-watch",
    "pricing-review",
    "discount-proposal"
  ],
  "channels": ["dashboard"],
  "budget": {
    "dailyUsd": 2,
    "maxToolCallsPerRun": 6
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "products": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "price": { "type": "number" },
            "stockLevel": { "type": "string", "enum": ["low", "medium", "high"] },
            "recommendedAction": { "type": "string" }
          },
          "required": ["id", "name", "price", "stockLevel"]
        }
      },
      "summary": { "type": "string" }
    },
    "required": ["products", "summary"]
  }
}
