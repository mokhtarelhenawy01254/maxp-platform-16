  scheduledTransitionedAt DateTime?
  affiliateReferralId     String?                   @unique
  affiliateId             String?
  merchantOrderId         String?                   @unique
  isDropshipped           Boolean                   @default(false)
  codDepositAmount        Decimal?                  @db.Decimal(10, 2)
  codDepositPaid          Boolean                   @default(false)
  codDepositPaidAt        DateTime?
  codDepositMethod        String?
  codDepositSessionId     String?
  codDepositRefunded      Boolean                   @default(false)
  orderSource             OrderSource               @default(REGULAR)
  externalId              String?
  createdBy               String?
  createdByName           String?
  userRelId               String?
  statusHistory           OrderStatusHistory[]
  statusChangeRequests    OrderStatusChangeRequest[]
  workflowAuditLogs       OrderWorkflowAuditLog[]
