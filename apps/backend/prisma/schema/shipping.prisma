model ShippingCompany {
  id              String     @id @default(cuid())
  name            String
  slug            String?
  phone           String?
  email           String?
  website         String?
  apiKey          String?
  apiUrl          String?
  providerKey     String     @default("MANUAL")
  integrationMode String     @default("MANUAL")
  settings        String?
  isActive        Boolean    @default(true)
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipments       Shipment[]
  returnTypes     ReturnType[]
  returnRequests  ReturnRequest[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([isActive])
  @@index([slug])
  @@index([providerKey])
  @@index([integrationMode])
  @@map("shipping_companies")
}

model CarrierTicket {
  id            String   @id @default(cuid())
  companyId     String
  providerKey   String   // TURBO | DEMO | MANUAL
  externalId    String
  orderId       String?
  shipmentId    String?
  code          String?  // رقم الطلب/التتبع
  subject       String?
  status        String   @default("OPEN")   // OPEN | PENDING_MERCHANT | PENDING_CUSTOMER | RESOLVED | CLOSED
  lastMessageAt DateTime?
  unreadCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, providerKey, externalId])
  @@index([companyId, status, lastMessageAt])
  @@index([orderId])
  @@map("carrier_tickets")
}

model CarrierTicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  companyId  String
  direction  String   // INBOUND (من الشركة) | OUTBOUND (مننا)
  externalId String   // معرّف المزوّد أو hash ثابت (body+sentAt) — dedupe
  body       String   @db.Text
  authorName String?
  sentAt     DateTime?
  createdAt  DateTime @default(now())

  @@unique([companyId, ticketId, externalId])
  @@index([ticketId, createdAt])
  @@map("carrier_ticket_messages")
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  companyId  String
  shipmentId String
  fromStatus String?
  toStatus   String
  reasonCode String?
  notes      String?
  actorType  String   // ADMIN | COURIER | CLIENT | SYSTEM
  actorId    String?
  actorName  String?
  branchId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([companyId, shipmentId, createdAt])
  @@map("shipment_events")
}

model ClientRateCard {
  id              String   @id @default(cuid())
  companyId       String
  merchantId      String
  name            String
  governorateCode String?
  cityName        String?
  cities          String?  @db.Text
  basePrice       Decimal  @db.Decimal(10, 2)
  baseWeightKg    Decimal  @default(1) @db.Decimal(10, 3)
  extraKgPrice    Decimal  @default(0) @db.Decimal(10, 2)
  codFeeFixed     Decimal  @default(0) @db.Decimal(10, 2)
  codFeePercent   Decimal  @default(0) @db.Decimal(5, 2)
  returnFee       Decimal  @default(0) @db.Decimal(10, 2)
  minWeight       Decimal? @db.Decimal(10, 3)
  maxWeight       Decimal? @db.Decimal(10, 3)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, merchantId, name])
  @@index([companyId, merchantId, isActive])
  @@map("client_rate_cards")
}

model ShippingPolicySettings {
  id                    String   @id @default(cuid())
  companyId             String   @unique
  operatingModel        String   @default("INTERNAL") // INTERNAL | PARTNERS | HYBRID
  codSettlementMode     String   @default("STATEMENT_WITH_REMITTANCE") // STATEMENT | STATEMENT_WITH_REMITTANCE | AUTO
  intakeMode            String   @default("MIXED") // INTERNAL | PORTAL | API | MIXED
  pricingBasis          String   @default("ZONE_WEIGHT") // ZONE | WEIGHT | VOLUMETRIC | TIERS | ZONE_WEIGHT
  codFeeType            String   @default("FIXED") // FIXED | PERCENT | NONE
  deliveryAttempts      Int      @default(3)
  attemptIntervalHours  Int      @default(24)
  afterAttemptsAction   String   @default("REVIEW") // RTO | REVIEW
  proofOfDelivery       String   @default("OTP,PIN")
  requirePinOnShareLink Boolean  @default(true)
  requireCourierPinOnLink Boolean @default(true)
  requireDeliveryOtp    Boolean  @default(false)
  rtoChargeReturnLeg    Boolean  @default(false)
  rtoReturnLegPrice     Decimal? @db.Decimal(10, 2)
  publicTrackingMode    String   @default("WAYBILL") // WAYBILL | PHONE | OFF
  publicTrackingMask    Boolean  @default(true)
  clientPortalEnabled   Boolean  @default(true)
  courierPortalEnabled  Boolean  @default(true)
  offlineEnabled        Boolean  @default(true)
  maxWeightKg           Decimal? @db.Decimal(10, 3)
  maxCodAmount          Decimal? @db.Decimal(10, 2)
  maxShipmentsPerCourierPerDay Int @default(60)
  currency              String   @default("EGP")
  invoiceVatPercent     Decimal  @default(0) @db.Decimal(5, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("shipping_policy_settings")
}

model PickupRequest {
  id                String          @id @default(cuid())
  companyId         String
  merchantId        String?
  pickupNumber      String
  status            String          @default("REQUESTED") // REQUESTED | SCHEDULED | ASSIGNED | COMPLETED | CANCELLED
  scheduledDate     DateTime
  timeSlot          String?
  contactName       String
  contactPhone      String
  pickupAddress     String
  city              String?
  governorate       String
  expectedParcels   Int             @default(1)
  actualParcels     Int?
  assignedCourierId String?
  branchId          String?
  notes             String?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  branch            ShippingBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  shipments         Shipment[]

  @@unique([companyId, pickupNumber])
  @@index([companyId, status, scheduledDate])
  @@index([companyId, merchantId])
  @@index([assignedCourierId])
  @@index([branchId])
  @@map("pickup_requests")
}

model ShippingBranch {
  id          String          @id @default(cuid())
  companyId   String
  name        String
  code        String
  governorate String
  address     String?
  phone       String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  pickups     PickupRequest[]
  shipments   Shipment[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("shipping_branches")
}


model ShippingSettlement {
  id                    String                   @id @default(cuid())
  companyId             String
  merchantId            String
  settlementNumber      String
  status                String                   @default("DRAFT") /// DRAFT | ISSUED | APPROVED | PAID | REJECTED
  periodStart           DateTime
  periodEnd             DateTime
  totalShipments        Int                      @default(0)
  deliveredCount        Int                      @default(0)
  returnedCount         Int                      @default(0)
  grossCOD              Decimal                  @default(0) @db.Decimal(12, 2)
  shippingFeesTotal     Decimal                  @default(0) @db.Decimal(12, 2)
  codFeesTotal          Decimal                  @default(0) @db.Decimal(12, 2)
  returnFeesTotal       Decimal                  @default(0) @db.Decimal(12, 2)
  netPayout             Decimal                  @default(0) @db.Decimal(12, 2)
  paymentMethod         String?
  paymentReference      String?
  treasuryTransactionId String?
  approvedBy            String?
  approvedAt            DateTime?
  paidAt                DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  lines                 ShippingSettlementLine[]

  @@unique([companyId, settlementNumber])
  @@index([companyId, merchantId, status])
  @@map("shipping_settlements")
}

model ShippingSettlementLine {
  id              String             @id @default(cuid())
  settlementId    String
  shipmentId      String             @unique
  codAmount       Decimal            @default(0) @db.Decimal(12, 2)
  collectedAmount Decimal            @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal            @default(0) @db.Decimal(12, 2)
  codFee          Decimal            @default(0) @db.Decimal(12, 2)
  returnFee       Decimal            @default(0) @db.Decimal(12, 2)
  net             Decimal            @default(0) @db.Decimal(12, 2)
  createdAt       DateTime           @default(now())

  settlement      ShippingSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  shipment        Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@map("shipping_settlement_lines")
}
