/// Booking module - Medical center branches
model BookingBranch {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  address     String?
  phone       String?
  phones      Json?    /// List of phone numbers: ["01234567890","02-1234567"]
  workingDays Json?    /// Working hours per day: {"sat":"3-9","sun":"12-9",...}
  genderDays  Json?    /// Gender day mapping: {"male":["sat","mon","wed"],"female":["sun","tue","thu"]}
  location      String?  /// Location description or coordinates
  landmarkImage String?  /// Landmark image (base64)
  facilityType  String   @default("clinic") /// clinic | medical_center | hospital | polyclinic | dental | cosmetic
  maxBookingsPerSlot Int      @default(1) /// Max appointments allowed per time slot
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  doctors     BookingDoctor[]
  branchServices BookingBranchService[]
  appointments Appointment[]

  @@index([companyId])
  @@map("booking_branches")
}

/// Booking module - Doctors
model BookingDoctor {
  id              String     @id @default(cuid())
  companyId       String
  branchId        String
  title           String     /// e.g. "دكتور", "أخصائي"
  name            String?    /// Doctor's full name
  specialty       String?    /// Specialty: "علاج طبيعي", "عظام", etc.
  phone           String?
  gender          Gender?
  email           String?
  password        String?    /// Hashed password for doctor portal login
  employeeId      String?    /// Optional link to HR Employee
  consultationFee Float?
  commissionRate  Float?
  bio             String?
  avatarUrl       String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          BookingBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  availability    DoctorAvailability[]

  @@index([companyId])
  @@index([branchId])
  @@map("booking_doctors")
}

/// Booking module - Doctor working availability (per weekday)
model DoctorAvailability {
  id          String    @id @default(cuid())
  companyId   String
  doctorId    String
  dayOfWeek   Int       /// 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime   String    /// HH:mm
  endTime     String    /// HH:mm
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  doctor      BookingDoctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([doctorId])
  @@map("doctor_availability")
}

/// Booking module - Service template (shared across branches)
model BookingService {
  id                   String   @id @default(cuid())
  companyId            String
  name                 String
  description          String?
  requiresConsultation Boolean  @default(true) /// Needs doctor assessment first
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchServices       BookingBranchService[]
  appointments         Appointment[]

  @@index([companyId])
  @@map("booking_services")
}

/// Per-branch service config (pricing, availability)
model BookingBranchService {
  id          String   @id @default(cuid())
  serviceId   String
  branchId    String
  hasPackages Boolean  @default(true)
  packages    Json?    /// Array of packages: [{"count":3,"price":500,"originalPrice":750},...]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service BookingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch  BookingBranch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([serviceId, branchId])
  @@index([branchId])
  @@map("booking_branch_services")
}

/// Multi-turn booking drafts - agent collects fields one at a time
model BookingDraft {
  id              String    @id @default(cuid())
  companyId       String
  branchId        String?
  doctorId        String?
  serviceId       String?
  customerName    String?
  customerPhone   String?
  customerGender  String?
  appointmentDate DateTime? @db.Date
  startTime       String?
  notes           String?
  status          String    @default("in_progress") /// in_progress | ready | completed | expired
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([expiresAt])
  @@map("booking_drafts")
}

/// Booking module - Patient medical file (may link to a CRM Customer booker)
model Patient {
  id              String    @id @default(cuid())
  companyId       String
  customerId      String?   /// Optional link to CRM Customer (booker/contact person)
  firstName       String
  lastName        String?
  phone           String?
  email           String?
  password        String?   /// Hashed password for patient portal login
  gender          Gender?
  birthDate       DateTime? @db.Date
  bloodType       String?
  allergies       Json?     /// List: ["penicillin","dust"]
  chronicDiseases Json?     /// List: ["diabetes","hypertension"]
  medications     Json?     /// List: ["aspirin 81mg daily"]
  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appointments    Appointment[]
  invoices        MedicalInvoice[]

  @@index([companyId])
  @@index([customerId])
  @@index([phone])
  @@map("patients")
}

/// Booking module - Invoice for a patient/appointment
model MedicalInvoice {
  id            String          @id @default(cuid())
  companyId     String
  invoiceNumber String
  patientId     String
  appointmentId String?
  total         Float
  discount      Float           @default(0)
  amountPaid    Float           @default(0)
  status        String          @default("UNPAID") /// UNPAID | PARTIAL | PAID | REFUNDED
  dueDate       DateTime?       @db.Date
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  payments      MedicalPayment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
  @@map("medical_invoices")
}

/// Booking module - Payment records against an invoice
model MedicalPayment {
  id          String          @id @default(cuid())
  companyId   String
  invoiceId   String
  amount      Float
  method      String          @default("CASH") /// CASH | CARD | WALLET | ONLINE
  paidAt      DateTime        @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime        @default(now())
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice     MedicalInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invoiceId])
  @@map("medical_payments")
}
