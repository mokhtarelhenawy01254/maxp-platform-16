[
  {
    "id": "TC001",
    "title": "Render aura-chic layout on homepage with key sections visible",
    "description": "Verifies that the manifest-driven homepage renders the expected sections when a valid layout theme is provided via URL parameters.",
    "category": "Storefront Template Rendering",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to \"/?layout=aura-chic\""
      },
      {
        "type": "assertion",
        "description": "Verify element \"Hero section\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify element \"Featured Collection section\" is visible"
      },
      {
        "type": "action",
        "description": "Scroll to \"Featured Products section\""
      },
      {
        "type": "assertion",
        "description": "Verify element \"Featured Products section\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify element \"Product card\" is visible"
      }
    ]
  },
  {
    "id": "TC002",
    "title": "Invalid layout shows error banner and Retry falls back to default layout",
    "description": "Verifies runtime fallback handling when an invalid layout theme is provided and user retries to render a default layout.",
    "category": "Storefront Template Rendering",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to \"/?layout=invalid-theme\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"Failed to load section\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify element \"Retry\" is visible"
      },
      {
        "type": "action",
        "description": "Click on \"Retry\""
      },
      {
        "type": "assertion",
        "description": "Verify element \"Hero section\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify element \"Featured Collection section\" is visible"
      }
    ]
  },
