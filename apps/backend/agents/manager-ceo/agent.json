{
  "slug": "manager-ceo",
  "name": "CEO Agent",
  "role": "CEO",
  "version": "1.0.0",
  "modelPolicy": {
    "default": "gemini-2.5-pro",
    "fallback": "gemini-2.5-flash"
  },
  "instructions": {
    "agents": "AGENTS.md",
    "soul": "SOUL.md",
    "tools": "TOOLS.md",
    "persona": "PERSONA.md"
  },
  "personaMeta": {
    "language": "english",
    "dialect": null,
    "tone": "strategic",
    "formality": "formal"
  },
  "guardrails": {
    "requireDraftOrders": false,
    "confirmBeforePrice": false,
    "singleQuestionPerTurn": false
  },
  "allowedTools": [
    "agent.spawn",
    "agent.assign_task",
    "agent.list_agents",
    "agent.read_state",
    "agent.update_profile",
    "agent.run_task",
    "agent.handoff",
    "skill.create",
    "hr.attendance_today",
    "product.search",
    "product.create",
    "product.lowStock",
    "product.topSelling",
    "order.summary",
    "order.lookup",
    "order.recentList",
    "order.create_draft",
    "order.confirm",
    "order.cancel",
    "order.refund",
    "customer.info",
    "customer.topBuyers",
    "inventory.check",
    "sales.revenue",
    "company.snapshot",
    "shipping.rates",
    "shipping.update",
    "discount.apply",
    "discount.create_draft",
    "product.updatePrice",
    "audit.read",
    "scheduler.create_job"
  ],
  "allowedSkills": [
    "hire-agent",
    "delegate-goal",
    "read-company-state",
    "review-agent-performance"
  ],
  "mcpServers": [
    {
      "name": "filesystem",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
    }
  ],
  "channels": ["dashboard"],
  "budget": {
    "dailyUsd": 5,
    "maxToolCallsPerRun": 8
  }
}
