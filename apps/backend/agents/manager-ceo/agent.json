{
  "slug": "manager-ceo",
  "name": "CEO Agent",
  "role": "CEO",
  "version": "1.0.0",
  "modelPolicy": {
    "default": "gemini-2.5-pro",
    "fallback": "gemini-2.5-flash"
  },
  "instructions": {
