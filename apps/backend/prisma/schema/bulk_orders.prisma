model BulkOrder {
  id              String          @id @default(cuid())
  operationNumber String          @unique
  name            String
  description     String?
  status          BulkOrderStatus @default(DRAFT)
  progress        Int             @default(0)
  totalOrders     Int             @default(0)
  createdById     String?
  createdByName   String?
  updatedById     String?
  updatedByName   String?
  customerData    String?
  productData     String?
  fileAttachments String?
  metadata        String?
  companyId       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  executedAt      DateTime?
  items           BulkOrderItem[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([companyId, createdAt])
  @@map("bulk_orders")
}

model BulkOrderItem {
  id              String   @id @default(cuid())
  bulkOrderId     String
  orderNumber     String?
  customerName    String?
  customerPhone   String?
  city            String?
  governorate     String?
  productName     String?
  sku             String?
  size            String?
  color           String?
  quantity        Int      @default(1)
  price           Decimal  @default(0) @db.Decimal(10, 2)
  total           Decimal  @default(0) @db.Decimal(10, 2)
  status          String   @default("PENDING")
  notes           String?
  metadata        String?
  companyId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bulkOrder       BulkOrder @relation(fields: [bulkOrderId], references: [id], onDelete: Cascade)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([bulkOrderId])
  @@index([companyId])
  @@map("bulk_order_items")
}

enum BulkOrderStatus {
  DRAFT
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}
