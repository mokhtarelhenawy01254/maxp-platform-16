model JobPosting {
  id               String      @id @default(cuid())
  companyId        String
  title            String
  department       String
  location         String
  type             ContractType @default(FULL_TIME)
  experienceLevel  String?
  salaryMin        Decimal?    @db.Decimal(12, 2)
  salaryMax        Decimal?    @db.Decimal(12, 2)
  description      String
  requirements     String?
  responsibilities String?
  status           String      @default("ACTIVE")
  closingDate      DateTime?
  postedDate       DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applicants       Applicant[]
  recruitmentForms RecruitmentForm[]

  @@index([companyId])
  @@map("hr_job_postings")
}

model Applicant {
  id          String      @id @default(cuid())
  companyId   String
  jobId       String
  formResponseId String?  @unique
  name        String
  email       String?
  phone       String?
  resumeUrl   String?
  coverLetter String?
  experience  Int?
  education   String?
  skills      String?
  notes       String?
  status      String      @default("NEW")
  rating      Int?        @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         JobPosting  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  formResponse RecruitmentFormResponse? @relation(fields: [formResponseId], references: [id], onDelete: SetNull)
  interviews  Interview[]

  @@index([companyId])
  @@index([jobId])
  @@map("hr_applicants")
}

model Interview {
  id           String    @id @default(cuid())
  companyId    String
  applicantId  String
  jobId        String
  date         DateTime
  time         String
  type         String    @default("IN_PERSON")
  location     String?
  interviewers String?
  notes        String?
  status       String    @default("SCHEDULED")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([applicantId])
  @@map("hr_interviews")
}

model RecruitmentForm {
  id              String      @id @default(cuid())
  companyId       String
  jobId           String?
  title           String
  slug            String?     @unique
  description     String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job             JobPosting? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  questions       RecruitmentFormQuestion[]
  responses       RecruitmentFormResponse[]

  @@index([companyId])
  @@index([jobId])
  @@map("hr_recruitment_forms")
}

model RecruitmentFormQuestion {
  id           String    @id @default(cuid())
  formId       String
  questionText String
  questionType String    // TEXT, TEXTAREA, SELECT, RADIO, CHECKBOX, FILE
  options      String?   // JSON string or comma-separated for SELECT, RADIO, CHECKBOX
  isRequired   Boolean   @default(false)
  orderIndex   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  form         RecruitmentForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers      RecruitmentFormAnswer[]

  @@index([formId])
  @@map("hr_recruitment_form_questions")
}

model RecruitmentFormResponse {
  id              String    @id @default(cuid())
  formId          String
  respondentName  String
  respondentEmail String?
  respondentPhone String?
  isContacted     Boolean   @default(false)
  contactedAt     DateTime?
  submittedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  form            RecruitmentForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  applicant       Applicant?
  answers         RecruitmentFormAnswer[]

  @@index([formId])
  @@map("hr_recruitment_form_responses")
}

model RecruitmentFormAnswer {
  id           String    @id @default(cuid())
  responseId   String
  questionId   String
  answerText   String?
  answerFile   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  response     RecruitmentFormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question     RecruitmentFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([questionId])
  @@map("hr_recruitment_form_answers")
}
