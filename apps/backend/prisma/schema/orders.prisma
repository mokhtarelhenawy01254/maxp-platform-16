  notifyOnNew            Boolean  @default(true)
  autoAssignOnConfirm    Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("order_confirmation_settings")
}

model OrderAssignment {
  id           String     @id @default(cuid())
  orderId      String?
  guestOrderId String?
  companyId    String
  assignedTo   String
  assignedBy   String?
  assignedAt   DateTime   @default(now())
  strategy     String?
  metadata     String?
  isActive     Boolean    @default(true)
  order        Order?     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  guestOrder   GuestOrder? @relation(fields: [guestOrderId], references: [id], onDelete: Cascade)
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([guestOrderId])
  @@index([companyId])
  @@index([companyId, assignedAt])
  @@index([companyId, strategy, assignedAt])
  @@index([assignedTo])
  @@index([companyId, assignedTo, isActive, assignedAt])
  @@map("order_assignments")
}

model OrderStatusAutoChangeRule {
  id         String   @id @default(cuid())
  companyId  String
  fromStatus String
  toStatus   String
  waitTime   Int
  timeUnit   String   // 'Minutes', 'Hours', 'Days'
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("order_status_auto_change_rules")
}

