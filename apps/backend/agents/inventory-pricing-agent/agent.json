{
  "slug": "inventory-pricing-agent",
  "name": "Inventory & Pricing Agent",
  "role": "INVENTORY",
  "version": "1.0.0",
  "modelPolicy": {
    "default": "deepseek-flash",
    "fallback": "groq/openai/gpt-oss-120b"
  },
  "instructions": {
    "agents": "AGENTS.md",
    "soul": "SOUL.md",
    "tools": "TOOLS.md",
    "persona": "PERSONA.md"
  },
  "personaMeta": {
    "language": "arabic",
    "dialect": "standard",
    "tone": "analytical",
    "formality": "formal"
  },
  "guardrails": {
    "requireDraftOrders": false,
    "singleQuestionPerTurn": false
  },
  "allowedTools": [
    "product.search",
    "product.create",
    "category.list",
    "inventory.check",
    "inventory.adjust",
    "product.update.price",
    "discount.create_draft",
    "shipping.rates",
    "shipping.zone.set",
    "audit.read"
  ],
  "allowedSkills": [
    "product-catalog-creator",
    "catalog-search",
    "low-stock-watch",
    "pricing-review",
    "discount-proposal"
  ],
  "channels": [
    "dashboard"
  ],
  "budget": {
    "dailyUsd": 2,
    "maxToolCallsPerRun": 6
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "products": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "price": {
              "type": "number"
            },
            "stockLevel": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "recommendedAction": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "price",
            "stockLevel"
          ]
        }
      },
      "summary": {
        "type": "string"
      }
    },
    "required": [
      "products",
      "summary"
    ]
  }
}
