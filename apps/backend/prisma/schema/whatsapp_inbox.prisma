// ═══════════════════════════════════════════════════════════════════════════════
// WhatsApp Inbox CRM — RBAC, Number Assignments, Notes, Notifications
// ═══════════════════════════════════════════════════════════════════════════════

enum ChatStatus {
  NEW
  ASSIGNED
  PENDING
  CLOSED
  ARCHIVED
}

enum ModeratorRole {
  ADMIN
  TEAM_LEADER
  MODERATOR
}

enum NumberConnectionStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
  ERROR
  SCANNING_QR
}

model ModeratorTeam {
  id          String                  @id @default(cuid())
  name        String
  description String?
  companyId   String
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members     ModeratorTeamMember[]
  numberAssignments WhatsAppNumberAssignment[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([isActive])
  @@map("moderator_teams")
}

model ModeratorTeamMember {
  id          String          @id @default(cuid())
  teamId      String
  userId      String
  companyId   String
  isTeamLeader Boolean        @default(false)
  isActive    Boolean         @default(true)
  joinedAt    DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  team        ModeratorTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([companyId])
  @@index([teamId])
  @@index([userId])
  @@map("moderator_team_members")
}

model WhatsAppNumberAssignment {
  id                String                  @id @default(cuid())
  sessionId         String                  @unique
  companyId         String
  assignedUserId    String?
  routingMode       String                  @default("NUMBER_OWNER")
  distributionStrategy String              @default("ROUND_ROBIN")
  routingUserIds    String?
  roundRobinCursor  Int                     @default(0)
  lastDistributedUserId String?
  lastDistributedAt DateTime?
  teamId            String?
  assignedByUserId  String?
  assignedAt        DateTime                @default(now())
  unassignedAt      DateTime?
  isActive          Boolean                 @default(true)
  connectionStatus  NumberConnectionStatus  @default(DISCONNECTED)
  lastConnectedAt   DateTime?
  lastDisconnectedAt DateTime?
  autoReplyEnabled  Boolean                 @default(false)
  workingHoursStart String?
  workingHoursEnd   String?
  workingDays       String?
  maxChatsPerDay    Int?                    @default(100)
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session           WhatsAppSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignedUser      User?                   @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  team              ModeratorTeam?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedByUser    User?                   @relation("NumberAssignmentBy", fields: [assignedByUserId], references: [id])

  @@index([companyId])
  @@index([assignedUserId])
  @@index([teamId])
  @@index([sessionId])
  @@index([connectionStatus])
  @@index([companyId, assignedUserId, isActive])
  @@map("whatsapp_number_assignments")
}

model ConversationModeratorNote {
  id              String       @id @default(cuid())
  conversationId  String
  companyId       String
  authorId        String
  content         String
  type            String       @default("note")
  isPinned        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author          User         @relation(fields: [authorId], references: [id])

  @@index([conversationId])
  @@index([companyId])
  @@index([authorId])
  @@index([conversationId, createdAt])
  @@map("conversation_moderator_notes")
}

model ConversationTag {
  id              String       @id @default(cuid())
  conversationId  String
  companyId       String
  tag             String
  color           String?      @default("#6366f1")
  createdBy       String
  createdAt       DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator         User         @relation(fields: [createdBy], references: [id])

  @@unique([conversationId, tag])
  @@index([companyId])
  @@index([tag])
  @@index([conversationId])
  @@map("conversation_tags")
}

model ModeratorActivityLog {
  id              String    @id @default(cuid())
  companyId       String
  userId          String
  action          String
  entityType      String
  entityId        String?
  metadata        String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("moderator_activity_logs")
}

model ModeratorNotification {
  id              String    @id @default(cuid())
  companyId       String
  userId          String
  sessionId       String?
  conversationId  String?
  type            String
  title           String
  body            String?
  data            String?
  isRead          Boolean   @default(false)
  isSoundPlayed   Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id])
  session         WhatsAppSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([type])
  @@index([companyId, userId, isRead])
  @@map("moderator_notifications")
}

model ModeratorDashboardCache {
  id              String    @id @default(cuid())
  userId          String
  companyId       String
  sessionId       String?
  data            String    @db.Text
  period          String    @default("today")
  cachedAt        DateTime  @default(now())
  expiresAt       DateTime
  user            User      @relation(fields: [userId], references: [id])
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, period])
  @@index([userId])
  @@index([companyId])
  @@index([expiresAt])
  @@map("moderator_dashboard_cache")
}

model InboxSettings {
  id                String   @id @default(cuid())
  companyId         String   @unique
  defaultChatStatus String   @default("NEW")
  autoCloseEnabled  Boolean  @default(false)
  autoCloseAfterMin Int?     @default(1440)
  archiveAfterDays  Int?     @default(30)
  retentionDays     Int?     @default(365)
  maxChatsPerModerator Int? @default(50)
  allowTransfer     Boolean  @default(true)
  requireNoteOnClose Boolean @default(false)
  notifyOnNewChat   Boolean  @default(true)
  notifyOnTransfer  Boolean  @default(true)
  notifyOnClose     Boolean  @default(false)
  browserPushEnabled Boolean @default(true)
  soundEnabled      Boolean  @default(true)
  soundUrl          String?  @default("/notification.mp3")
  workingHoursEnabled Boolean @default(false)
  workingHoursStart String?
  workingHoursEnd   String?
  workingDays       String?  @default("SAT,SUN,MON,TUE,WED,THU")
  assignmentConfig  String?  @db.Text
  ownershipConfig   String?  @db.Text
  queueConfig       String?  @db.Text
  reassignmentConfig String? @db.Text
  skillConfig       String?  @db.Text
  slaConfig         String?  @db.Text
  notificationConfig String? @db.Text
  assignmentState   String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("inbox_settings")
}
