model WholesalePriceList {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  description String?
  companyId   String
  type        String   @default("CUSTOM") // PUBLIC | CUSTOM
  isActive    Boolean  @default(true)
  validFrom   DateTime?
  validTo     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       WholesalePriceListItem[]
  customerLinks WholesaleCustomerPriceList[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("wholesale_price_lists")
}

model WholesalePriceListItem {
  id          String            @id @default(cuid())
  priceListId String
  productId   String
  variantId   String?
  price       Decimal           @db.Decimal(10, 2)
  minQuantity Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  priceList   WholesalePriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant?   @relation(fields: [variantId], references: [id])

  @@unique([priceListId, productId, variantId])
  @@index([priceListId])
  @@index([productId])
  @@index([variantId])
  @@map("wholesale_price_list_items")
}

model WholesaleCustomerPriceList {
  id          String            @id @default(cuid())
  customerId  String
  priceListId String
  companyId   String
  priority    Int               @default(0)
  createdAt   DateTime          @default(now())
  priceList   WholesalePriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([customerId, priceListId])
  @@index([customerId])
  @@index([priceListId])
  @@index([companyId])
  @@map("wholesale_customer_price_lists")
}

model WholesaleCustomer {
  id            String    @id @default(cuid())
  customerId    String    @unique
  companyId     String
  creditLimit   Decimal   @default(0) @db.Decimal(10, 2)
  currentBalance Decimal  @default(0) @db.Decimal(10, 2)
  isActive      Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions  WholesaleTransaction[]
  statements    WholesaleStatement[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("wholesale_customers")
}

model WholesaleTransaction {
  id              String             @id @default(cuid())
  wholesaleCustomerId String
  companyId       String
  type            String             // INVOICE | PAYMENT | CREDIT_NOTE | ADJUSTMENT
  amount          Decimal            @db.Decimal(10, 2)
  balanceBefore   Decimal            @default(0) @db.Decimal(10, 2)
  balanceAfter    Decimal            @default(0) @db.Decimal(10, 2)
  referenceType   String?            // ORDER | PAYMENT | INVOICE
  referenceId     String?
  notes           String?
  createdAt       DateTime           @default(now())
  wholesaleCustomer WholesaleCustomer @relation(fields: [wholesaleCustomerId], references: [id], onDelete: Cascade)
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([wholesaleCustomerId])
  @@index([companyId])
  @@index([createdAt])
  @@map("wholesale_transactions")
}

model WholesaleStatement {
  id              String             @id @default(cuid())
  wholesaleCustomerId String
  companyId       String
  periodStart     DateTime
  periodEnd       DateTime
  openingBalance  Decimal            @default(0) @db.Decimal(10, 2)
  closingBalance  Decimal            @default(0) @db.Decimal(10, 2)
  totalInvoiced   Decimal            @default(0) @db.Decimal(10, 2)
  totalPaid       Decimal            @default(0) @db.Decimal(10, 2)
  generatedAt     DateTime           @default(now())
  wholesaleCustomer WholesaleCustomer @relation(fields: [wholesaleCustomerId], references: [id], onDelete: Cascade)
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([wholesaleCustomerId])
  @@index([companyId])
  @@index([periodStart, periodEnd])
  @@map("wholesale_statements")
}
