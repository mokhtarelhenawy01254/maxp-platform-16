/// Education module - Subjects (e.g. Arabic, Quran, Math)
model EducationSubject {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  packages        EducationPackage[]
  teacherSubjects EducationTeacherSubject[]
  sessions        EducationSession[]

  @@index([companyId])
  @@map("education_subjects")
}

/// Education module - Session packages (hours bundle with suggested session duration)
model EducationPackage {
  id              String   @id @default(cuid())
  companyId       String
  subjectId       String
  name            String
  description     String?
  hoursCount      Float
  sessionDuration Int?     /// Suggested minutes per session
  price           Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subject         EducationSubject @relation(fields: [subjectId], references: [id])

  enrollments EducationEnrollment[]

  @@index([companyId])
  @@index([subjectId])
  @@map("education_packages")
}

/// Education module - Students (children of Parent/Customer)
model EducationStudent {
  id         String     @id @default(cuid())
  companyId  String
  customerId String     /// Parent (Customer/CRM)
  firstName  String
  lastName   String
  phone      String?
  gender     Gender?
  grade      String?    /// Educational level (e.g. "Grade 5", "Beginner")
  notes      String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  enrollments EducationEnrollment[]
  sessions    EducationSession[]

  @@index([companyId])
  @@index([customerId])
  @@map("education_students")
}

/// Education module - Teachers
model EducationTeacher {
  id            String   @id @default(cuid())
  companyId     String
  employeeId    String?  /// Optional link to HR Employee
  name          String
  phone         String?
  email         String?
  password      String?  /// Hashed password for teacher portal login
  bio           String?  /// Teacher biography/description
  qualifications String? /// Qualifications, certifications
  avatarUrl     String?  /// Profile picture URL
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  subjectRates EducationTeacherSubject[]
  enrollments  EducationEnrollment[]
  sessions     EducationSession[]
  availability EducationTeacherAvailability[]
  payments     EducationTeacherPayment[]

  @@index([companyId])
  @@map("education_teachers")
}

/// Education module - Teacher availability (working days/hours)
model EducationTeacherAvailability {
  id          String   @id @default(cuid())
  companyId   String
  teacherId   String
  dayOfWeek   Int      /// 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime   String   /// HH:mm format
  endTime     String   /// HH:mm format
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teacher     EducationTeacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([teacherId])
  @@map("education_teacher_availability")
}

/// Education module - Teacher payment/salary records
model EducationTeacherPayment {
  id           String   @id @default(cuid())
  companyId    String
  teacherId    String
  periodFrom   DateTime /// Start of payment period
  periodTo     DateTime /// End of payment period
  totalSessions Int     /// Number of sessions in period
  totalHours   Float    /// Total hours worked
  hourlyRate   Float    /// Average hourly rate
  grossAmount  Float    /// Total amount before deductions
  deductions   Float    @default(0)
  netAmount    Float    /// Final amount after deductions
  status       String   @default("PENDING") /// PENDING, PAID, CANCELLED
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teacher      EducationTeacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([teacherId])
  @@index([status])
  @@map("education_teacher_payments")
}

/// Education module - Teacher subject assignment with hourly rate
model EducationTeacherSubject {
  id         String @id @default(cuid())
  teacherId  String
  subjectId  String
  hourlyRate Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teacher EducationTeacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject EducationSubject @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("education_teacher_subjects")
}

/// Education module - Package enrollment (student buys a package, teacher is assigned)
model EducationEnrollment {
  id              String        @id @default(cuid())
  companyId       String
  studentId       String
  packageId       String
  teacherId       String?       /// Assigned teacher (admin assigns, not AI)
  remainingHours  Float         /// Hours remaining (deducted on session confirmation)
  totalHours      Float         /// Total hours from package
  amountPaid      Float
  paymentStatus   PaymentStatus @default(PENDING)
  enrollmentDate  DateTime      @default(now())
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student         EducationStudent  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  package         EducationPackage  @relation(fields: [packageId], references: [id])
  teacher         EducationTeacher? @relation(fields: [teacherId], references: [id])

  sessions EducationSession[]

  @@index([companyId])
  @@index([studentId])
  @@index([teacherId])
  @@index([paymentStatus])
  @@map("education_enrollments")
}

/// Education module - Individual sessions (lessons)
model EducationSession {
  id              String                  @id @default(cuid())
  companyId       String
  enrollmentId    String
  teacherId       String
  studentId       String
  subjectId       String
  scheduledAt     DateTime
  plannedDuration Int                     /// Planned minutes
  actualDuration  Int?                    /// Actual minutes (teacher confirms after session)
  status          EducationSessionStatus  @default(SCHEDULED)
  topic           String?
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enrollment      EducationEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher         EducationTeacher        @relation(fields: [teacherId], references: [id])
  student         EducationStudent        @relation(fields: [studentId], references: [id])
  subject         EducationSubject        @relation(fields: [subjectId], references: [id])

  @@index([companyId])
  @@index([enrollmentId])
  @@index([studentId])
  @@index([teacherId])
  @@index([scheduledAt])
  @@index([status])
  @@map("education_sessions")
}
