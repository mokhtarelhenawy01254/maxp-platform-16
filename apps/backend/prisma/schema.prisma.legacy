// --- From: hr.prisma ---
model Department {
  id               String       @id @default(cuid())
  companyId        String
  name             String
  nameEn           String?
  code             String?
  description      String?
  managerId        String?
  parentId         String?
  color            String?      @default("#3B82F6")
  icon             String?
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent           Department?  @relation("DepartmentToDepartment", fields: [parentId], references: [id])
  children         Department[] @relation("DepartmentToDepartment")
  employees        Employee[]
  goals            Goal[]
  positions        Position[]
  users            User[]
  managedEmployees Employee[]   @relation("DepartmentManager")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([managerId])
  @@index([parentId])
  @@map("hr_departments")
}

model Employee {
  id                  String                @id @default(cuid())
  companyId           String
  userId              String?               @unique
  employeeNumber      String
  firstName           String
  lastName            String
  firstNameEn         String?
  lastNameEn          String?
  email               String?
  phone               String?
  mobile              String?
  avatar              String?
  dateOfBirth         DateTime?
  gender              Gender?
  nationality         String?
  nationalId          String?
  passportNumber      String?
  maritalStatus       MaritalStatus?
  address             String?
  city                String?
  country             String?
  postalCode          String?
  departmentId        String?
  positionId          String?
  managerId           String?
  hireDate            DateTime
  probationEndDate    DateTime?
  contractType        ContractType          @default(FULL_TIME)
  contractEndDate     DateTime?
  workLocation        String?
  baseSalary          Decimal?              @db.Decimal(12, 2)
  currency            String                @default("EGP")
  bankName            String?
  bankAccountNumber   String?
  bankIban            String?
  annualLeaveBalance  Int                   @default(21)
  sickLeaveBalance    Int                   @default(15)
  status              EmployeeStatus        @default(ACTIVE)
  terminationDate     DateTime?
  terminationReason   String?
  emergencyContact    String?
  documents           String?
  notes               String?
  metadata            String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  advanceRequests     AdvanceRequest[]
  attendances         Attendance[]
  benefitEnrollments  BenefitEnrollment[]
  employeeDocuments   EmployeeDocument[]
  employeeTrainings   EmployeeTraining[]
  employeeWarnings    EmployeeWarning[]
  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department          Department?           @relation(fields: [departmentId], references: [id])
  manager             Employee?             @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates        Employee[]            @relation("EmployeeManager")
  position            Position?             @relation(fields: [positionId], references: [id])
  user                User?                 @relation(fields: [userId], references: [id])
  feedbacksGiven      Feedback[]            @relation("FeedbackFrom")
  feedbacksReceived   Feedback[]            @relation("FeedbackTo")
  goals               Goal[]
  lateWarnings        LateWarning[]
  leaveRequests       LeaveRequest[]        @relation("EmployeeLeaves")
  approvedLeaves      LeaveRequest[]        @relation("LeaveApprover")
  permissionRequests  HrPermissionRequest[] @relation("EmployeePermissions")
  approvedPermissions HrPermissionRequest[] @relation("PermissionApprover")
  payrolls            Payroll[]
  performanceReviews  PerformanceReview[]   @relation("EmployeeReviews")
  reviewedReviews     PerformanceReview[]   @relation("ReviewerReviews")
  resignations        Resignation[]
  salaryHistories     SalaryHistory[]
  shiftAssignments    ShiftAssignment[]
  managedDepartments  Department[]          @relation("DepartmentManager")

  @@unique([companyId, employeeNumber])
  @@index([companyId])
  @@index([departmentId])
  @@index([managerId])
  @@index([positionId])
  @@index([status])
  @@map("hr_employees")
}

model Position {
  id               String      @id @default(cuid())
  companyId        String
  departmentId     String?
  title            String
  titleEn          String?
  code             String?
  description      String?
  level            Int         @default(1)
  minSalary        Decimal?    @db.Decimal(12, 2)
  maxSalary        Decimal?    @db.Decimal(12, 2)
  requirements     String?
  responsibilities String?
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  employees        Employee[]
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department       Department? @relation(fields: [departmentId], references: [id])
  promotionsFrom   Promotion[] @relation("PromotionFromPosition")
  promotionsTo     Promotion[] @relation("PromotionToPosition")
  users            User[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([departmentId])
  @@map("hr_positions")
}

model Attendance {
  id                String                    @id @default(cuid())
  companyId         String
  userId            String
  date              DateTime                  @db.Date
  checkIn           DateTime?
  checkOut          DateTime?
  checkInLocation   String?
  checkOutLocation  String?
  checkInMethod     String?
  checkOutMethod    String?
  workHours         Decimal?                  @db.Decimal(5, 2)
  overtimeHours     Decimal?                  @db.Decimal(5, 2)
  lateMinutes       Int?                      @default(0)
  earlyLeaveMinutes Int?                      @default(0)
  status            HrAttendanceStatus        @default(PRESENT)
  isApproved        Boolean                   @default(false)
  approvedBy        String?
  notes             String?
  workMode          String?                   @default("OFFICE")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  employeeRelId     String?
  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeRel       Employee?                 @relation(fields: [employeeRelId], references: [id])
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoCloseAudit    AttendanceAutoCloseAudit?
  goals             Goal[]

  @@unique([userId, date])
  @@index([companyId])
  @@index([date])
  @@index([status])
  @@index([userId])
  @@map("hr_attendances")
}

model AttendanceAutoCloseAudit {
  id                String                          @id @default(cuid())
  companyId         String
  attendanceId      String                          @unique
  userId            String
  attendanceDate    DateTime                        @db.Date
  scheduledCheckOut DateTime?
  autoClosedAt      DateTime?
  reminderSentAt    DateTime?
  autoCloseReason   String?
  autoClosePolicy   String                          @default("SCHEDULED_END_AT_DAY_ROLLOVER")
  reviewStatus      AttendanceAutoCloseReviewStatus @default(PENDING)
  reviewedByUserId  String?
  reviewNotes       String?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  attendance        Attendance                      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  company           Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee          User                            @relation("AttendanceAutoCloseEmployee", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy        User?                           @relation("AttendanceAutoCloseReviewer", fields: [reviewedByUserId], references: [id])

  @@index([attendanceDate])
  @@index([companyId, reviewStatus])
  @@index([companyId, autoClosedAt])
  @@index([userId])
  @@map("hr_attendance_auto_close_audits")
}

model LeaveRequest {
  id                       String                @id @default(cuid())
  companyId                String
  userId                   String
  type                     HrLeaveRequestType
  startDate                DateTime              @db.Date
  endDate                  DateTime              @db.Date
  totalDays                Int
  isHalfDay                Boolean               @default(false)
  halfDayPeriod            String?
  reason                   String?
  attachments              String?
  status                   HrLeaveRequestsStatus @default(PENDING)
  approvedBy               String?
  approvedAt               DateTime?
  rejectionReason          String?
  substituteId             String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  employeeLeaveApproverId  String?
  employeeEmployeeLeavesId String?
  company                  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeEmployeeLeaves   Employee?             @relation("EmployeeLeaves", fields: [employeeEmployeeLeavesId], references: [id])
  employeeLeaveApprover    Employee?             @relation("LeaveApprover", fields: [employeeLeaveApproverId], references: [id])

  @@index([approvedBy])
  @@index([companyId])
  @@index([startDate])
  @@index([status])
  @@index([userId])
  @@map("hr_leave_requests")
}

model HrPermissionRequest {
  id                String             @id @default(cuid())
  companyId         String
  employeeId        String
  type              HrPermissionType
  date              DateTime           @db.Date
  startTime         String // Format HH:mm
  endTime           String // Format HH:mm
  totalHours        Decimal            @db.Decimal(4, 2)
  reason            String
  details           String?
  status            HrPermissionStatus @default(PENDING)
  approvedById      String?
  approvedAt        DateTime?
  rejectionReason   String?
  notes             String?
  attachments       String? // مسار المرفقات المصاحبة للطلب
  isUrgent          Boolean            @default(false)
  isCompensated     Boolean            @default(false)
  compensationDate  DateTime?          @db.Date
  compensationNotes String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee  @relation("EmployeePermissions", fields: [employeeId], references: [id])
  approvedBy Employee? @relation("PermissionApprover", fields: [approvedById], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("hr_permission_requests")
}

model Payroll {
  id                  String          @id @default(cuid())
  companyId           String
  userId              String
  month               Int
  year                Int
  periodStart         DateTime        @db.Date
  periodEnd           DateTime        @db.Date
  baseSalary          Decimal         @db.Decimal(12, 2)
  workingDays         Int             @default(30)
  actualWorkDays      Int             @default(30)
  allowances          String?
  totalAllowances     Decimal         @default(0.00) @db.Decimal(12, 2)
  deductions          String?
  totalDeductions     Decimal         @default(0.00) @db.Decimal(12, 2)
  overtimeHours       Decimal         @default(0.00) @db.Decimal(5, 2)
  overtimeRate        Decimal         @default(1.50) @db.Decimal(3, 2)
  overtimeAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  bonuses             Decimal         @default(0.00) @db.Decimal(12, 2)
  bonusNotes          String?
  socialInsurance     Decimal         @default(0.00) @db.Decimal(12, 2)
  taxAmount           Decimal         @default(0.00) @db.Decimal(12, 2)
  grossSalary         Decimal         @db.Decimal(12, 2)
  netSalary           Decimal         @db.Decimal(12, 2)
  status              HrPayrollStatus @default(DRAFT)
  paidAt              DateTime?
  paymentMethod       String?
  paymentReference    String?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  absentDays          Int             @default(0)
  attendanceDeduction Decimal         @default(0.00) @db.Decimal(10, 2)
  latePenalty         Decimal         @default(0.00) @db.Decimal(12, 2)
  rewardDetails       String?
  rewards             String?
  totalRewards        Decimal         @default(0.00) @db.Decimal(12, 2)
  employeeRelId       String?
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeRel         Employee?       @relation(fields: [employeeRelId], references: [id])

  @@unique([userId, month, year])
  @@index([companyId])
  @@index([month, year])
  @@index([status])
  @@index([userId])
  @@map("hr_payrolls")
}

model PerformanceReview {
  id                        String                     @id @default(cuid())
  companyId                 String
  reviewerId                String
  reviewPeriod              String
  periodStart               DateTime                   @db.Date
  periodEnd                 DateTime                   @db.Date
  overallRating             Decimal                    @db.Decimal(3, 2)
  ratings                   String?
  goals                     String?
  goalsAchievement          Decimal?                   @db.Decimal(5, 2)
  strengths                 String?
  improvements              String?
  reviewerComments          String?
  employeeComments          String?
  recommendations           String?
  status                    HrPerformanceReviewsStatus @default(DRAFT)
  submittedAt               DateTime?
  acknowledgedAt            DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  userId                    String?
  employeeReviewerReviewsId String?
  employeeEmployeeReviewsId String?
  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeEmployeeReviews   Employee?                  @relation("EmployeeReviews", fields: [employeeEmployeeReviewsId], references: [id])
  employeeReviewerReviews   Employee?                  @relation("ReviewerReviews", fields: [employeeReviewerReviewsId], references: [id])

  @@index([companyId])
  @@index([reviewerId])
  @@index([status])
  @@index([userId])
  @@map("hr_performance_reviews")
}

model EmployeeDocument {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  type          String
  fileUrl       String
  fileSize      Int?
  mimeType      String?
  expiryDate    DateTime?
  isVerified    Boolean   @default(false)
  verifiedBy    String?
  verifiedAt    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        String
  employeeRelId String?
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeRel   Employee? @relation(fields: [employeeRelId], references: [id])

  @@index([companyId])
  @@index([type])
  @@index([userId])
  @@map("hr_employee_documents")
}

model SalaryHistory {
  id               String    @id @default(cuid())
  companyId        String
  previousSalary   Decimal   @db.Decimal(12, 2)
  newSalary        Decimal   @db.Decimal(12, 2)
  changeType       String
  changePercentage Decimal?  @db.Decimal(5, 2)
  effectiveDate    DateTime  @db.Date
  reason           String?
  approvedBy       String?
  createdAt        DateTime  @default(now())
  userId           String
  employeeRelId    String?
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeRel      Employee? @relation(fields: [employeeRelId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("hr_salary_history")
}

model EmployeeWarning {
  id               String                @id @default(cuid())
  companyId        String
  type             HrEmployeeWarningType
  severity         String                @default("minor")
  title            String
  description      String
  incidentDate     DateTime              @db.Date
  actionTaken      String?
  issuedBy         String
  acknowledgedAt   DateTime?
  employeeResponse String?
  attachments      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  userId           String?
  employeeRelId    String?
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeRel      Employee?             @relation(fields: [employeeRelId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("hr_employee_warnings")
}

model EmployeeTraining {
  id             String                   @id @default(cuid())
  companyId      String
  trainingName   String
  provider       String?
  type           String
  description    String?
  startDate      DateTime                 @db.Date
  endDate        DateTime?                @db.Date
  duration       Int?
  cost           Decimal?                 @db.Decimal(12, 2)
  currency       String                   @default("EGP")
  status         HrEmployeeTrainingStatus @default(PLANNED)
  completionDate DateTime?
  certificateUrl String?
  score          Decimal?                 @db.Decimal(5, 2)
  feedback       String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  userId         String?
  employeeRelId  String?
  company        Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeRel    Employee?                @relation(fields: [employeeRelId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([userId])
  @@map("hr_employee_training")
}

model Shift {
  id               String            @id @default(cuid())
  companyId        String
  name             String
  startTime        String
  endTime          String
  breakDuration    Int               @default(60)
  color            String?           @default("#3B82F6")
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  shiftAssignments ShiftAssignment[]
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("hr_shifts")
}

model ShiftAssignment {
  id            String    @id @default(cuid())
  companyId     String
  shiftId       String
  date          DateTime  @db.Date
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        String?
  employeeRelId String?
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeRel   Employee? @relation(fields: [employeeRelId], references: [id])
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shiftId, date])
  @@index([companyId])
  @@index([date])
  @@index([shiftId])
  @@index([userId])
  @@map("hr_shift_assignments")
}

model Benefit {
  id                 String              @id @default(cuid())
  companyId          String
  name               String
  description        String?
  type               String
  cost               Decimal?            @db.Decimal(12, 2)
  currency           String              @default("EGP")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  benefitEnrollments BenefitEnrollment[]
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("hr_benefits")
}

model BenefitEnrollment {
  id            String    @id @default(cuid())
  companyId     String
  benefitId     String
  startDate     DateTime  @db.Date
  endDate       DateTime? @db.Date
  status        String    @default("ACTIVE")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        String
  employeeRelId String?
  benefit       Benefit   @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeRel   Employee? @relation(fields: [employeeRelId], references: [id])

  @@index([benefitId])
  @@index([companyId])
  @@index([userId])
  @@map("hr_benefit_enrollments")
}

model Goal {
  id                String               @id @default(cuid())
  companyId         String
  departmentId      String?
  title             String
  description       String?
  goalType          GoalType             @default(COMPANY)
  priority          GoalPriority         @default(MEDIUM)
  targetValue       Decimal              @db.Decimal(12, 2)
  currentValue      Decimal              @default(0.00) @db.Decimal(12, 2)
  unit              String?
  startDate         DateTime             @db.Date
  endDate           DateTime             @db.Date
  goalDate          DateTime?            @db.Date
  status            String               @default("PENDING")
  progress          Int                  @default(0)
  autoGenerateDaily Boolean              @default(false)
  isAutoGenerated   Boolean              @default(false)
  generationSource  GoalGenerationSource @default(MANUAL)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  projectId         String?
  parentGoalId      String?
  attendanceId      String?
  userId            String?
  employeeRelId     String?
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department        Department?          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employeeRel       Employee?            @relation(fields: [employeeRelId], references: [id])
  project           Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentGoal        Goal?                @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)
  childGoals        Goal[]               @relation("GoalHierarchy")
  attendance        Attendance?          @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  tasks             Task[]

  @@index([companyId])
  @@index([departmentId])
  @@index([goalType])
  @@index([projectId])
  @@index([parentGoalId])
  @@index([goalDate])
  @@index([status])
  @@index([attendanceId])
  @@index([userId])
  @@map("hr_goals")
}

model Feedback {
  id                     String    @id @default(cuid())
  companyId              String
  type                   String    @default("PEER")
  category               String?
  content                String
  rating                 Int?
  isAnonymous            Boolean   @default(false)
  status                 String    @default("ACTIVE")
  adminReply             String?
  repliedAt              DateTime?
  repliedById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  fromUserId             String?
  toUserId               String?
  employeeFeedbackToId   String?
  employeeFeedbackFromId String?
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeFeedbackFrom   Employee? @relation("FeedbackFrom", fields: [employeeFeedbackFromId], references: [id])
  employeeFeedbackTo     Employee? @relation("FeedbackTo", fields: [employeeFeedbackToId], references: [id])

  @@index([companyId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([type])
  @@map("hr_feedbacks")
}

model Resignation {
  id                  String               @id @default(cuid())
  companyId           String
  resignationDate     DateTime             @db.Date
  lastWorkingDay      DateTime             @db.Date
  reason              String?
  exitInterview       String?
  status              String               @default("PENDING")
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  actualLastDay       DateTime?            @db.Date
  clearanceCompleted  Boolean              @default(false)
  expectedLastDay     DateTime?            @db.Date
  finalSettlement     Decimal?             @db.Decimal(10, 2)
  noticePeriodDays    Int?
  settlementPaid      Boolean              @default(false)
  userId              String?
  employeeRelId       String?
  clearanceChecklists ClearanceChecklist[]
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeRel         Employee?            @relation(fields: [employeeRelId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([userId])
  @@map("hr_resignations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 📝 Audit Log Enums
// ═══════════════════════════════════════════════════════════════════════════════

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SETTLEMENT
  ASSIGN
  UNASSIGN
  ACTIVATE
  DEACTIVATE
  EXPORT
  IMPORT
  LOGIN
  LOGOUT
  SYNC
  REOPEN
}

enum AuditEntityType {
  LEAVE
  ADVANCE
  ADVANCE_REQUEST
  RESIGNATION
  EMPLOYEE
  DEPARTMENT
  POSITION
  SHIFT
  ATTENDANCE
  PERMISSION_REQUEST
  POLICY
  DEDUCTION
  MANUAL_DEDUCTION
  PAYROLL
  SALARY_UPDATE
  GOAL
  FEEDBACK
  CLEARANCE
  SETTLEMENT
  USER
  COMPANY
  SETTINGS
}

// ═══════════════════════════════════════════════════════════════════════════════
// 📝 Audit Log Model
// ═══════════════════════════════════════════════════════════════════════════════

model HRAuditLog {
  id         String          @id @default(cuid())
  companyId  String
  action     AuditAction
  entityType AuditEntityType
  entityId   String
  actorId    String
  actorName  String
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime        @default(now())
  actor      User            @relation(fields: [actorId], references: [id])
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entityType])
  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, entityType])
  @@index([companyId, action])
  @@index([companyId, createdAt])
  @@map("hr_audit_logs")
}

model HRSettings {
  id                               String   @id @default(cuid())
  companyId                        String   @unique
  workDays                         String   @default("[1,2,3,4,5]")
  annualLeaveDefault               Int      @default(21)
  sickLeaveDefault                 Int      @default(15)
  carryOverLimit                   Int      @default(5)
  maxAdvancePercentage             Float    @default(50)
  maxActiveAdvances                Int      @default(1)
  minMonthsForAdvance              Int      @default(3)
  advanceRepaymentMonths           Int      @default(6)
  noticePeriodDays                 Int      @default(30)
  contractRenewalNoticeDays        Int      @default(30)
  requireClearance                 Boolean  @default(true)
  clearanceItems                   String?
  monthlyLateLimit                 Int      @default(3)
  lateGracePeriod                  Int      @default(15)
  earlyLeaveGracePeriod            Int      @default(15)
  lateWarningThreshold             Int      @default(3)
  lateWarningLevels                String?
  autoDeductionEnabled             Boolean  @default(false)
  gracePeriodMinutes               Int      @default(60)
  lateThresholdMinutes             Int      @default(10)
  maxDailyDeductionDays            Decimal  @default(1.0) @db.Decimal(3, 1)
  earlyCheckoutEnabled             Boolean  @default(true)
  earlyCheckoutThresholdMinutes    Int      @default(0)
  firstViolationMultiplier         Decimal  @default(1.0) @db.Decimal(3, 1)
  secondViolationMultiplier        Decimal  @default(2.0) @db.Decimal(3, 1)
  thirdViolationMultiplier         Decimal  @default(3.0) @db.Decimal(3, 1)
  notifyAtPercentage               Int      @default(75)
  notifyOnDeduction                Boolean  @default(true)
  notifyOnGraceReset               Boolean  @default(true)
  autoCheckoutEnabled              Boolean  @default(true)
  autoCheckoutPolicy               String   @default("SCHEDULED_END_AT_DAY_ROLLOVER")
  autoCheckoutReminderMinutes      Int      @default(30)
  autoCheckoutNotificationsEnabled Boolean  @default(true)
  deductionCalculationMethod       String   @default("minute")
  workingDaysPerMonth              Int      @default(22)
  workingHoursPerDay               Int      @default(8)
  requireDeductionReview           Boolean  @default(true)
  absencePenaltyRate               Decimal  @default(1.0) @db.Decimal(3, 1)
  deductAbsenceInCurrentMonth      Boolean  @default(true)
  delayPenaltyTiers                String?
  geofenceEnabled                  Boolean  @default(false)
  officeLatitude                   Decimal? @db.Decimal(10, 8)
  officeLongitude                  Decimal? @db.Decimal(11, 8)
  geofenceRadius                   Int?     @default(200)
  payrollDay                       Int      @default(25)
  overtimeMinHours                 Decimal  @default(1.0) @db.Decimal(3, 1)
  overtimeRate                     Decimal  @default(1.50) @db.Decimal(3, 2)
  socialInsuranceRate              Decimal  @default(14.00) @db.Decimal(5, 2)
  taxRate                          Decimal  @default(0.00) @db.Decimal(5, 2)
  taxBrackets                      String?
  publicHolidays                   String?
  notifyOnLeaveRequest             Boolean  @default(true)
  notifyOnAttendanceIssue          Boolean  @default(true)
  notifyOnPayrollGeneration        Boolean  @default(true)
  notifyManagers                   Boolean  @default(true)
  notifyOnWarning                  Boolean  @default(true)
  notifyOnProbationEnd             Boolean  @default(true)
  notifyOnContractExpiry           Boolean  @default(true)
  aiOwnerNotificationsEnabled      Boolean  @default(false)
  ownerWhatsAppNumber              String?
  notificationRecipients           String?  @default("[]")
  aiNotificationTypes              String?  @default("[\"PROMOTION\", \"DEDUCTION\", \"WARNING\", \"KUDOS\", \"TRAINING\"]")
  aiNotificationTone               String   @default("PROFESSIONAL")
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
  company                          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("hr_settings")
}

model AdvanceRequest {
  id                String    @id @default(cuid())
  companyId         String
  userId            String?
  amount            Decimal   @db.Decimal(10, 2)
  reason            String
  repaymentType     String
  installmentsCount Int       @default(1)
  monthlyAmount     Decimal   @db.Decimal(10, 2)
  employeeSalary    Decimal?  @db.Decimal(10, 2)
  maxAllowedAmount  Decimal?  @db.Decimal(10, 2)
  installmentAmount Decimal?  @db.Decimal(10, 2)
  remainingBalance  Decimal   @default(0) @db.Decimal(10, 2)
  isPaidOff         Boolean   @default(false)
  status            String    @default("PENDING")
  approvedBy        String?
  approvedAt        DateTime?
  rejectedReason    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  employeeRelId     String?
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
