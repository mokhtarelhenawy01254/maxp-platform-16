    "/attendance/punches/batch": {
      "post": {
        "summary": "Ingest biometric punches",
        "description": "Batch endpoint for biometric devices (e.g. ZKTeco) to upload punches with automatic check-in/out resolution.\n\n**Required Scope:** `hr:attendance:ingest` (or `hr:write`, `*`)",
        "operationId": "hr_ingest_biometric_punches",
        "x-required-scope": "hr:attendance:ingest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "punches"
                ],
                "properties": {
                  "deviceId": {
                    "type": "string",
                    "example": "DEV_MAIN_GATE"
                  },
                  "punches": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "employeeNumber",
                        "punchTime"
                      ],
                      "properties": {
                        "employeeNumber": {
                          "type": "string"
                        },
                        "punchTime": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "CHECK_IN",
                            "CHECK_OUT"
                          ],
                          "default": "CHECK_IN"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Punches processed summary"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
