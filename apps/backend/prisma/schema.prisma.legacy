  isScheduled             Boolean                    @default(false)
  scheduledNotes          String?
  autoTransitionEnabled   Boolean                    @default(true)
  scheduledTransitionedAt DateTime?
  affiliateReferralId     String?                    @unique
  affiliateId             String?
  merchantOrderId         String?                    @unique
  isDropshipped           Boolean                    @default(false)
  orderSource             OrderSource                @default(REGULAR)
  externalId              String?
  createdBy               String?
  createdByName           String?
  userRelId               String?
  statusHistory           OrderStatusHistory[]
  statusChangeRequests    OrderStatusChangeRequest[]
  workflowAuditLogs       OrderWorkflowAuditLog[]
