  callToAction   String?
  landingPageUrl String?
  imageUrl       String?
  videoUrl       String?
  adFormat       String?
  impressions    Int?
  clicks         Int?
  ctr            Decimal? @db.Decimal(5, 3)
  spend          Decimal? @db.Decimal(12, 2)
  lastSeen       DateTime @default(now())
  firstSeen      DateTime @default(now())
  metadata       Json?
  campaignId     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaign CompetitorAdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, platform])
  @@index([campaignId, adType])
  @@map("competitor_ad_creatives")
}

model CompetitorAdIntelligence {
