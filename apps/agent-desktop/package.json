{
  "name": "maxp-agent-studio",
  "version": "1.0.1",
  "description": "MaxP Agent Studio — Dedicated desktop cockpit for AI Agents (Media Buyer, Order Confirmation, Creative Studio)",
  "main": "dist/main/main/main.js",
  "author": "MaxP",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "npx tsc -p tsconfig.main.json --watch",
    "dev:renderer": "npx vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "npx tsc -p tsconfig.main.json",
    "build:renderer": "npx vite build",
    "start": "npx electron dist/main/main/main.js",
    "pack": "npx electron-builder --dir",
    "build:installer": "npx electron-builder --win nsis",
    "dist": "npx electron-builder",
    "dist:win": "npx electron-builder --win"
  },
  "dependencies": {
    "active-win": "^9.0.0",
    "electron-updater": "^6.3.9",
    "axios": "^1.7.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "lucide-react": "^0.460.0"
  },
  "build": {
    "appId": "online.maxp.agent",
    "productName": "MaxP Agent Studio",
    "icon": "assets/icon.ico",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://maxp.online/download/"
    },
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MaxP Agent Studio",
      "artifactName": "MaxP-Agent-Studio-Setup.${ext}",
      "runAfterFinish": true
    }
  }
}
