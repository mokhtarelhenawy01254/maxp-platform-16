  autoAssignOnConfirm  Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("order_confirmation_settings")
}

model OrderAssignment {
  id           String      @id @default(cuid())
  orderId      String?
  guestOrderId String?
  companyId    String
  assignedTo   String
  assignedBy   String?
  assignedAt   DateTime    @default(now())
  strategy     String?
  metadata     String?
  isActive     Boolean     @default(true)
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  guestOrder   GuestOrder? @relation(fields: [guestOrderId], references: [id], onDelete: Cascade)
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([guestOrderId])
  @@index([companyId])
  @@index([companyId, assignedAt])
  @@index([companyId, strategy, assignedAt])
  @@index([assignedTo])
  @@map("order_assignments")
}

// --- From: partner.prisma ---
model PlatformPartner {
  id               String                @id @default(cuid())
  userId           String                @unique
  partnerCode      String                @unique
  companyName      String?
  title            PartnerTitle          @default(PARTNER)
  maxAllowedDepth  Int                   @default(1)
  status           PlatformPartnerStatus @default(PENDING)
  totalEarnings    Decimal               @default(0.00) @db.Decimal(12, 2)
  paidEarnings     Decimal               @default(0.00) @db.Decimal(12, 2)
  pendingEarnings  Decimal               @default(0.00) @db.Decimal(12, 2)
  totalCompanies   Int                   @default(0)
  totalSubPartners Int                   @default(0)
  paymentMethod    PartnerPayoutMethod?
  paymentDetails   String?
  parentPartnerId  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentPartner     PlatformPartner?         @relation("SubPartners", fields: [parentPartnerId], references: [id])
  subPartners       PlatformPartner[]        @relation("SubPartners")
  referredCompanies PartnerReferredCompany[]
  commissions       PartnerCommission[]
  payouts           PartnerPayout[]

  @@index([partnerCode])
  @@index([parentPartnerId])
  @@index([title])
  @@index([status])
  @@map("platform_partners")
}

model PartnerReferredCompany {
  id        String   @id @default(cuid())
  partnerId String
  companyId String   @unique
  joinedAt  DateTime @default(now())
  isActive  Boolean  @default(true)

  partner PlatformPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_referred_companies")
}

model PartnerCommission {
  id               String                  @id @default(cuid())
  partnerId        String
  companyId        String
  billingHistoryId String                  @unique
  amount           Decimal                 @db.Decimal(10, 2)
  level            Int                     @default(1)
  status           PartnerCommissionStatus @default(PENDING)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  partner        PlatformPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  billingHistory BillingHistory  @relation(fields: [billingHistoryId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([companyId])
  @@index([status])
  @@map("partner_commissions")
}

model PartnerPayout {
  id             String              @id @default(cuid())
  partnerId      String
  amount         Decimal             @db.Decimal(10, 2)
  currency       String              @default("EGP")
  status         PartnerPayoutStatus @default(PENDING)
  paymentMethod  PartnerPayoutMethod
  paymentDetails String?
  transactionId  String?
  notes          String?
  processedAt    DateTime?
  processedBy    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  partner PlatformPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@map("partner_payouts")
}

model PlatformPartnerSetting {
  id                  String   @id @default(cuid())
  level1Rate          Float    @default(20)
  level2Rate          Float    @default(5)
  level3Rate          Float    @default(3)
  level4Rate          Float    @default(1)
  minimumPayoutAmount Decimal  @default(100.00) @db.Decimal(10, 2)
  termsAndConditions  String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("platform_partner_settings")
}

// --- From: product_search_log.prisma ---
model ProductSearchLog {
  id                 String   @id @default(uuid())
  companyId          String
  conversationId     String?
  queryText          String
  expandedQuery      String?
  extractedFilters   Json?
  searchWeights      Json?
  resolvedProductIds String[] @default([])
  resultCount        Int      @default(0)
  topScore           Float?   @default(0)
  searchStrategy     String?  @default("hybrid")
  recoveryUsed       Boolean  @default(false)
  recoveryStrategy   String?
  conversionType     String?
  latencyMs          Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
  @@index([conversionType])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("product_search_logs")
}

// --- From: products.prisma ---
model Customer {
  id                             String                          @id @default(cuid())
  firstName                      String
  lastName                       String
  email                          String?
  phone                          String?
  phoneNormalized                String?
  avatar                         String?
  facebookId                     String?
  whatsappId                     String?
  telegramId                     String?
  status                         CustomersStatus                 @default(LEAD)
  tags                           String?
  notes                          String?
  metadata                       String?
  companyId                      String
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  customerRating                 CustomersCustomerRating         @default(UNKNOWN)
  successScore                   Float                           @default(0)
  deliveryRate                   Float                           @default(0)
  totalDelivered                 Int                             @default(0)
  totalOrdersCount               Int                             @default(0)
  activities                     Activity[]
  affiliate_referrals            AffiliateReferral[]
  aiInteractions                 AiInteraction[]
  appointments                   Appointment[]
  blockedCustomersOnPages        BlockedCustomersOnPage[]
  conversationOutcomes           ConversationOutcome[]
  conversations                  Conversation[]
  customerLoyaltyRecords         CustomerLoyaltyRecord[]
  customerNotes                  CustomerNote[]
  customerNotificationPreference CustomerNotificationPreference?
  customerWallets                CustomerWallet?
  blockRules                     CustomerBlockRule[]
  company                        Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders                         Order[]
  returnRequests                 ReturnRequest[]
  whatsAppContacts               WhatsAppContact[]
  whatsapp_notification_logs     WhatsAppNotificationLog[]
  customerJourneys               CustomerJourney[]

  @@unique([facebookId, companyId])
  @@unique([telegramId, companyId])
  @@unique([whatsappId, companyId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([facebookId])
  @@index([status])
  @@map("customers")
}

/// UNUSED - Legacy feature
model BlockedCustomersOnPage {
  id             String       @id @default(cuid())
  facebookPageId String
  pageId         String
  customerId     String
  facebookId     String
  blockedBy      String?
  reason         String?
  blockedAt      DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  metadata       String?
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  facebookPage   FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)

  @@unique([facebookPageId, customerId])
  @@unique([pageId, facebookId])
  @@index([customerId])
  @@index([facebookId])
  @@index([facebookPageId])
  @@index([pageId])
  @@map("blocked_customers_on_page")
}

model CustomerBlockRule {
  id              String    @id @default(cuid())
  companyId       String
  customerId      String?
  phone           String?
  phoneNormalized String?
  email           String?
  emailNormalized String?
  facebookId      String?
  whatsappId      String?
  reasonCode      String    @default("OTHER")
  reasonNote      String?
  action          String    @default("BLOCK_ORDERS")
  status          String    @default("ACTIVE")
  startsAt        DateTime  @default(now())
  expiresAt       DateTime?
  createdBy       String?
  createdByName   String?
  liftedAt        DateTime?
  liftedBy        String?
  liftedByName    String?
  liftedReason    String?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([customerId])
  @@index([phoneNormalized])
  @@index([emailNormalized])
  @@index([facebookId])
  @@index([whatsappId])
  @@index([expiresAt])
  @@map("customer_block_rules")
}

model Category {
  id               String     @id @default(cuid())
  name             String
  description      String?
  image            String?
  parentId         String?
  isActive         Boolean    @default(true)
  sortOrder        Int        @default(0)
  companyId        String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  displayType      String     @default("default")
  metaDescription  String?
  metaTitle        String?
  slug             String?
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category         Category?  @relation("categoriesTocategories", fields: [parentId], references: [id])
  other_categories Category[] @relation("categoriesTocategories")
  products         Product[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

/// UNUSED - Legacy feature
model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  companyId      String
  customerId     String?
  orderId        String?
  discountAmount Decimal  @db.Decimal(10, 2)
  orderAmount    Decimal  @db.Decimal(10, 2)
  usedAt         DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([couponId])
  @@index([customerId])
  @@index([orderId])
  @@index([usedAt])
  @@map("coupon_usages")
}

model Coupon {
  id                String        @id @default(cuid())
  companyId         String
  code              String
  name              String
  description       String?
  type              CouponType    @default(PERCENTAGE)
  value             Decimal       @db.Decimal(10, 2)
  minOrderAmount    Decimal?      @db.Decimal(10, 2)
  maxDiscountAmount Decimal?      @db.Decimal(10, 2)
  usageLimit        Int?
  usageCount        Int           @default(0)
  userUsageLimit    Int?
  validFrom         DateTime
  validTo           DateTime
  isActive          Boolean       @default(true)
  customerSegments  String?
  metadata          String?
  createdBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  couponUsages      CouponUsage[]
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([code])
  @@index([companyId])
  @@index([isActive])
  @@index([validFrom, validTo])
  @@map("coupons")
}

/// UNUSED - Legacy feature
model CustomerList {
  id          String   @id @default(cuid())
  name        String
  description String?
  criteria    String
  count       Int      @default(0)
  isDefault   Boolean  @default(false)
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("customer_lists")
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([customerId])
  @@map("customer_notes")
}

model ProductReview {
  id            String               @id @default(cuid())
  productId     String
  companyId     String
  customerName  String
  customerEmail String?
  customerPhone String?
  rating        Int
  title         String?
  comment       String?
  isVerified    Boolean              @default(false)
  isApproved    Boolean              @default(false)
  helpfulCount  Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  media         ProductReviewMedia[]
  product       Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isApproved])
  @@index([productId])
  @@index([rating])
  @@map("product_reviews")
}

model ProductReviewMedia {
  id        String        @id @default(cuid())
  reviewId  String        @map("review_id")
  companyId String        @map("company_id")
  mediaType String        @map("media_type")
  fileUrl   String        @map("file_url")
  posterUrl String?       @map("poster_url")
  altText   String?       @map("alt_text")
  fileName  String?       @map("file_name")
  mimeType  String?       @map("mime_type")
  fileSize  Int?          @map("file_size")
  createdAt DateTime      @default(now()) @map("created_at")
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([reviewId])
  @@map("product_review_media")
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  name           String
  type           String      @default("color")
  sku            String?
  price          Decimal?    @db.Decimal(10, 2)
  comparePrice   Decimal?    @db.Decimal(10, 2)
  cost           Decimal?    @db.Decimal(10, 2)
  images         String?
  stock          Int         @default(0)
  trackInventory Boolean     @default(true)
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  metadata       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model Product {
  id                         String                    @id @default(cuid())
  name                       String
  description                String?
  sku                        String?
  price                      Decimal                   @db.Decimal(10, 2)
  comparePrice               Decimal?                  @db.Decimal(10, 2)
  cost                       Decimal?                  @db.Decimal(10, 2)
  images                     String?
  mainImage                  String?
  stock                      Int                       @default(0)
  trackInventory             Boolean                   @default(true)
  weight                     Decimal?                  @db.Decimal(8, 2)
  dimensions                 String?
  categoryId                 String?
  isActive                   Boolean                   @default(true)
  isFeatured                 Boolean                   @default(false)
  isHidden                   Boolean                   @default(false)
  tags                       String?
  metadata                   String?
  companyId                  String
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  deletedAt                  DateTime? // سلة المحذوفات - الحذف الناعم
  barcode                    String?
  easyOrdersId               String?
  easyOrdersUrl              String?
  source                     String?                   @default("manual")
  externalId                 String?
  wooCommerceId              String?
  wooCommerceUrl             String?
  hasPromotedAd              Boolean                   @default(false)
  enableCheckoutForm         Boolean                   @default(true)
  showAddToCartButton        Boolean                   @default(true)
  saleStartDate              DateTime?
  saleEndDate                DateTime?
  sizeGuide                  String?
  isPreOrder                 Boolean                   @default(false)
  preOrderDate               DateTime?
  preOrderMessage            String?
  embedding                  String?
  embeddingGeneratedAt       DateTime?
  embeddingImage             String?
  embeddingImageGeneratedAt  DateTime?
  slug                       String?
  isDropshipped              Boolean                   @default(false)
  merchantProductId          String?
  basePrice                  Decimal?                  @db.Decimal(10, 2)
  allowAffiliateMarkup       Boolean                   @default(false)
  affiliateVisibility        String                    @default("ALL")
  affiliateVisibleAffiliateIds String?
  affiliateCommission        Decimal?                  @db.Decimal(10, 2)
  commissionType             String?                   @default("PERCENTAGE")
  affiliate_products         AffiliateProduct[]
  backInStockNotifications   BackInStockNotification[]
  conversion_events          ConversionEvent[]
  facebookCatalogProducts    FacebookCatalogProduct[]
  inventories                Inventory[]
  merchantProducts           MerchantProduct[]
  orderItems                 OrderItem[]
  postResponseSettings       PostResponseSettings[]
  productAnalytics           ProductAnalytic[]
  productLandingPages        ProductLandingPage[]
  productReviews             ProductReview[]
  productVariants            ProductVariant[]
  productVisits              ProductVisit[]
  category                   Category?                 @relation(fields: [categoryId], references: [id])
  company                    Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseInvoiceItems       PurchaseInvoiceItem[]
  purchaseOrderItems         PurchaseOrderItem[]
  recentlyVieweds            RecentlyViewed[]
  stockAlerts                StockAlert[]
  stockMovements             StockMovement[]
  whatsapp_notification_logs WhatsAppNotificationLog[]
  wishlists                  Wishlist[]

  showFakeStock Boolean @default(false)

  facebookPosts FacebookPost[]

  @@unique([companyId, sku])
  @@unique([companyId, slug])
  @@index([categoryId])
  @@index([companyId])
  @@index([sku])
  @@index([wooCommerceId])
  @@index([externalId])
  @@map("products")
}

model Wishlist {
  id         String   @id @default(cuid())
  sessionId  String
  customerId String?
  productId  String
  variantId  String?
  companyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId, variantId, companyId])
  @@index([companyId])
  @@index([customerId])
  @@index([productId])
  @@index([sessionId])
  @@map("wishlists")
}

model CustomerWallet {
  id           String              @id @default(cuid())
  customerId   String              @unique
  companyId    String
  balance      Float               @default(0)
  totalEarned  Float               @default(0)
  totalSpent   Float               @default(0)
  currency     String              @default("EGP")
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id])
  transactions WalletTransaction[]

  @@index([companyId])
  @@map("customer_wallets")
}

model CustomerLoyaltyProgram {
  id                      String                        @id @default(cuid())
  companyId               String
  name                    String
  nameAr                  String?
  description             String?
  type                    CustomerLoyaltyProgramType    @default(POINTS)
  status                  CustomerLoyaltyProgramsStatus @default(DRAFT)
  pointsPerPurchase       Decimal                       @default(1.00) @db.Decimal(10, 2)
  pointsPerReferral       Decimal                       @default(10.00) @db.Decimal(10, 2)
  pointsPerAmount         Decimal?                      @db.Decimal(10, 2)
  redemptionRate          Decimal                       @default(100.00) @db.Decimal(10, 2)
  minimumPoints           Decimal                       @default(100.00) @db.Decimal(10, 2)
  maxPointsPerTransaction Decimal?                      @db.Decimal(10, 2)
  expiryMonths            Int                           @default(12)
  rules                   String?
  createdBy               String
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  company                 Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerLoyaltyRecords  CustomerLoyaltyRecord[]
  customerLoyaltyTiers    CustomerLoyaltyTier[]

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@map("customer_loyalty_programs")
}

model CustomerLoyaltyRecord {
  id                     String                       @id @default(cuid())
  companyId              String
  customerId             String
  programId              String
  tierId                 String?
  currentPoints          Decimal                      @default(0.00) @db.Decimal(10, 2)
  totalEarned            Decimal                      @default(0.00) @db.Decimal(10, 2)
  totalRedeemed          Decimal                      @default(0.00) @db.Decimal(10, 2)
  status                 CustomerLoyaltyRecordsStatus @default(ACTIVE)
  joinDate               DateTime                     @default(now())
  lastActivity           DateTime                     @default(now())
  lastPointsEarned       DateTime?
  lastPointsRedeemed     DateTime?
  metadata               String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  company                Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer               Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerLoyaltyProgram CustomerLoyaltyProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  customerLoyaltyTier    CustomerLoyaltyTier?         @relation(fields: [tierId], references: [id])

  @@unique([customerId, programId])
  @@index([companyId])
  @@index([customerId])
  @@index([lastActivity])
  @@index([programId])
  @@index([status])
  @@index([tierId])
  @@map("customer_loyalty_records")
}

model CustomerLoyaltyTier {
  id                     String                  @id @default(cuid())
  companyId              String
  programId              String
  name                   String
  nameAr                 String?
  minPoints              Decimal                 @db.Decimal(10, 2)
  maxPoints              Decimal?                @db.Decimal(10, 2)
  benefits               String?
  color                  String                  @default("#6366f1")
  icon                   String                  @default("crown")
  priority               Int                     @default(1)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  customerLoyaltyRecords CustomerLoyaltyRecord[]
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerLoyaltyProgram CustomerLoyaltyProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([minPoints])
  @@index([programId])
  @@map("customer_loyalty_tiers")
}

model CustomerNotificationPreference {
  id            String    @id @default(cuid())
  companyId     String
  customerId    String    @unique
  phone         String
  orderUpdates  Boolean   @default(true)
  promotions    Boolean   @default(false)
  backInStock   Boolean   @default(true)
  priceDrops    Boolean   @default(true)
  abandonedCart Boolean   @default(true)
  isOptedIn     Boolean   @default(true)
  optedInAt     DateTime  @default(now())
  optedOutAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([companyId, customerId])
  @@unique([companyId, phone])
  @@map("customer_notification_preferences")
}

model MerchantOrder {
  id                String               @id @default(cuid())
  merchantId        String
  orderId           String
  merchantOrderId   String?
  status            MerchantOrdersStatus @default(PENDING)
  items             String
  totalAmount       Decimal              @db.Decimal(10, 2)
  shippingAddress   String?
  trackingNumber    String?
  fulfillmentSource String               @default("MERCHANT")
  warehouseId       String?
  shippingCompanyId String?
  syncedAt          DateTime?
  fulfilledAt       DateTime?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  merchant          Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipments         Shipment[]

  @@unique([merchantId, orderId])
  @@index([merchantId])
  @@index([orderId])
  @@index([status])
  @@index([fulfillmentSource])
  @@index([warehouseId])
  @@index([shippingCompanyId])
  @@map("merchant_orders")
}

model MerchantProduct {
  id            String    @id @default(cuid())
  merchantId    String
  productId     String
  merchantSku   String?
  merchantPrice Decimal   @db.Decimal(10, 2)
  stock         Int       @default(0)
  isActive      Boolean   @default(true)
  syncEnabled   Boolean   @default(true)
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([merchantId, productId])
  @@index([merchantId])
  @@index([productId])
  @@map("merchant_products")
}

model Merchant {
  id                       String            @id @default(cuid())
  companyId                String
  name                     String
  email                    String            @unique
  phone                    String?
  address                  String?
  isActive                 Boolean           @default(true)
  commissionRate           Float             @default(10)
  autoFulfill              Boolean           @default(false)
  fulfillmentMode          String            @default("MERCHANT")
  defaultWarehouseId       String?
  defaultShippingCompanyId String?
  apiKey                   String?           @unique
  webhookUrl               String?
  settings                 String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  company                  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  commissions              Commission[]
  merchant_payouts         MerchantPayout[]
  merchantOrders           MerchantOrder[]
  merchantProducts         MerchantProduct[]
  shipments                Shipment[]
  warehouses               Warehouse[]

  @@index([companyId])
  @@index([isActive])
  @@index([fulfillmentMode])
  @@index([defaultWarehouseId])
  @@index([defaultShippingCompanyId])
}

model Shipment {
  id                     String           @id @default(cuid())
  companyId              String
  orderId                String?
  merchantOrderId        String?          @unique
  merchantId             String?
  fulfillmentSource      String           @default("MERCHANT")
  warehouseId            String?
  shippingCompanyId      String?
  carrierType            String           @default("MANUAL")
  status                 String           @default("PENDING")
  trackingNumber         String?
  externalShipmentId     String?
  labelUrl               String?
  serviceLevel           String?
  cost                   Decimal?         @db.Decimal(10, 2)
  currency               String           @default("EGP")
  destinationGovernorate String?
  destinationCity        String?
  destinationAddress     String?
  metadata               String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order                  Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchantOrder          MerchantOrder?   @relation(fields: [merchantOrderId], references: [id], onDelete: Cascade)
  merchant               Merchant?        @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  warehouse              Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  shippingCompany        ShippingCompany? @relation(fields: [shippingCompanyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([orderId])
  @@index([merchantId])
  @@index([fulfillmentSource])
  @@index([warehouseId])
  @@index([shippingCompanyId])
  @@index([status])
  @@map("shipments")
}

model ProductVisit {
  id          String   @id @default(cuid())
  productId   String
  companyId   String
  sessionId   String
  visitedAt   DateTime @default(now())
  duration    Int?
  source      String?
  addedToCart Boolean  @default(false)
  purchased   Boolean  @default(false)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, visitedAt])
  @@index([sessionId, companyId])
  @@map("product_visits")
}

/// UNUSED - Planned feature for return management
model ReturnReasonCategory {
  id            String                            @id @default(cuid())
  name          String
  defaultRole   ReturnReasonCategoriesDefaultRole @default(OTHER)
  isActive      Boolean                           @default(true)
  createdAt     DateTime                          @default(now())
  updatedAt     DateTime                          @updatedAt
  companyId     String
  company       Company                           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  returnReasons ReturnReason[]

  @@index([companyId])
  @@map("return_reason_categories")
}

model ShippingMethod {
  id           String       @id @default(cuid())
  zoneId       String
  type         String       @default("flat_rate")
  title        String
  isEnabled    Boolean      @default(true)
  settings     String?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  shippingZone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([isEnabled])
  @@index([zoneId])
  @@map("shipping_methods")
}

// --- From: recruitment.prisma ---
model JobPosting {
  id               String            @id @default(cuid())
  companyId        String
  title            String
  department       String
  location         String
  type             ContractType      @default(FULL_TIME)
  experienceLevel  String?
  salaryMin        Decimal?          @db.Decimal(12, 2)
  salaryMax        Decimal?          @db.Decimal(12, 2)
  description      String
  requirements     String?
  responsibilities String?
  status           String            @default("ACTIVE")
  closingDate      DateTime?
  postedDate       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applicants       Applicant[]
  recruitmentForms RecruitmentForm[]

  @@index([companyId])
  @@map("hr_job_postings")
}

model Applicant {
  id             String                   @id @default(cuid())
  companyId      String
  jobId          String
  formResponseId String?                  @unique
  name           String
  email          String?
  phone          String?
  resumeUrl      String?
  coverLetter    String?
  experience     Int?
  education      String?
  skills         String?
  notes          String?
  status         String                   @default("NEW")
  rating         Int?                     @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  company        Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job            JobPosting               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  formResponse   RecruitmentFormResponse? @relation(fields: [formResponseId], references: [id], onDelete: SetNull)
  interviews     Interview[]

  @@index([companyId])
  @@index([jobId])
  @@map("hr_applicants")
}

model Interview {
  id           String    @id @default(cuid())
  companyId    String
  applicantId  String
  jobId        String
  date         DateTime
  time         String
  type         String    @default("IN_PERSON")
  location     String?
  interviewers String?
  notes        String?
  status       String    @default("SCHEDULED")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([applicantId])
  @@map("hr_interviews")
}

model RecruitmentForm {
  id          String                    @id @default(cuid())
  companyId   String
  jobId       String?
  title       String
  slug        String?                   @unique
  description String?
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         JobPosting?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  questions   RecruitmentFormQuestion[]
  responses   RecruitmentFormResponse[]

  @@index([companyId])
  @@index([jobId])
  @@map("hr_recruitment_forms")
}

model RecruitmentFormQuestion {
  id           String                  @id @default(cuid())
  formId       String
  questionText String
  questionType String // TEXT, TEXTAREA, SELECT, RADIO, CHECKBOX, FILE
  options      String? // JSON string or comma-separated for SELECT, RADIO, CHECKBOX
  isRequired   Boolean                 @default(false)
  orderIndex   Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  form         RecruitmentForm         @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers      RecruitmentFormAnswer[]

  @@index([formId])
  @@map("hr_recruitment_form_questions")
}

model RecruitmentFormResponse {
  id              String                  @id @default(cuid())
  formId          String
  respondentName  String
  respondentEmail String?
  respondentPhone String?
  isContacted     Boolean                 @default(false)
  contactedAt     DateTime?
  submittedAt     DateTime                @default(now())
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  form            RecruitmentForm         @relation(fields: [formId], references: [id], onDelete: Cascade)
  applicant       Applicant?
  answers         RecruitmentFormAnswer[]

  @@index([formId])
  @@map("hr_recruitment_form_responses")
}

model RecruitmentFormAnswer {
  id         String                  @id @default(cuid())
  responseId String
  questionId String
  answerText String?
  answerFile String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  response   RecruitmentFormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   RecruitmentFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([questionId])
  @@map("hr_recruitment_form_answers")
}

// --- From: returns.prisma ---
model ReturnReason {
  id                   String                @id @default(cuid())
  reason               String
  description          String?
  companyId            String
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  categoryId           String?
  returnReasonCategory ReturnReasonCategory? @relation(fields: [categoryId], references: [id])
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  returnRequests       ReturnRequest[]

  @@index([categoryId])
  @@index([companyId])
  @@map("return_reasons")
}

model ReturnRequest {
  id                    String                         @id @default(cuid())
  orderId               String
  customerId            String
  companyId             String
  reasonId              String
  status                ReturnRequestsStatus           @default(PENDING)
  adminNotes            String?
  customerNotes         String?
  refundAmount          Decimal?                       @db.Decimal(10, 2)
  assignedTo            String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  isReviewed            Boolean                        @default(false)
  orderItemId           String?
  rejectionReason       String?
  trackingNumber        String?
  receivedStatus        ReturnReceivedStatus            @default(PENDING_RECEIVE)
  receivedAt            DateTime?
  productCondition      String?
  shippingReturnCost    Decimal?                       @db.Decimal(10, 2)
  settlementAmount      Decimal?                       @db.Decimal(10, 2)
  responsibleParty      ReturnRequestsResponsibleParty @default(OTHER)
  returnTypeId          String?
  shippingCompanyId     String?
  reviewedAt            DateTime?
  reviewedBy            String?
  returnActivityLogs    ReturnActivityLog[]
  returnContactAttempts ReturnContactAttempt[]
  assignedUser          User?                          @relation(fields: [assignedTo], references: [id])
  company               Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer              Customer                       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order                 Order                          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnReason          ReturnReason                   @relation(fields: [reasonId], references: [id])
  returnType            ReturnType?                    @relation(fields: [returnTypeId], references: [id], onDelete: SetNull)
  shippingCompany       ShippingCompany?               @relation(fields: [shippingCompanyId], references: [id], onDelete: SetNull)

  @@unique([companyId, orderId])
  @@index([assignedTo])
  @@index([companyId])
  @@index([customerId])
  @@index([orderId])
  @@index([reasonId])
  @@index([status])
  @@index([trackingNumber])
  @@index([returnTypeId])
  @@index([shippingCompanyId])
  @@map("return_requests")
}

model ReturnContactAttempt {
  id              String        @id @default(cuid())
  returnRequestId String
  userId          String
  method          String
  result          String
  notes           String?
  createdAt       DateTime      @default(now())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id])

  @@index([returnRequestId])
  @@index([userId])
  @@map("return_contact_attempts")
}

model ReturnActivityLog {
  id              String        @id @default(cuid())
  returnRequestId String
  userId          String?
  action          String
  details         String?
  createdAt       DateTime      @default(now())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id])

  @@index([returnRequestId])
  @@index([userId])
  @@map("return_activity_logs")
}

model CallAttemptLog {
  id           String      @id @default(cuid())
  orderId      String?
  guestOrderId String?
  userId       String
  result       String?
  notes        String?
  createdAt    DateTime    @default(now())
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  guestOrder   GuestOrder? @relation(fields: [guestOrderId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([guestOrderId])
  @@index([userId])
  @@map("call_attempt_logs")
}

// --- From: sentMessageSummary.prisma ---
model SentMessageDailySummary {
  id                   String   @id @default(cuid())
  companyId            String
  facebookPageId       String?
  date                 DateTime
  totalSent            Int      @default(0)
  totalSaved           Int      @default(0)
  totalIgnored         Int      @default(0)
  totalRevenue         Decimal  @default(0) @db.Decimal(10, 2)
  orderCount           Int      @default(0)
  conversationsCreated Int      @default(0)
  conversationsExisted Int      @default(0)
  uniqueReach          Int      @default(0)
  savedReach           Int      @default(0)
  ignoredReach         Int      @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, facebookPageId, date])
  @@index([companyId, date])
  @@map("sent_message_daily_summaries")
}

