# Database Configuration
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/communication_platform"

# Direct Postgres connection for migrations (Prisma directUrl).
# Should ALWAYS point at Postgres directly (NOT through PgBouncer) so that
# `prisma db push` / migrate DDL runs on a real connection. When PgBouncer is
# NOT enabled, set DIRECT_URL to the same value as POSTGRES_URL.
DIRECT_URL="postgresql://postgres:postgres123@localhost:5432/communication_platform"

# 🔌 Optional: PgBouncer (transaction pooling) for the runtime Prisma client.
# When set, the backend routes ALL runtime queries through the pooler while
# migrations keep using DIRECT_URL. Set PG_BOUNCER_PREPARED=1 only if your
# PgBouncer is 1.21+ with server-side prepared statements configured.
# PG_BOUNCER_URL="postgresql://appuser:password@localhost:6432/maxp"
# PG_BOUNCER_PREPARED=0

# Redis Configuration
REDIS_URL="redis://localhost:6379"
    
    
# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Server Configuration
NODE_ENV="development"
PORT=3007
CORS_ORIGIN="https://www.mokhtarelhenawy.online"

# Facebook Graph API
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_VERIFY_TOKEN="your-webhook-verify-token"

# ⚠️ LEGACY — AI keys are read from the database (ai_keys table) only.
# Do NOT add AI keys here. The dental-lab scan parser (and other AI features)
# resolve keys from ai_keys via the DB. This var is no longer referenced by code.
# GOOGLE_GEMINI_API_KEY="your-google-gemini-api-key"

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@yourcompany.com"
FROM_NAME="Communication Platform"

# SMS Configuration (Twilio example)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="your-twilio-phone-number"

# Payment Gateways
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox" # sandbox or live

# File Upload Configuration
MAX_FILE_SIZE=10485760 # 10MB in bytes
UPLOAD_PATH="./uploads"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,application/pdf,text/plain"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET="your-session-secret-key"
SESSION_MAX_AGE=86400000 # 24 hours in milliseconds

# Logging
LOG_LEVEL="info" # error, warn, info, debug
LOG_FILE="./logs/app.log"

# Monitoring
SENTRY_DSN="your-sentry-dsn-for-error-tracking"

# Webhook URLs
WEBHOOK_BASE_URL="https://www.mokhtarelhenawy.online/webhooks"

# Company Settings
DEFAULT_COMPANY_PLAN="basic"
MAX_USERS_PER_COMPANY=10
MAX_CONVERSATIONS_PER_MONTH=1000

# AI Settings
AI_RESPONSE_TIMEOUT=600000 # 30 seconds
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# WhatsApp Business API (Meta Cloud API)
# For Baileys (unofficial) — no env vars needed (auth stored in DB per-session)
# For Meta Cloud API (official) — configure these:
META_WA_ACCESS_TOKEN=your-meta-whatsapp-access-token
META_WA_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
META_WA_WABA_ID=your-whatsapp-business-account-id
META_WA_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
META_WA_APP_SECRET=your-app-secret-for-webhook-signature
META_GRAPH_API_VERSION=v25.0

# AI Service Integration (maxp-ai-service)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-me-with-shared-secret-token
# off | shadow | pilot | primary
AI_SERVICE_MODE=off
# Use explicit company IDs in pilot mode. Wildcard is honored only in primary mode.
AI_SERVICE_ENABLED_COMPANIES=

# Telegram Alerts Configuration (for critical system events like WhatsApp disconnects)
TELEGRAM_ALERT_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_ADMIN_CHAT_ID="your-telegram-admin-chat-id"
TELEGRAM_ALERT_CHAT_IDS=""
TELEGRAM_ALERT_BOT_CONFIG_ID=""
TELEGRAM_ALERT_COMPANY_ID=""
TELEGRAM_ALERT_USERBOT_CONFIG_ID=""
TELEGRAM_ALERT_USERBOT_COMPANY_ID=""

# Telegram Alerts Configuration (for critical system events like WhatsApp disconnects)
TELEGRAM_ALERT_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_ADMIN_CHAT_ID="your-telegram-admin-chat-id"
# Optional: comma-separated extra admin chat IDs or database target selectors
TELEGRAM_ALERT_CHAT_IDS=""
TELEGRAM_ALERT_BOT_CONFIG_ID=""
TELEGRAM_ALERT_COMPANY_ID=""
TELEGRAM_ALERT_USERBOT_CONFIG_ID=""
TELEGRAM_ALERT_USERBOT_COMPANY_ID=""


# TikTok for Developers (Login Kit + Content Posting + Display API)
# Create an app at https://developers.tiktok.com -> portal and use these values.
# company-level overrides can also be stored per company in the tiktok_settings table.
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
# Public redirect URL registered in the TikTok app (must match exactly)
TIKTOK_REDIRECT_URI="https://your-domain.com/api/v1/tiktok/auth/callback"

# TikTok Events API (server-side conversion tracking fallback)
TIKTOK_EVENTS_API_ENDPOINT="https://business-api.tiktok.com/open_api/v1.3/event/track/"
TIKTOK_EVENTS_ACCESS_TOKEN="your-tiktok-events-access-token"
TIKTOK_EVENTS_PIXEL_ID="your-tiktok-pixel-id"

# TikTok Business Messaging (Beta, requires approved TikTok Business Account + scope)
# Global fallbacks; per-company values are stored in tiktok_settings / tiktok_business_accounts.
TIKTOK_MESSAGING_API_BASE="https://business-api.tiktok.com"
TIKTOK_MESSAGING_SEND_ENDPOINT="https://business-api.tiktok.com/open_api/v1.3/message/send/"
TIKTOK_WEBHOOK_SECRET=""
TIKTOK_WEBHOOK_VERIFY_TOKEN=""


