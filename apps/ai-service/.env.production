# ============================================
# MaxP AI Service - Production Configuration
# ============================================
# Copy this file to the server as `/opt/maxp-ai-service/.env`
# AI_SERVICE_TOKEN must match the backend's AI_SERVICE_TOKEN

APP_NAME=maxp-ai-service
VERSION=0.2.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://appuser:mokhtar1234@localhost:5432/maxp_ai

MAXP_API_URL=http://localhost:3007
MAXP_SERVICE_TOKEN=dev-token

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

DEFAULT_LLM_PROVIDER=google
DEFAULT_MODEL=gemma-4-31b-it

AGENTS_TEMPLATES_ROOT=/app/agents

CORS_ORIGINS=

OTLP_ENDPOINT=
SENTRY_DSN=
