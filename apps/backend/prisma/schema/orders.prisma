  discount                Decimal                   @default(0.00) @db.Decimal(10, 2)
  total                   Decimal                   @db.Decimal(10, 2)
  currency                String                    @default("EGP")
  notes                   String?
  shippingAddress         String?
  billingAddress          String?
  customerName            String?
  customerPhone           String?
  customerEmail           String?
