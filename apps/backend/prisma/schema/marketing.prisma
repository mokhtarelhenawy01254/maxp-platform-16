/// Isolated Facebook Ads OAuth connection source — one per Facebook personal account
/// that granted ads permissions (business_management, ads_management, ads_read).
/// Stores the token separately from Messenger/page tokens so ads reconnects
/// never touch Company.facebookUserAccessToken or FacebookPage.pageAccessToken.
model FacebookAdsConnectionSource {
  id                String    @id @default(cuid())
  companyId         String
  facebookUserId    String
  facebookUserName  String?
  facebookUserEmail String?
  accessToken       String?
  status            String    @default("connected")
  connectedByUserId String?
  connectedAt       DateTime  @default(now())
  lastSyncedAt      DateTime?
  lastError         String?
  metadata          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adAccounts        FacebookAdAccount[]

  @@unique([companyId, facebookUserId])
  @@index([companyId])
  @@index([status])
  @@map("facebook_ads_connection_sources")
}

/// Facebook page OAuth connection source — one per Facebook personal account
/// that granted Messenger/page permissions. Stores the user access token per
/// account so pages from different Facebook accounts can be linked to the same
/// company and refreshed independently. Page OAuth is the only flow that writes
/// rows here; it never overwrites another account's token.
model FacebookAccountConnection {
  id                String       @id @default(cuid())
  companyId         String
  facebookUserId    String
  facebookUserName  String?
  facebookUserEmail String?
  accessToken       String?
  status            String       @default("connected")
  connectedByUserId String?
  connectedAt       DateTime     @default(now())
  lastSyncedAt      DateTime?
  lastError         String?
  metadata          String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facebookPages     FacebookPage[]

  @@unique([companyId, facebookUserId])
  @@index([companyId])
  @@index([status])
  @@map("facebook_account_connections")
}

