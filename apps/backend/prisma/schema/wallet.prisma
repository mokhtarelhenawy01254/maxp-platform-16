model CompanyWallet {
  id                     String              @id @default(cuid())
  companyId              String              @unique
  balance                Decimal             @default(0) @db.Decimal(12, 2)
  availableForRemittance Decimal             @default(0) @db.Decimal(12, 2)
  upcomingRemittance     Decimal             @default(0) @db.Decimal(12, 2)
  currency               String              @default("EGP")
  totalSpent             Decimal             @default(0) @db.Decimal(12, 2)
  totalDeposited         Decimal             @default(0) @db.Decimal(12, 2)
  updatedAt              DateTime            @updatedAt

  company                Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions           Transaction[]
  walletTransactions     CompanyWalletTransaction[]

  @@map("company_wallets")
}

model Transaction {
  id          String        @id @default(cuid())
  walletId    String
  amount      Decimal       @db.Decimal(12, 2)
  type        String
  status      String        @default("COMPLETED")
  description String?
  referenceId String?
  createdAt   DateTime      @default(now())

  wallet      CompanyWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("transactions")
}

model CompanyWalletTransaction {
  id           String         @id @default(cuid())
  companyId    String
  walletId     String?
  type         String         // DEPOSIT | WITHDRAW
  reason       String         // COD_COLLECTED | SETTLEMENT_PAYOUT | PRINT_FEE | OPEN_PACKAGE_FEE | ADJUSTMENT | COMMISSION_PAYOUT
  code         String?        // رقم الشحنة/الكشف
  amount       Decimal        @db.Decimal(12, 2)
  balanceAfter Decimal        @db.Decimal(12, 2)
  notes        String?
  createdBy    String?
  createdAt    DateTime       @default(now())

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  wallet       CompanyWallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, reason])
  @@index([companyId, code])
  @@map("company_wallet_transactions")
}
