// Dental Lab module - dentists, work types, technicians, cases, invoices
model DentalLabDoctor {
  id          String   @id @default(cuid())
  companyId   String?
  name        String
  phone       String?
  clinicName  String?
  governorate String?
  portalPin   String?   // doctor login PIN (portal)
  creditLimit Float    @default(0)
  notes       String?
  doctors     Json?    // قائمة أطباء العيادة: [{ id, name, phone, specialty }]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases              DentalLabCase[]
  invoices           DentalInvoice[]
  monthlySettlements DentalMonthlySettlement[]

  @@index([companyId])
  @@index([phone])
  @@map("dental_lab_doctors")
}

model DentalWorkType {
  id                   String   @id @default(cuid())
  companyId            String?
  name                 String
  category             String?   // تلبيس | جسر | طقم | زراعة | تجميلي | أخرى
  pricingMode          String   @default("PER_UNIT") // PER_UNIT | FLAT
  price                Float    @default(0) // سعر الكراون/الوحدة أو السعر الثابت
  costPrice            Float?   @default(0) // تكلفة المواد الخام التقديرية للمعمل
  leadTimeDays         Int      @default(5)
  urgentLeadTimeDays   Int?     // مدة التسليم للمستعجل (null => حسب نسبة الاستعجال في السياسة)
  defaultMaterial      String?  // خامة افتراضية
  materialBrand        String?  // ماركة أو شركة الخامة المعتمدة
  instructions         String?  // إرشادات التحضير والملاحظات الفنية
  defaultWarrantyYears Int?     @default(0)
  defaultCrownCount    Int?     @default(1)
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  cases          DentalLabCase[]
  boms           DentalWorkTypeBOM[]
  stageTemplates WorkTypeStageTemplate[]

  @@index([companyId])
  @@map("dental_work_types")
}

model DentalTechnician {
  id           String   @id @default(cuid())
  companyId    String?
  userId       String?  // رابط لحساب المنصة (المستخدم بدور TECHNICIAN)
  name         String
  phone        String?
  role         String   @default("GENERAL_TECHNICIAN") // CAD_DESIGNER | CERAMIST | MODEL_WAX | METAL_CASTING | FINISHING_POLISHING | QC_INSPECTOR | RECEPTION_LOGISTICS | SUPERVISOR | GENERAL_TECHNICIAN
  wagePerStage       Float?   // أجر الفني عن كل مرحلة مكتملة (null => المعدل الافتراضي)
  workingDays        Json?    // e.g. [0, 1, 2, 3, 4, 6] (أيام العمل)
  vacations          Json?    // قائمة الإجازات الاستثنائية [{ startDate, endDate, reason }]
  dailyCap           Int?     @default(0) // سقف الإسناد اليومي (0 = غير محدود)
  backupTechnicianId String?  // الفني الاحتياطي المفضل
  isActive           Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments      DentalCaseAssignment[]
  payouts          DentalTechnicianPayout[]
  stageAssignments DentalStageAssignee[]

  @@index([companyId])
  @@index([userId])
  @@map("dental_technicians")
}

model DentalLabCase {
  id            String    @id @default(cuid())
  companyId     String?
  caseNumber    String             // DL-YYYYMMDD-XXXX (فريد لكل شركة)
  doctorId      String?
  doctorName    String?
  patientName   String?
  patientPhone  String?
  workTypeId    String?
  workTypeName  String?
  unitsCount    Int?      @default(1) // عدد الكراونات / الوحدات
  unitPrice     Float?    @default(0) // سعر الكراون الواحد
  teeth         String?   // e.g. "11,12"
  shade         String?   // A1/B2...
  material      String?   // زيركون | إيماكس | برسلين
  lotNumber     String?   // رقم تشغيلة الخامة (Zirconia / e.max disc lot #)
  materialBrand String?   // ماركة الخامة (e.g. Katana Zirconia, Ivoclar e.max)
  warrantyYears Int?      @default(0) // سنوات الضمان للمريض
  isTryIn       Boolean   @default(false) // هل الحالة حالياً في بروفة
  tryInStage    String?   // نوع البروفة (COPING | WAX | BISQUE | FRAMEWORK)
  tryInCount    Int       @default(0) // عدد مرات خروج ودخول البروفة
  status        String    @default("RECEIVED") // RECEIVED | DESIGN | MANUFACTURING | QC | READY | DELIVERED | CLOSED
  orderStatus   String    @default("PENDING") // PENDING | CHECKED_IN | IN_PROGRESS | COMPLETED | CANCELLED
  priority      String    @default("NORMAL") // NORMAL | URGENT | STAT
  dueDate       DateTime?
  receivedDate  DateTime  @default(now())
  deliveredAt   DateTime?
  source        String    @default("MANUAL") // MANUAL | PHONE | PORTAL | WHATSAPP
  priceSnapshot Float     @default(0)
  discount      Float     @default(0)
  total         Float     @default(0)
  paid          Float     @default(0)
  remaining     Float     @default(0)
  paymentStatus String    @default("UNPAID") // UNPAID | PARTIAL | PAID
  notes              String?
  externalLabName    String?
  externalLabContact String?
  outsourceCost      Float?    @default(0)
  outsourcedAt       DateTime?
  expectedReturnAt   DateTime?
  returnedAt         DateTime?
  outsourceNotes     String?
  isDeleted          Boolean   @default(false)
  deletedAt     DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  doctor      DentalLabDoctor?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  workType    DentalWorkType?    @relation(fields: [workTypeId], references: [id], onDelete: SetNull)
  stages         DentalCaseStage[]
  assignments    DentalCaseAssignment[]
  stageAssignees DentalStageAssignee[]
  attachments    DentalCaseAttachment[]
  invoices    DentalInvoice[]
  customValues DentalCaseCustomValue[]
  history     DentalCaseStatusHistory[]
  qualityChecks DentalQualityCheck[]
  refabrications DentalRefabrication[]
  creditNotes  DentalCreditNote[]
  materialUsages DentalCaseMaterialUsage[]

  @@index([companyId])
  @@index([companyId, isDeleted])
  @@index([status])
  @@index([doctorId])
  @@unique([companyId, caseNumber])
  @@index([companyId, workTypeId, status])
  @@index([companyId, dueDate, status])
  @@index([receivedDate])
  @@map("dental_lab_cases")
}

model DentalCaseStage {
  id           String    @id @default(cuid())
  companyId    String?
  caseId       String
  name         String
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | DONE
  assigneeId   String?   // scalar DentalTechnician id
  assigneeName String?
  note         String?
  startedAt    DateTime?
  completedAt  DateTime?
  sortOrder    Int       @default(0)
  requiredRole String?   // دور الفني المطلوب (null => GENERAL_TECHNICIAN)
  stageWage    Float?    @default(0) // أجر المرحلة المخصص من القالب (0 أو null => أجر الفني الافتراضي)
  slaHours     Int?      @default(24) // المدة المحددة للمرحلة بالساعات
  isRequired   Boolean   @default(true) // هل المرحلة إلزامية في مسار الإنتاج
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  case      DentalLabCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignees DentalStageAssignee[]

  @@index([companyId])
  @@index([caseId])
  @@index([assigneeId, status])
  @@map("dental_case_stages")
}

model DentalCaseAssignment {
  id           String   @id @default(cuid())
  companyId    String?
  caseId       String
  technicianId String
  role         String   @default("TECHNICIAN")
  assignedAt   DateTime @default(now())

  case      DentalLabCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  technician DentalTechnician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([caseId])
  @@index([technicianId])
  @@map("dental_case_assignments")
}

model DentalStageAssignee {
  id             String    @id @default(cuid())
  companyId      String?
  caseId         String
  stageId        String
  technicianId   String
  technicianName String?
  role           String    @default("PRIMARY") // PRIMARY | ASSISTANT | QC | FINISHER | CAD | OTHER
  sharePercent   Float     @default(100)       // نسبة مساهمة/أجر الفني في المرحلة (100%, 50%, ...)
  notes          String?
  assignedAt     DateTime  @default(now())

  case       DentalLabCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stage      DentalCaseStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  technician DentalTechnician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([stageId, technicianId])
  @@index([companyId])
  @@index([caseId])
  @@index([technicianId])
  @@index([stageId])
  @@map("dental_stage_assignees")
}

model DentalCaseAttachment {
  id         String   @id @default(cuid())
  companyId  String?
  caseId     String
  uploadedBy String?   // userId or "doctor:<id>"
  kind       String   @default("SCAN") // SCAN | PHOTO | WORK_ORDER | OTHER
  fileName   String
  storedPath String
  mimeType   String?
  size       Int      @default(0)
  createdAt  DateTime @default(now())

  case DentalLabCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([caseId])
  @@map("dental_case_attachments")
}

model DentalInvoice {
  id            String    @id @default(cuid())
  companyId     String?
  invoiceNumber String    // INV-DL-YYYYMMDD-XXXX
  caseId        String?
  doctorId      String?
  doctorName    String?
  total         Float     @default(0)
  discount      Float     @default(0)
  paid          Float     @default(0)
  remaining     Float     @default(0)
  status        String    @default("OPEN") // OPEN | PARTIAL | PAID | VOID
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  case     DentalLabCase?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  doctor   DentalLabDoctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  payments DentalPayment[]

  @@unique([companyId, invoiceNumber])
  @@unique([companyId, caseId])
  @@index([companyId])
  @@index([caseId])
  @@index([doctorId])
  @@map("dental_invoices")
}

model DentalPayment {
  id        String   @id @default(cuid())
  companyId String?
  invoiceId String
  amount    Float    @default(0)
  method    String?  // CASH | CARD | BANK | VODAFONE_CASH | OTHER
  note      String?
  paidBy    String?
  createdAt DateTime @default(now())

  invoice DentalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invoiceId])
  @@map("dental_payments")
}

model DentalCustomFieldDef {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  fieldType String   @default("TEXT") // TEXT | NUMBER | SELECT | DATE
  options   Json?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values DentalCaseCustomValue[]

  @@index([companyId])
  @@map("dental_custom_field_defs")
}

model DentalCaseCustomValue {
  id        String  @id @default(cuid())
  companyId String?
  caseId    String
  fieldId   String
  value     String?

  case  DentalLabCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  field DentalCustomFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([caseId, fieldId])
  @@index([companyId])
  @@map("dental_case_custom_values")
}

model DentalCaseStatusHistory {
  id        String   @id @default(cuid())
  companyId String?
  caseId    String
  dimension String   @default("STAGE") // STAGE | ORDER | PAYMENT
  status    String
  oldStatus String?
  changedBy String?
  userName  String?
  reason    String?
  createdAt DateTime @default(now())

  case DentalLabCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([caseId])
  @@map("dental_case_status_histories")
}

model DentalSetting {
  id        String   @id @default(cuid())
  companyId String?
  key       String
  value     Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, key])
  @@index([companyId])
  @@map("dental_settings")
}

model DentalCreditNote {
  id             String   @id @default(cuid())
  companyId      String?
  caseId         String
  doctorId       String?
  doctorName     String?
  amount         Float    @default(0)
  reason         String?
  createdBy      String?
  createdByName  String?
  createdAt      DateTime @default(now())

  case DentalLabCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([companyId, caseId])
  @@index([companyId])
  @@index([caseId])
  @@map("dental_credit_notes")
}

model DentalQualityCheck {
  id           String   @id @default(cuid())
  companyId    String?
  caseId       String
  checkedBy    String?
  checkedByName String?
  passed       Boolean  @default(true)
  notes        String?
  checkedAt    DateTime @default(now())

  case DentalLabCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([companyId, caseId])
  @@map("dental_quality_checks")
}

model DentalRefabrication {
  id            String    @id @default(cuid())
  companyId     String?
  caseId        String
  reason            String
  rootCauseCategory String?   @default("OTHER") // DOCTOR_IMPRESSION | DOCTOR_SHADE | LAB_MILLING | LAB_PORCELAIN | LAB_MARGIN | PATIENT_CHANGE | OTHER
  isBillable        Boolean   @default(false)
  stageFrom         String    @default("DESIGN") // RECEIVED | DESIGN | MANUFACTURING | QC | READY
  status            String    @default("OPEN") // OPEN | RESOLVED
  createdBy         String?
  createdByName     String?
  resolvedBy        String?
  resolvedNote      String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  case DentalLabCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([companyId, caseId])
  @@map("dental_refabrications")
}

model DentalTechnicianPayout {
  id            String   @id @default(cuid())
  companyId     String?
  technicianId  String
  type          String   @default("PAYOUT") // PAYOUT | ADVANCE | BONUS | DEDUCTION
  amount        Float    @default(0)
  paymentMethod String   @default("CASH") // CASH | BANK_TRANSFER | WALLET | CHECK | OTHER
  reference     String?  // رقم الإيصال / الحوالة / السند
  notes         String?  // بيان / ملاحظات
  paidAt        DateTime @default(now())
  createdBy     String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  technician DentalTechnician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([technicianId])
  @@index([companyId, paidAt])
  @@map("dental_technician_payouts")
}

model DentalMonthlySettlement {
  id               String    @id @default(cuid())
  companyId        String?
  doctorId         String
  doctorName       String?
  year             Int
  month            Int
  periodKey        String    // e.g. "2026-08"
  openingBalance   Float     @default(0) // الرصيد الافتتاحي المرحل من إغلاق الشهر السابق
  totalBilled      Float     @default(0) // إجمالي فواتير الشهر
  totalPaid        Float     @default(0) // إجمالي المسدد خلال الشهر
  totalAdjustments Float     @default(0) // إجمالي الخصومات ومذكرات الائتمان
  closingBalance   Float     @default(0) // الرصيد الختامي المرحل للشهر التالي
  casesCount       Int       @default(0)
  invoicesCount    Int       @default(0)
  status           String    @default("CLOSED") // CLOSED | DRAFT | REOPENED
  notes            String?
  closedBy         String?
  closedByName     String?
  closedAt         DateTime  @default(now())
  reopenedAt       DateTime?
  reopenedBy       String?
  reopenedReason   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  doctor DentalLabDoctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([companyId, doctorId, periodKey])
  @@index([companyId])
  @@index([doctorId])
  @@index([companyId, periodKey])
  @@map("dental_monthly_settlements")
}

model DentalMaterial {
  id               String   @id @default(cuid())
  companyId        String?
  name             String
  category         String   @default("MILLING_DISC") // MILLING_DISC | MILLING_BLOCK | IMPLANT_PART | CONSUMABLE | TOOL_BUR
  brand            String?
  supplierId       String?
  supplierName     String?
  defaultShade     String?
  unitName         String   @default("قرص")
  standardCapacity Int      @default(20)
  costPerItem      Float    @default(0)
  costPerUnit      Float    @default(0)
  minStockAlert    Int      @default(2)
  isActive         Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stocks       DentalMaterialStock[]
  usages       DentalCaseMaterialUsage[]
  workTypeBOMs DentalWorkTypeBOM[]

  @@index([companyId])
  @@index([companyId, category])
  @@index([companyId, isActive])
  @@map("dental_materials")
}

model DentalMaterialStock {
  id             String    @id @default(cuid())
  companyId      String?
  materialId     String
  lotNumber      String
  shade          String?
  thicknessMm    Float?
  diameterMm     Float?    @default(98)
  initialUnits   Int       @default(20)
  remainingUnits Int       @default(20)
  unitCost       Float     @default(0)
  totalCost      Float     @default(0)
  supplierId     String?
  supplierName   String?
  purchaseDate   DateTime  @default(now())
  expiryDate     DateTime?
  isDepleted     Boolean   @default(false)
  depletedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  material DentalMaterial            @relation(fields: [materialId], references: [id], onDelete: Cascade)
  usages   DentalCaseMaterialUsage[]

  @@index([companyId])
  @@index([materialId])
  @@index([companyId, isDepleted])
  @@index([lotNumber])
  @@map("dental_material_stocks")
}

model DentalCaseMaterialUsage {
  id             String   @id @default(cuid())
  companyId      String?
  caseId         String
  materialId     String
  stockId        String?
  lotNumber      String?
  materialName   String
  unitsUsed      Int      @default(1)
  costRecorded   Float    @default(0)
  notes          String?
  recordedBy     String?
  recordedByName String?
  recordedAt     DateTime @default(now())

  case     DentalLabCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  material DentalMaterial       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  stock    DentalMaterialStock? @relation(fields: [stockId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([caseId])
  @@index([materialId])
  @@index([stockId])
  @@map("dental_case_material_usages")
}

model DentalWorkTypeBOM {
  id            String   @id @default(cuid())
  companyId     String?
  workTypeId    String
  materialId    String
  unitsRequired Int      @default(1)
  estimatedCost Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workType DentalWorkType @relation(fields: [workTypeId], references: [id], onDelete: Cascade)
  material DentalMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([workTypeId, materialId])
  @@index([companyId])
  @@index([workTypeId])
  @@index([materialId])
  @@map("dental_work_type_boms")
}

model WorkTypeStageTemplate {
  id           String         @id @default(cuid())
  companyId    String?
  workTypeId   String
  name         String
  sortOrder    Int            @default(0)
  requiredRole String         @default("GENERAL_TECHNICIAN")
  stageWage    Float?         @default(0)
  isRequired   Boolean        @default(true)
  slaHours     Int?           @default(24)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workType     DentalWorkType @relation(fields: [workTypeId], references: [id], onDelete: Cascade)

  @@unique([workTypeId, sortOrder])
  @@index([companyId])
  @@index([workTypeId])
  @@map("work_type_stage_templates")
}