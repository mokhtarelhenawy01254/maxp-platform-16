{
  "id": "legacy-default-old",
  "name": "defalut-theme-old",
  "description": "Classic department-store storefront with local photo merchandising, simple collection pages, and an intentional LTR shopping flow.",
  "direction": "ltr",
  "tokens": {
    "colors": {
      "primary": "0 0% 7%",
      "primaryForeground": "0 0% 100%",
      "secondary": "0 0% 96%",
      "secondaryForeground": "0 0% 7%",
      "accent": "42 92% 68%",
      "accentForeground": "0 0% 7%",
      "background": "0 0% 100%",
      "foreground": "0 0% 7%",
      "muted": "0 0% 95%",
      "mutedForeground": "0 0% 40%",
      "border": "0 0% 88%",
      "card": "0 0% 100%",
      "cardForeground": "0 0% 7%",
      "ring": "0 0% 7%"
    },
    "typography": {
      "headingFont": "\"League Spartan\", \"Arial\", sans-serif",
      "bodyFont": "\"League Spartan\", \"Arial\", sans-serif",
      "baseSize": "16px",
      "direction": "ltr"
