/// Booking module - Medical center branches
model BookingBranch {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  address     String?
  phone       String?
  phones      Json?    /// List of phone numbers: ["01234567890","02-1234567"]
  workingDays Json?    /// Working hours per day: {"sat":"3-9","sun":"12-9",...}
  genderDays  Json?    /// Gender day mapping: {"male":["sat","mon","wed"],"female":["sun","tue","thu"]}
  location      String?  /// Location description or coordinates
  landmarkImage String?  /// Landmark image (base64)
  facilityType  String   @default("clinic") /// clinic | medical_center | hospital | polyclinic | dental | cosmetic
  maxBookingsPerSlot Int      @default(1) /// Max appointments allowed per time slot
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  doctors     BookingDoctor[]
  branchServices BookingBranchService[]
  appointments Appointment[]

  @@index([companyId])
  @@map("booking_branches")
}

/// Booking module - Doctors
model BookingDoctor {
  id              String     @id @default(cuid())
  companyId       String
  branchId        String
  title           String     /// e.g. "دكتور", "أخصائي"
  name            String?    /// Doctor's full name
  specialty       String?    /// Specialty: "علاج طبيعي", "عظام", etc.
  phone           String?
  gender          Gender?
  email           String?
  password        String?    /// Hashed password for doctor portal login
  employeeId      String?    /// Optional link to HR Employee
  consultationFee Float?
  commissionRate  Float?
  bio             String?
  avatarUrl       String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          BookingBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  assignedAppointments Appointment[] @relation("AssignedDoctor")
  availability    DoctorAvailability[]
  doctorServices  BookingDoctorService[]

  @@index([companyId])
  @@index([branchId])
  @@map("booking_doctors")
}

/// Booking module - Doctor working availability (per weekday)
model DoctorAvailability {
  id          String    @id @default(cuid())
  companyId   String
  doctorId    String
  dayOfWeek   Int       /// 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime   String    /// HH:mm
  endTime     String    /// HH:mm
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  doctor      BookingDoctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([doctorId])
  @@map("doctor_availability")
}

/// Booking module - Service template (shared across branches)
model BookingService {
  id                   String   @id @default(cuid())
  companyId            String
  name                 String
  description          String?
  requiresConsultation Boolean  @default(true) /// Needs doctor assessment first
  durationMinutes      Int      @default(30) /// Default appointment duration in minutes
  basePrice            Float?   /// Default price for the service (EGP)
  imageUrl             String?  /// Service image
  categoryId           String?  /// Optional service category/department
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category             BookingServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  branchServices       BookingBranchService[]
  doctorServices       BookingDoctorService[]
  appointments         Appointment[]
  priceListItems       PriceListItem[]

  @@index([companyId])
  @@map("booking_services")
}

/// Per-branch service config (pricing, availability)
model BookingBranchService {
  id          String   @id @default(cuid())
  serviceId   String
  branchId    String
  hasPackages Boolean  @default(true)
  packages    Json?    /// Array of packages: [{"count":3,"price":500,"originalPrice":750},...]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service BookingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch  BookingBranch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([serviceId, branchId])
  @@index([branchId])
  @@map("booking_branch_services")
}

/// Booking module - Service categories/departments (e.g. Urology, Dental)
model BookingServiceCategory {
  id        String    @id @default(cuid())
  companyId String
  name      String
  color     String?   /// Hex color for badges
  icon      String?   /// Icon name/emoji
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  services  BookingService[]

  @@index([companyId])
  @@map("booking_service_categories")
}

/// Booking module - Doctor-to-service link (which doctors provide which services)
model BookingDoctorService {
  id        String    @id @default(cuid())
  companyId String
  doctorId  String
  serviceId String
  fee       Float?    /// Doctor-specific price override for this service
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  doctor    BookingDoctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service   BookingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([doctorId, serviceId])
  @@index([serviceId])
  @@map("booking_doctor_services")
}

/// Multi-turn booking drafts - agent collects fields one at a time
model BookingDraft {
  id              String    @id @default(cuid())
  companyId       String
  branchId        String?
  doctorId        String?
  serviceId       String?
  customerName    String?
  customerPhone   String?
  customerGender  String?
  appointmentDate DateTime? @db.Date
  startTime       String?
  notes           String?
  status          String    @default("in_progress") /// in_progress | ready | completed | expired
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([expiresAt])
  @@map("booking_drafts")
}

/// Booking module - Patient medical file (may link to a CRM Customer booker)
model Patient {
  id              String    @id @default(cuid())
  patientNo       Int?      /// Sequential patient number per company (starts at 1)
  companyId       String
  customerId      String?   /// Optional link to CRM Customer (booker/contact person)
  firstName       String
  lastName        String?
  phone           String?
  email           String?
  password        String?   /// Hashed password for patient portal login
  gender          Gender?
  nationalId      String?   /// National ID (الرقم القومي)
  nationalIdImage String?   /// National ID card image (base64 or URL)
  address         String?   /// Patient address
  birthDate       DateTime? @db.Date
  bloodType       String?
  allergies       Json?     /// List: ["penicillin","dust"]
  chronicDiseases Json?     /// List: ["diabetes","hypertension"]
  medications     Json?     /// List: ["aspirin 81mg daily"]
  notes           String?
  isActive        Boolean   @default(true)
  /// Clinic record enhancements (adapted from RIS)
  status               String?   @default("ACTIVE") /// ACTIVE|INACTIVE|REVIEW
  source               String?   /// referral source: whatsapp/facebook/web/dashboard/physician
  maritalStatus        String?   /// SINGLE|MARRIED|DIVORCED|WIDOW
  occupation           String?
  city                 String?
  medicalHistory       Json?     /// Structured health questionnaire: {"conditions":[{"code","label","checked"}],"allergies":[...]}
  referringPhysicianId String?
  priceListId          String?
  mergedIntoId         String?
  /// Insurance & contact enhancements (adapted from external RIS)
  title                String?
  insuranceNumber      String?
  insuranceCompanyId   String?
  memberTypeId         String?
  homePhone            String?
  workPhone            String?
  fax                  String?
  postalCode           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  referringPhysician ReferringPhysician? @relation(fields: [referringPhysicianId], references: [id], onDelete: SetNull)
  priceList       PriceList?  @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  insuranceCompany InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id], onDelete: SetNull)
  memberType      InsuranceMemberType? @relation(fields: [memberTypeId], references: [id], onDelete: SetNull)
  mergedInto      Patient?    @relation("PatientMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedPatients  Patient[]   @relation("PatientMerge")
  documents       PatientDocument[]
  appointments    Appointment[]
  invoices        MedicalInvoice[]

  @@index([companyId])
  @@index([customerId])
  @@index([phone])
  @@index([referringPhysicianId])
  @@index([priceListId])
  @@index([insuranceCompanyId])
  @@index([memberTypeId])
  @@index([companyId, patientNo])
  @@map("patients")
}

/// Booking module - Invoice for a patient/appointment
model MedicalInvoice {
  id            String          @id @default(cuid())
  companyId     String
  invoiceNumber String
  patientId     String
  appointmentId String?
  total         Float
  discount      Float           @default(0)
  amountPaid    Float           @default(0)
  status        String          @default("UNPAID") /// UNPAID | PARTIAL | PAID | REFUNDED
  dueDate       DateTime?       @db.Date
  notes         String?
  /// Clinic billing enhancements (adapted from RIS)
  discountReason    String?
  additionAmount    Float          @default(0)
  additionReason    String?
  insuranceAmount   Float          @default(0)
  expenseSplit      String         @default("PATIENT") /// PATIENT|INSURANCE|BOTH
  insuranceCompanyId String?
  ticketNumber      String?
  cashierId         String?
  cashierName       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  payments      MedicalPayment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
  @@index([insuranceCompanyId])
  @@map("medical_invoices")
}

/// Booking module - Payment records against an invoice
model MedicalPayment {
  id          String          @id @default(cuid())
  companyId   String
  invoiceId   String
  amount      Float
  method      String          @default("CASH") /// CASH | CARD | CREDIT | VODAFONE_CASH | PAYMOB | INSTAPAY | FAWRY | VOUCHER | REFERRAL
  paidAt      DateTime        @default(now())
  notes       String?
  /// Billing enhancements
  reason            String?   /// Discount / payback reason
  paybackOfPaymentId String?
  cashierName       String?
  createdById String?
  createdAt   DateTime        @default(now())
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice     MedicalInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invoiceId])
  @@map("medical_payments")
}

/// Referring physicians / referral sources for clinic patients
model ReferringPhysician {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  specialty String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patients  Patient[]

  @@index([companyId])
  @@map("referring_physicians")
}

/// Contract price lists (Base + per-entity lists inherited from Base)
model PriceList {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  baseListId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  baseList    PriceList?  @relation("BasePriceList", fields: [baseListId], references: [id], onDelete: SetNull)
  derivedLists PriceList[] @relation("BasePriceList")
  items       PriceListItem[]
  patients    Patient[]
  insuranceCompanies InsuranceCompany[]

  @@index([companyId])
  @@map("price_lists")
}

/// Price override per service inside a price list
model PriceListItem {
  id          String   @id @default(cuid())
  priceListId String
  serviceId   String
  price       Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  priceList   PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  service     BookingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([priceListId, serviceId])
  @@index([serviceId])
  @@map("price_list_items")
}

/// Cashier shifts for daily cash reconciliation
model CashierShift {
  id             String    @id @default(cuid())
  companyId      String
  cashierId      String
  cashierName    String
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingBalance Float     @default(0)
  closingBalance Float?
  status         String    @default("OPEN") /// OPEN|CLOSED
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([cashierId])
  @@map("cashier_shifts")
}

/// Barcode / tube label printing tracking per exam
model ExamLabel {
  id            String   @id @default(cuid())
  companyId     String
  appointmentId String
  patientId     String?
  labelType     String   @default("EXAM") /// EXAM|ENVELOPE
  printedAt     DateTime @default(now())
  printedBy     String?
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([appointmentId])
  @@map("exam_labels")
}

/// Report delivery tracking (handing results to patient)
model ReportDelivery {
  id            String   @id @default(cuid())
  companyId     String
  appointmentId String
  patientId     String?
  status        String   @default("NOT_READY") /// NOT_READY|READY|DELIVERED
  deliveredAt   DateTime?
  deliveredBy   String?
  paidStatus    String?  /// PAID|UNPAID|PARTIAL
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([appointmentId])
  @@map("report_deliveries")
}

/// Unified audit log for clinic money / record movements
model TransactionLog {
  id          String   @id @default(cuid())
  companyId   String
  entityType  String   /// PATIENT|INVOICE|PAYMENT|PAYBACK|APPOINTMENT
  entityId    String
  action      String   /// CREATE|UPDATE|PAYMENT|PAYBACK|DISCOUNT|ADJUSTMENT|MERGE
  description String?
  amount      Float?
  payer       String?
  userId      String?
  userName    String?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("transaction_logs")
}

/// Insurance companies (managed entities, each bound to a price list)
model InsuranceCompany {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  priceListId   String?
  phone1        String?
  fax           String?
  contactName   String?
  contactPhone  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceList     PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  patients      Patient[]

  @@index([companyId])
  @@index([priceListId])
  @@map("insurance_companies")
}

/// Insurance member types (family roles + coverage %)
model InsuranceMemberType {
  id              String   @id @default(cuid())
  companyId       String
  name            String   /// Member|Husband|Wife|Children|10%...
  coveragePercent Float    @default(0) /// 0-100 insurance coverage
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patients        Patient[]

  @@index([companyId])
  @@map("insurance_member_types")
}

/// Patient documents (prescriptions, images, videos, insurance, others)
model PatientDocument {
  id           String   @id @default(cuid())
  companyId    String
  patientId    String
  documentType String   @default("OTHER") /// DRIVING_LICENSE|INSURANCE|PRESCRIPTION|IMAGE|VIDEO|OTHER
  name         String?
  fileData     String?  /// base64 data URL or URL
  mimeType     String?
  notes        String?
  uploadedBy   String?
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([patientId])
  @@map("patient_documents")
}
