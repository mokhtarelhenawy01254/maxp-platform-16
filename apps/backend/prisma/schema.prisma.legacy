  authorName      String?
  authorUrl       String?
  profilePhotoUrl String?
  rating          Int
  content         String?   @db.Text
  responseContent String?   @db.Text
  responseDate    DateTime?
  publishedAt     DateTime?
  lastScrapedAt   DateTime  @default(now())
  sentiment       String?
  metadata        Json?
  googleDataId    String
  createdAt       DateTime  @default(now())

  googleData CompetitorGoogleBusiness @relation(fields: [googleDataId], references: [id], onDelete: Cascade)

  @@index([googleDataId])
  @@index([googleDataId, publishedAt])
  @@map("competitor_google_reviews")
}

model CompetitorTechStack {
  id           String   @id @default(cuid())
  category     String
  name         String
  version      String?
  confidence   String?
  detectedAt   DateTime @default(now())
  metadata     Json?
  competitorId String
  companyId    String
  createdAt    DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, category, name])
  @@index([competitorId])
  @@index([companyId])
  @@index([competitorId, category])
  @@map("competitor_tech_stack")
}

model CompetitorShopifyStore {
  id            String    @id @default(cuid())
  storeUrl      String    @unique
  storeName     String?
  description   String?   @db.Text
  logoUrl       String?
  facebookUrl   String?
  instagramUrl  String?
  twitterUrl    String?
  currency      String?
  country       String?
  productsCount Int?
  themes        Json?
  appsCount     Int?
  lastScrapedAt DateTime?
  metadata      Json?
  competitorId  String
  companyId     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([companyId])
  @@map("competitor_shopify_stores")
}

// --- From: competitors_social.prisma ---
model CompetitorSocialProfile {
  id             String    @id @default(cuid())
  platform       String    @default("instagram")
  platformUserId String?
  username       String?
  displayName    String?
  bio            String?
  profileImage   String?
  profileUrl     String?
  followersCount Int       @default(0)
  followingCount Int       @default(0)
  postsCount     Int       @default(0)
  engagementRate Decimal?  @db.Decimal(5, 2)
  avgLikes       Int?
  avgComments    Int?
  isVerified     Boolean   @default(false)
  isPrivate      Boolean   @default(false)
  lastScrapeAt   DateTime?
  metadata       Json?
  companyId      String
  competitorId   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  competitor    Competitor                @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  socialPosts   CompetitorSocialPost[]
  socialMetrics CompetitorSocialMetrics[]
  sentiments    CompetitorSentiment[]

  @@unique([competitorId, platform])
  @@index([competitorId])
  @@index([companyId])
  @@map("competitor_social_profiles")
}

model CompetitorSocialPost {
  id             String    @id @default(cuid())
  platform       String    @default("instagram")
  postId         String?
  postType       String    @default("post")
  content        String?   @db.Text
  caption        String?   @db.Text
  mediaUrl       String?
  mediaType      String?
  thumbnailUrl   String?
  videoUrl       String?
  permalink      String?
  hashtags       String[]
  mentions       String[]
  likesCount     Int       @default(0)
  commentsCount  Int       @default(0)
  sharesCount    Int       @default(0)
  viewsCount     Int       @default(0)
  savesCount     Int       @default(0)
  engagementRate Decimal?  @db.Decimal(5, 2)
  publishedAt    DateTime?
  scrapedAt      DateTime  @default(now())
  metadata       Json?
  profileId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile CompetitorSocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, publishedAt])
  @@index([profileId, postType])
  @@map("competitor_social_posts")
}

model CompetitorSocialMetrics {
  id             String   @id @default(cuid())
  platform       String   @default("instagram")
  metricDate     DateTime @default(now())
  followersCount Int
  followingCount Int?
  postsCount     Int?
  engagementRate Decimal? @db.Decimal(5, 2)
  avgLikes       Int?
  avgComments    Int?
  avgViews       Int?
  totalLikes     Int?
  totalComments  Int?
  totalShares    Int?
  metadata       Json?
  profileId      String
  createdAt      DateTime @default(now())

  profile CompetitorSocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, metricDate])
  @@index([profileId])
  @@index([profileId, metricDate])
  @@map("competitor_social_metrics")
}

model CompetitorSentiment {
  id            String   @id @default(cuid())
  platform      String
  sentiment     String   @default("neutral")
  score         Decimal? @db.Decimal(3, 2)
  positiveCount Int      @default(0)
  negativeCount Int      @default(0)
  neutralCount  Int      @default(0)
  topic         String?
  aspect        String?
  periodStart   DateTime
  periodEnd     DateTime
  metadata      Json?
  profileId     String
  companyId     String
  createdAt     DateTime @default(now())

  profile CompetitorSocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([companyId])
  @@index([profileId, sentiment])
  @@map("competitor_sentiments")
}

// --- From: competitors.prisma ---
model Competitor {
  id          String   @id @default(cuid())
  name        String
  slug        String
  url         String?
  platform    String   @default("manual")
  logo        String?
  description String?
  notes       String?
  isActive    Boolean  @default(true)
  status      String   @default("NEW")
  metadata    Json?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company            Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products           CompetitorProduct[]
  ads                CompetitorAd[]
  reports            CompetitorReport[]
  socialProfiles     CompetitorSocialProfile[]
  amazonData         CompetitorAmazonData[]
  googleBusiness     CompetitorGoogleBusiness[]
  techStack          CompetitorTechStack[]
  shopifyStores      CompetitorShopifyStore[]
  adCampaigns        CompetitorAdCampaign[]
  adIntelligence     CompetitorAdIntelligence[]
  features           CompetitorFeature[]
  devRecommendations CompetitorDevRecommendation[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([companyId, isActive])
  @@map("competitors")
}

model CompetitorProduct {
  id           String   @id @default(cuid())
  name         String
  slug         String?
  price        Decimal? @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2)
  currency     String   @default("EGP")
  image        String?
  url          String?
  sku          String?
  barcode      String?
  isAvailable  Boolean  @default(true)
  category     String?
  description  String?
  metadata     Json?
  firstSeen    DateTime @default(now())
  lastSeen     DateTime @default(now())
  competitorId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competitor   Competitor               @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  priceHistory CompetitorPriceHistory[]

  @@index([competitorId])
  @@index([competitorId, sku])
  @@index([competitorId, isAvailable])
  @@index([competitorId, lastSeen])
  @@map("competitor_products")
}

model CompetitorPriceHistory {
  id         String   @id @default(cuid())
  price      Decimal  @db.Decimal(10, 2)
  currency   String   @default("EGP")
  recordedAt DateTime @default(now())
  notes      String?
  productId  String
  createdAt  DateTime @default(now())

  product CompetitorProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, recordedAt])
  @@map("competitor_price_history")
}

model CompetitorAd {
  id             String   @id @default(cuid())
  platform       String   @default("facebook")
  adId           String?
  creativeUrl    String?
  copy           String?
  headline       String?
  cta            String?
  destinationUrl String?
  status         String   @default("active")
  firstSeen      DateTime @default(now())
  lastSeen       DateTime @default(now())
  metadata       Json?
  competitorId   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([competitorId, platform])
  @@index([competitorId, status])
  @@map("competitor_ads")
}

model CompetitorReport {
  id           String    @id @default(cuid())
  type         String    @default("weekly")
  title        String
  summary      String    @db.Text
  insights     Json?
  data         Json?
  periodStart  DateTime?
  periodEnd    DateTime?
  generatedAt  DateTime  @default(now())
  competitorId String
  companyId    String
  createdAt    DateTime  @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, generatedAt(sort: Desc)])
  @@map("competitor_reports")
}

