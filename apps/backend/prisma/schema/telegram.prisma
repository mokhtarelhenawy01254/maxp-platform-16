model TelegramConfig {
  id            String   @id @default(cuid())
  companyId     String
  botToken      String?
  botName       String?
  botUsername   String?
  apiId         String?
  apiHash       String?
  isActive      Boolean  @default(false)
  clientSession String?
  clientPhone   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  label         String   @default("Official Bot")
  sessionString     String?
  tempAuthSession   String?  @map("temp_auth_session")
  tempPhoneCodeHash String?  @map("temp_phone_code_hash")
  type              String   @default("BOT")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  autoReplyRules      TelegramAutoReplyRule[]
  bulkMessages        TelegramBulkMessage[]
  forwardRules        TelegramForwardRule[]

  @@index([companyId])
  @@index([type])
  @@map("telegram_configs")
}

model TelegramScheduledMessage {
  id               String    @id @default(cuid())
  userbotConfigId  String
  companyId        String
  chatId           String
  message          String    @db.Text
  mediaUrl         String?
  mediaType        String?
  scheduledTime    DateTime
  status           String    @default("PENDING") // PENDING, SENT, FAILED, CANCELLED
  sentAt           DateTime?
  error            String?   @db.Text
  recurring        Boolean   @default(false)
  recurringPattern String?
  createdBy        String?
  campaignId       String?   // FK to TelegramCampaign

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign TelegramCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userbotConfigId])
  @@index([companyId])
  @@index([campaignId])
  @@map("telegram_scheduled_messages")
}

model TelegramCampaign {
  id              String   @id @default(cuid())
  companyId       String
  userbotConfigId String
  name            String
  description     String?  @db.Text
  message         String   @db.Text
  scheduledTime   DateTime
  status          String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
  totalCount      Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  createdBy       String?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TelegramScheduledMessage[]

  @@index([companyId])
  @@index([userbotConfigId])
  @@map("telegram_campaigns")
}

model TelegramAutoReplyRule {
  id               String  @id @default(cuid())
  userbotConfigId  String
  companyId        String
  isActive         Boolean @default(true)
  priority         Int     @default(0)
  response         String  @db.Text
  triggerType      String // KEYWORD, REGEX, ALL
  triggerValue     String  @db.Text
  workingHoursOnly Boolean @default(false)
  startTime        String? // "09:00"
  endTime          String? // "17:00"
  daysOfWeek       Json? // Array of Int [0-6]
  maxUsesPerUser   Int?
  cooldownMinutes  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userbotConfig TelegramConfig @relation(fields: [userbotConfigId], references: [id], onDelete: Cascade)

  @@index([userbotConfigId])
  @@index([companyId])
  @@map("telegram_auto_reply_rules")
}

model TelegramAutoReplyUsage {
  id     String   @id @default(cuid())
  ruleId String
  userId String
  usedAt DateTime @default(now())

  @@index([ruleId])
  @@index([userId])
  @@map("telegram_auto_reply_usage")
}

model TelegramBulkMessage {
  id                   String    @id @default(cuid())
  companyId            String
  userbotConfigId      String
  status               String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED
  recipients           Json // Array of strings (chatIds/usernames)
  message              String    @db.Text
  delayBetweenMessages Int       @default(1000) // ms
  sentCount            Int       @default(0)
  failedCount          Int       @default(0)
  startedAt            DateTime?
  completedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userbotConfig TelegramConfig @relation(fields: [userbotConfigId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userbotConfigId])
  @@map("telegram_bulk_messages")
}

model TelegramBulkMessageLog {
  id            String   @id @default(cuid())
  bulkMessageId String
  recipient     String
  status        String // SENT, FAILED
  error         String?  @db.Text
  sentAt        DateTime @default(now())

  @@index([bulkMessageId])
  @@map("telegram_bulk_message_logs")
}

model TelegramGroup {
  id              String  @id @default(cuid())
  userbotConfigId String
  companyId       String
  telegramId      String
  title           String
  type            String // GROUP, CHANNEL
  description     String? @db.Text
  isPublic        Boolean @default(false)
  managedByUs     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("telegram_groups")
}

model TelegramContact {
  id              String  @id @default(cuid())
  userbotConfigId String
  companyId       String
  telegramId      String
  firstName       String?
  lastName        String?
  username        String?
  phone           String?
  isBot           Boolean @default(false)
  isPremium       Boolean @default(false)
  source          String?
  sourceGroupId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([telegramId, companyId], name: "telegramId_companyId")
  @@index([companyId])
  @@map("telegram_contacts")
}

model TelegramForwardRule {
  id               String  @id @default(cuid())
  companyId        String
  userbotConfigId  String
  isActive         Boolean @default(true)
  sourceChats      Json // Array of strings
  targetChat       String
  filterKeywords   Json? // Array of strings
  filterMediaTypes Json? // Array of strings
  forwardCount     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userbotConfig TelegramConfig @relation(fields: [userbotConfigId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userbotConfigId])
  @@map("telegram_forward_rules")
}
