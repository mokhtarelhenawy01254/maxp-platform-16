/// Hotel module - Properties (hotel buildings/branches)
model HotelProperty {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  address       String?
  city          String?
  phone         String?
  email         String?
  description   String?
  amenities     Json?    /// ["wifi","pool","gym","parking","restaurant","spa"]
  images        Json?    /// ["url1","url2"]
  checkInTime   String   @default("14:00")
  checkOutTime  String   @default("12:00")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  roomTypes     HotelRoomType[]
  rooms         HotelRoom[]
  reservations  HotelReservation[]

  @@index([companyId])
  @@map("hotel_properties")
}

/// Hotel module - Room types/categories
model HotelRoomType {
  id                 String              @id @default(cuid())
  companyId          String
  propertyId         String
  name               String              /// e.g. Single, Double, Suite
  nameAr             String?             /// Arabic name
  description        String?
  capacity           Int                 @default(2)
  basePrice          Float               /// Default price per night
  pricingModel       HotelPricingModel   @default(PER_ROOM)
  pricePerExtraAdult Float               @default(0) /// PER_PERSON: extra per additional adult beyond 1
  amenities          Json?               /// ["tv","ac","minibar","balcony","sea-view"]
  images             Json?
  totalRooms         Int                 @default(1)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property           HotelProperty       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rooms    HotelRoom[]
  rates    HotelRoomRate[]
  prices   HotelRoomTypePrice[]
  reservationRooms HotelReservationRoom[]

  @@index([companyId])
  @@index([propertyId])
  @@map("hotel_room_types")
}

/// Hotel module - Individual rooms
model HotelRoom {
  id               String   @id @default(cuid())
  companyId        String
  propertyId       String
  roomTypeId       String
  roomNumber       String
  floor            Int?
  status           HotelRoomStatus @default(AVAILABLE)
  view             String?  /// no view, yard, mountain, street, sea
  wing             String?  /// left, right, main
  hasExtraBed      Boolean  @default(false)
  extraBedCapacity Int      @default(0)
  extraBedPrice    Float    @default(0)
  basePriceOverride Float?  /// per-room price override (overrides RoomType.basePrice)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property         HotelProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType         HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  reservationRooms HotelReservationRoom[]

  @@unique([propertyId, roomNumber])
  @@index([companyId])
  @@index([propertyId])
  @@index([roomTypeId])
  @@index([status])
  @@map("hotel_rooms")
}

/// Hotel module - Reservations/bookings
model HotelReservation {
  id            String                  @id @default(cuid())
  companyId     String
  propertyId    String
  customerId    String?
  customerName  String
  customerPhone String?
  customerEmail String?
  customerNotes String?
  checkIn       DateTime                @db.Date
  checkOut      DateTime                @db.Date
  adults          Int                     @default(1)
  children        Int                     @default(0)
  totalAmount     Float
  paidAmount      Float                   @default(0)
  depositRequired Boolean                 @default(false)
  depositAmount   Float                   @default(0)
  depositPaid     Boolean                 @default(false)
  paymentMethod   String?                 /// vodafone_cash/cib_topup/instapay/card/other
  status          HotelReservationStatus  @default(PENDING)
  source          String?                 /// whatsapp/facebook/dashboard/public
  createdById     String?
  createdByType String?                 /// ai_service / user
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property      HotelProperty           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customer      Customer?               @relation(fields: [customerId], references: [id])

  rooms HotelReservationRoom[]
  folio HotelFolioItem[]

  @@index([companyId])
  @@index([propertyId])
  @@index([customerId])
  @@index([status])
  @@index([checkIn, checkOut])
  @@map("hotel_reservations")
}

/// Hotel module - Room assignments in a reservation
model HotelReservationRoom {
  id             String    @id @default(cuid())
  reservationId  String
  roomId         String
  roomTypeId     String
  nightlyRate    Float     /// Rate per night at time of booking
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reservation HotelReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room        HotelRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomType    HotelRoomType     @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([reservationId, roomId])
  @@index([reservationId])
  @@index([roomId])
  @@map("hotel_reservation_rooms")
}

/// Hotel module - Additional charges during stay (folio)
model HotelFolioItem {
  id             String              @id @default(cuid())
  companyId      String
  reservationId  String
  description    String
  amount         Float
  itemType       HotelFolioItemType  @default(SERVICE)
  quantity       Int                 @default(1)
  chargedAt      DateTime            @default(now())
  createdAt      DateTime            @default(now())
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reservation    HotelReservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([reservationId])
  @@map("hotel_folio_items")
}

/// Hotel module - Service catalog (standalone, NOT tied to reservations)
model HotelService {
  id        String              @id @default(cuid())
  companyId String
  name      String              /// Service name (English)
  nameAr    String?             /// Service name (Arabic)
  itemType  HotelFolioItemType  @default(SERVICE)
  price     Float               /// Price per unit
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([itemType])
  @@map("hotel_services")
}

/// Hotel module - Tiered pricing: different price per number of guests
model HotelRoomTypePrice {
  id         String   @id @default(cuid())
  roomTypeId String
  companyId  String
  guests     Int      /// Number of guests this price applies to
  price      Float    /// Price per night for this many guests
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roomType HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, guests])
  @@index([companyId])
  @@map("hotel_room_type_prices")
}

/// Hotel module - Policies and house rules
model HotelPolicy {
  id               String   @id @default(cuid())
  companyId        String
  checkInTime      String   @default("14:00")
  checkOutTime     String   @default("12:00")
  earlyCheckInFee  Float    @default(0)
  lateCheckOutFee  Float    @default(0)
  cancelFreeBefore Int      @default(5)  /// Days before check-in for free cancellation
  cancelPenaltyPct Int      @default(100)
  childrenAllowed  Boolean  @default(true)
  extraBedPrice    Float    @default(0)
  quietHoursFrom   String?  @default("22:00")
  quietHoursTo     String?  @default("08:00")
  smokingAllowed   Boolean  @default(false)
  visitorsAllowed  Boolean  @default(false)
  visitorsHours    String?  @default("10:00-20:00")
  customRules      Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId])
  @@index([companyId])
  @@map("hotel_policies")
}

/// Hotel module - Seasonal/custom pricing for room types
model HotelRoomRate {
  id         String   @id @default(cuid())
  companyId  String
  roomTypeId String
  dateFrom   DateTime @db.Date
  dateTo     DateTime @db.Date
  price      Float    /// Per night during this period
  label      String?  /// "High Season", "New Year", "Eid", etc.
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roomType   HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([roomTypeId])
  @@index([dateFrom, dateTo])
  @@map("hotel_room_rates")
}
