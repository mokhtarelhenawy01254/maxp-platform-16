  {
    "id": "TC015",
    "title": "Save store settings successfully with a valid Store Name",
    "description": "Verifies a user can edit the Store Name and save settings, seeing a success confirmation.",
    "category": "Store and Profile Settings",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /settings"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/settings\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"Profile\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Store\" is visible"
      },
      {
        "type": "action",
        "description": "Fill \"New Store Name\" into the \"Store Name\" field"
      },
      {
        "type": "action",
        "description": "Click \"Save\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"Settings saved\" is visible"
      }
    ]
  },
