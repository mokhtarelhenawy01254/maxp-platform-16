{
  "openapi": "3.1.0",
  "info": {
    "title": "MaxP Platform — External HR & AI Integration API",
    "version": "1.0.0",
    "description": "Enterprise-grade Human Resources API for seamless integration with external ERP systems (Odoo, SAP), Biometric Attendance devices (ZKTeco), and Autonomous AI Agents (OpenAI, Claude, LangChain, n8n)."
  },
  "servers": [
    {
      "url": "/api/v1/external/hr",
      "description": "Production HR API Gateway"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/employees": {
      "get": {
        "summary": "List employees",
        "description": "Returns paginated list of employees with search and department filtering.",
        "operationId": "hr_list_employees",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "departmentId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "PROBATION",
                "ON_LEAVE",
                "TERMINATED",
                "SUSPENDED",
                "RESIGNED",
                "ON_HOLD",
                "COMPLETED",
                "CANCELLED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of employees"
          }
        }
      }
    },
    "/employees/{id}": {
      "get": {
        "summary": "Get employee by ID or employeeNumber",
        "description": "Fetch detailed profile of an employee.",
        "operationId": "hr_get_employee_by_id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee profile"
          },
          "404": {
            "description": "Employee not found"
          }
        }
      }
    },
    "/employees/upsert": {
      "post": {
        "summary": "Create or update employee from ERP",
        "description": "Upsert an employee record from external systems.",
        "operationId": "hr_upsert_employee",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "employeeNumber",
                  "firstName",
                  "lastName"
                ],
                "properties": {
                  "employeeNumber": {
                    "type": "string"
                  },
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "departmentId": {
                    "type": "string"
                  },
                  "positionId": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "ACTIVE",
                      "PROBATION",
                      "ON_LEAVE",
                      "TERMINATED",
                      "SUSPENDED",
                      "RESIGNED",
                      "ON_HOLD",
                      "COMPLETED",
                      "CANCELLED"
                    ],
                    "default": "ACTIVE"
                  },
                  "hireDate": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Employee updated"
          },
          "201": {
            "description": "Employee created"
          }
        }
      }
    },
    "/attendance/punches/batch": {
      "post": {
        "summary": "Ingest biometric punches",
        "description": "Batch endpoint for biometric devices (e.g. ZKTeco) to upload punches with automatic check-in/out resolution and duplicate suppression.",
        "operationId": "hr_ingest_biometric_punches",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "punches"
                ],
                "properties": {
                  "deviceId": {
                    "type": "string",
                    "example": "DEV_MAIN_GATE"
                  },
                  "punches": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "employeeNumber",
                        "punchTime"
                      ],
                      "properties": {
                        "employeeNumber": {
                          "type": "string"
                        },
                        "punchTime": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "CHECK_IN",
                            "CHECK_OUT"
                          ],
                          "default": "CHECK_IN"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Punches processed summary"
          }
        }
      }
    },
    "/attendance/today": {
      "get": {
        "summary": "Get today's attendance roster",
        "description": "Quickly inspect who is present, checked-in, or absent today.",
        "operationId": "hr_get_today_attendance",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Attendance list"
          }
        }
      }
    },
    "/leaves": {
      "post": {
        "summary": "Submit leave request",
        "description": "Submit a leave request on behalf of an employee via AI or external system.",
        "operationId": "hr_submit_leave_request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "startDate",
                  "endDate"
                ],
                "properties": {
                  "employeeId": {
                    "type": "string"
                  },
                  "employeeNumber": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "ANNUAL",
                      "SICK",
                      "UNPAID",
                      "MATERNITY",
                      "PATERNITY",
                      "BEREAVEMENT",
                      "MARRIAGE",
                      "HAJJ",
                      "STUDY",
                      "EMERGENCY",
                      "OTHER"
                    ]
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Leave request submitted"
          }
        }
      }
    },
    "/webhooks": {
      "get": {
        "summary": "List subscribed webhooks",
        "operationId": "hr_list_webhooks",
        "responses": {
          "200": {
            "description": "List of active webhooks"
          }
        }
      },
      "post": {
        "summary": "Register webhook endpoint",
        "operationId": "hr_create_webhook",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "targetUrl"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "targetUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "secret": {
                    "type": "string"
                  },
                  "subscribedEvents": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": [
                      "*"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Webhook endpoint registered"
          }
        }
      }
    },
    "/advances": {
      "get": {
        "summary": "List advance requests",
        "description": "Returns paginated list of employee financial advance requests with filtering by employeeCode, status, date range, and search.\n\n**Required Scope:** `hr:advances:read` (or `hr:read`, `*`)",
        "operationId": "hr_list_advances",
        "x-required-scope": "hr:advances:read",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "employeeCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of advances"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/deductions": {
      "get": {
        "summary": "List deductions",
        "description": "Returns paginated list of employee manual and auto deductions with filtering by employeeCode, status, date range, and search.\n\n**Required Scope:** `hr:deductions:read` (or `hr:read`, `*`)",
        "operationId": "hr_list_deductions",
        "x-required-scope": "hr:deductions:read",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "employeeCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of deductions"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/warnings": {
      "get": {
        "summary": "List disciplinary warnings",
        "description": "Returns paginated list of disciplinary warnings with filtering by employeeCode, status/severity, date range, and search.\n\n**Required Scope:** `hr:warnings:read` (or `hr:read`, `*`)",
        "operationId": "hr_list_warnings",
        "x-required-scope": "hr:warnings:read",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "employeeCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of warnings"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/resignations": {
      "get": {
        "summary": "List resignations",
        "description": "Returns paginated list of employee resignation requests and exit procedures with filtering by employeeCode, status, date range, and search.\n\n**Required Scope:** `hr:resignations:read` (or `hr:read`, `*`)",
        "operationId": "hr_list_resignations",
        "x-required-scope": "hr:resignations:read",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "employeeCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
