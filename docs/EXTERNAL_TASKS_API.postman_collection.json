{
  "info": {
    "name": "External Tasks API",
    "_postman_id": "0f724f1b-2d74-4dae-bf5f-632f5fd4af32",
    "description": "Ready-to-use collection for managing task integrations, creating external tasks, updating task status, and testing webhooks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Internal Integrations Admin",
      "item": [
        {
          "name": "Create Credential",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{credentialName}}\",\n  \"description\": \"Temporary key created from Postman\",\n  \"scopes\": [\"tasks:read\", \"tasks:write\"],\n  \"defaultActingUserId\": \"{{assignedTo}}\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/integrations/credentials",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "integrations",
                "credentials"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.id) pm.collectionVariables.set('credentialId', json.data.id);",
                  "if (json?.secret?.apiKey) pm.collectionVariables.set('apiKey', json.secret.apiKey);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Credentials",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/integrations/credentials",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "integrations",
                "credentials"
              ]
            }
          }
        },
        {
          "name": "Create Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{webhookName}}\",\n  \"targetUrl\": \"{{webhookTargetUrl}}\",\n  \"subscribedEvents\": [\"task.created\", \"task.status_changed\"],\n  \"customHeaders\": {\n    \"X-Postman-Test\": \"true\"\n  },\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/integrations/webhooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "integrations",
                "webhooks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.id) pm.collectionVariables.set('webhookId', json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Test Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"task.status_changed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/integrations/webhooks/{{webhookId}}/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "integrations",
                "webhooks",
                "{{webhookId}}",
                "test"
              ]
            }
          }
        },
        {
          "name": "Get Webhook Deliveries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/integrations/webhooks/{{webhookId}}/deliveries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "integrations",
                "webhooks",
                "{{webhookId}}",
                "deliveries"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.[0]?.id) pm.collectionVariables.set('deliveryId', json.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry Delivery",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/integrations/webhooks/{{webhookId}}/deliveries/{{deliveryId}}/retry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "integrations",
                "webhooks",
                "{{webhookId}}",
                "deliveries",
                "{{deliveryId}}",
                "retry"
              ]
            }
          }
        }
      ]
    },
