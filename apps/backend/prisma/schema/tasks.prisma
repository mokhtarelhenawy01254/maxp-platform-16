  hourlyRate                                       Decimal?          @db.Decimal(10, 2)
  weeklyTarget                                     Int?
  companyRelId                                     String?
  ai_chat_sessions                                 AIChatSession[]
  dev_member_badges                                DevMemberBadge[]
  dev_notifications                                DevNotification[]
  dev_projects                                     DevProject[]
  devTaskActivities                                DevTaskActivity[]
  devTaskComments                                  DevTaskComment[]
  devTaskWatchers                                  DevTaskWatcher[]
  dev_tasks_dev_tasks_assigneeIdTodev_team_members DevTask[]               @relation("dev_tasks_assigneeIdTodev_team_members")
  dev_tasks_dev_tasks_reporterIdTodev_team_members DevTask[]               @relation("dev_tasks_reporterIdTodev_team_members")
  devTaskApiCredentialAssigneeDefaults             DevTaskApiCredential[]  @relation("DevTaskApiCredentialAssignee")
  devTaskApiCredentialReporterDefaults             DevTaskApiCredential[]  @relation("DevTaskApiCredentialReporter")
  companyRel                                       Company?                @relation(fields: [companyRelId], references: [id])
  user                                             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  devTimeLogs                                      DevTimeLog[]
  devTimerGroups                                   DevTimerGroup[]
  devGoals                                         DevGoal[]                @relation("DevGoalOwner")
  devGoalCheckIns                                  DevGoalCheckIn[]
  devEvaluations                                   DevEvaluation[]

  @@index([isActive])
  @@index([role])
  @@index([userId])
  @@map("dev_team_members")
}

model DevTimeLog {
  id              String        @id @default(cuid())
  taskId          String
  memberId        String
  startTime       DateTime
  endTime         DateTime?
  duration        Int           @default(0)
  description     String?
  isBillable      Boolean       @default(false)
  isRunning       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  activityType    String?
  isPaused        Boolean       @default(false)
  pauseDuration   Int           @default(0)
  pauseHistory    String?
  pausedAt        DateTime?
  dev_team_member DevTeamMember @relation(fields: [memberId], references: [id])
  dev_task        DevTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([isPaused])
  @@index([isRunning])
  @@index([memberId])
  @@index([taskId])
  @@map("dev_time_logs")
}

// ── Dev Goals (OKRs) ────────────────────────────────────────────────
model DevGoal {
  id              String              @id @default(cuid())
  title           String
  description     String?
  type            DevGoalType         @default(TEAM)
  status          DevGoalStatus       @default(ACTIVE)
  priority        DevGoalPriority     @default(MEDIUM)
  targetType      DevGoalTargetType   @default(NUMBER)
  targetValue     Decimal             @default(0) @db.Decimal(12, 2)
  currentValue    Decimal             @default(0) @db.Decimal(12, 2)
  progress        Int                 @default(0)
  rating          String?
  unit            String?
  currency        String?             @default("EGP")
  confidence      DevGoalConfidence?  @default(ON_TRACK)
  startDate       DateTime            @db.Date
  endDate         DateTime            @db.Date
  ownerId         String?
  parentGoalId    String?
  projectId       String?
  quarter         String?
  tags            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  owner           DevTeamMember?      @relation("DevGoalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parentGoal      DevGoal?            @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)
  checkIns        DevGoalCheckIn[]
  childGoals      DevGoal[]           @relation("GoalHierarchy")
  project         DevProject?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  keyResults      DevGoalKeyResult[]
  linkedTasks     DevTask[]

  @@index([ownerId])
  @@index([parentGoalId])
  @@index([projectId])
  @@index([status])
  @@index([type])
  @@index([quarter])
  @@map("dev_goals")
}

model DevGoalKeyResult {
  id              String              @id @default(cuid())
  goalId          String
  title           String
  description     String?
  targetType      DevGoalTargetType   @default(NUMBER)
  targetValue     Decimal             @default(0) @db.Decimal(12, 2)
  currentValue    Decimal             @default(0) @db.Decimal(12, 2)
  unit            String?
  weight          Int                 @default(1)
  confidence      DevGoalConfidence?  @default(ON_TRACK)
  startDate       DateTime?           @db.Date
  endDate         DateTime?           @db.Date
  status          DevGoalStatus       @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  goal            DevGoal             @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("dev_goal_key_results")
}

model DevGoalCheckIn {
  id              String        @id @default(cuid())
  goalId          String
  keyResultId     String?
  memberId        String
  content         String
  confidence      DevGoalConfidence?
  progressValue   Decimal?      @db.Decimal(12, 2)
  blockers        String?
  createdAt       DateTime      @default(now())
  goal            DevGoal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  member          DevTeamMember @relation(fields: [memberId], references: [id])

  @@index([goalId])
  @@index([keyResultId])
  @@index([memberId])
  @@index([createdAt])
  @@map("dev_goal_check_ins")
}

// ── Timer Groups ────────────────────────────────────────────────────
model DevTimerGroup {
  id          String      @id @default(cuid())
  name        String
  description String?
  memberId    String
  isRunning   Boolean     @default(false)
  startTime   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  dev_team_member DevTeamMember @relation(fields: [memberId], references: [id])
  dev_tasks       DevTask[]

  @@index([memberId])
  @@index([isRunning])
  @@map("dev_timer_groups")
}

// ── Dev Evaluations ───────────────────────────────────────────────
model DevEvaluation {
  id                String   @id @default(cuid())
  memberId          String
  periodType        String
  periodStart       DateTime @db.Date
  periodEnd         DateTime @db.Date
  overallScore      Float    @default(0)
  taskCompletion    Float    @default(0)
  onTimeDelivery    Float    @default(0)
  estimationAccuracy Float   @default(0)
  timeEfficiency    Float    @default(0)
  goalAchievement   Float    @default(0)
  qualityScore      Float    @default(0)
  totalTasks        Int      @default(0)
  completedTasks    Int      @default(0)
  totalHours        Float    @default(0)
  estimatedHours    Float    @default(0)
  goalsAssigned     Int      @default(0)
  goalsAchieved     Int      @default(0)
  reopenedTasks     Int      @default(0)
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  member            DevTeamMember @relation(fields: [memberId], references: [id])

  @@unique([memberId, periodType, periodStart])
  @@index([memberId])
  @@index([periodType, periodStart])
  @@index([overallScore])
  @@map("dev_evaluations")
}

model TaskBacklog {
  id                String        @id @default(cuid())
  companyId         String
  title             String
  description       String
  source            String        @default("PRODUCT_NOTE")
  priority          TasksPriority @default(MEDIUM)
  type              String        @default("improvement")
  suggestedCategory String?
  tags              String?
  status            String        @default("PENDING")
  convertedTaskId   String?
  convertedAt       DateTime?
  createdBy         String
  assignedTo        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator           User          @relation("task_backlogs_createdByTousers", fields: [createdBy], references: [id])
  assignee          User?         @relation("task_backlogs_assignedToTousers", fields: [assignedTo], references: [id])
  convertedTask     Task?         @relation("task_backlog_convertedTask", fields: [convertedTaskId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([createdBy])
  @@index([assignedTo])
  @@map("task_backlogs")
}

