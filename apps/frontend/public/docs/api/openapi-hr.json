          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/employees/{id}": {
      "get": {
        "summary": "Get employee by ID or employeeNumber",
        "description": "Fetch detailed profile of an employee.\n\n**Required Scope:** `hr:employees:read` (or `hr:read`, `*`)",
        "operationId": "hr_get_employee_by_id",
        "x-required-scope": "hr:employees:read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee profile"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Employee not found"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/employees/upsert": {
      "post": {
        "summary": "Create or update employee from ERP",
        "description": "Upsert an employee record from external systems.\n\n**Required Scope:** `hr:employees:write` (or `hr:write`, `*`)",
        "operationId": "hr_upsert_employee",
        "x-required-scope": "hr:employees:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "employeeNumber",
                  "firstName",
                  "lastName"
                ],
                "properties": {
                  "employeeNumber": {
                    "type": "string"
                  },
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "departmentId": {
                    "type": "string"
                  },
                  "positionId": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "ACTIVE",
                      "PROBATION",
                      "ON_LEAVE",
                      "TERMINATED",
                      "SUSPENDED",
                      "RESIGNED",
                      "ON_HOLD",
                      "COMPLETED",
                      "CANCELLED"
                    ],
                    "default": "ACTIVE"
                  },
                  "hireDate": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Employee updated"
          },
          "201": {
            "description": "Employee created"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
